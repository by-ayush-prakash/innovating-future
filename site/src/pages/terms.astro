---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { ORG } from "../config";
---
<Base title="Terms of Use" description="Terms of use for innovatingfuture.com." cta={false}>
  <PageHead kicker="Last updated 2026" id="tm">
    Terms of Use.
    <p slot="lede" class="lede">
      What this site is, and what it is not.
    </p>
  </PageHead>

  <section class="sec">
    <div class="wrap">
      <div class="body">
        <p><strong>What this site is.</strong> A publication of the Center for Innovating the Future Inc., a company established in Toronto in December 2010. It describes the Center's work and publishes its research.</p>
        <p><strong>Not advice.</strong> Nothing here is legal, financial, medical or investment advice. Research published by the Center is offered as analysis, and the reader is responsible for what they do with it.</p>
        <p><strong>Accuracy.</strong> The Center sources what it publishes and corrects what it gets wrong. Where a claim has been graded against later evidence, the grade is published alongside it. Material is accurate as at the date shown and is not guaranteed to remain so.</p>
        <p><strong>Ownership.</strong> Text, research and design on this site belong to the Center unless otherwise credited. Quote it with attribution and a link. Do not republish work in full without asking.</p>
        <p><strong>Links out.</strong> The Center links to sources so claims can be checked. It does not control those sites and is not responsible for what they publish.</p>
        <p><strong>Questions.</strong> Write to <a href={"mailto:" + ORG.email}>{ORG.email}</a>.</p>
      </div>
    </div>
  </section>
</Base>
