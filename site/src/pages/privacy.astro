---
import Base from "../layouts/Base.astro";
import { ORG } from "../config";

const paragraphs = [
  "In effect August 2026. This policy describes what innovatingfuture.com collects, what it does not, and what happens to anything you send the Center for Innovating the Future Inc.",
  "This is a static website. It sets no cookies, runs no analytics, and carries no advertising or tracking scripts. The Center does not build profiles of visitors and has no way to identify you from a visit.",
  "Netlify hosts the site and keeps standard server logs, which include IP addresses and requested pages. The Center does not read these logs to identify individual visitors.",
  "Two parts of the site load files from other companies. Typefaces come from Google Fonts, and podcast artwork and audio come from the show's feed host. Loading a page therefore sends your IP address to those providers, as it would on most websites. Their own policies govern what they do with it.",
  "If you write to the Center, or send the form on the contact page, your name, email address, organization if you give one, and the contents of your message are kept for as long as needed to answer you and to maintain a record of the correspondence. That is the only personal information the Center holds. Form submissions are processed by Netlify Forms on the Center's behalf and are not shared further.",
  "The Center does not sell, rent, or trade personal information, and does not share it with third parties for marketing.",
  "Under Canada's Personal Information Protection and Electronic Documents Act, you can ask what personal information the Center holds about you, ask for it to be corrected, and ask for it to be deleted. Write to the address below and the Center will answer.",
  "Pages on this site link to other websites. The Center is not responsible for their content or their privacy practices.",
];
---
<Base title="Privacy Policy" description="What innovatingfuture.com collects, what it does not, and how to reach the Center about it.">
  <div class="wrap phead">
    <h1>Privacy Policy</h1>
  </div>
  <div class="wrap">
    <div class="legal">
      {paragraphs.map((p) => <p>{p}</p>)}
      <p>
        Questions about this policy, or a request under it, go to
        <a href={"mailto:" + ORG.email} style="border-bottom:2px solid var(--accent)">{ORG.email}</a>.
      </p>
    </div>
  </div>
</Base>
