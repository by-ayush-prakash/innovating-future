---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { ORG } from "../config";
---
<Base title="Privacy Policy" description="How the Center for Innovating the Future handles the information you send it." cta={false}>
  <PageHead id="pv">
    Privacy Policy.
    <p slot="lede" class="lede">
      The short version: the Center collects what you send it, uses it to answer you, and does
      nothing else with it.
    </p>
  </PageHead>

  <section class="sec">
    <div class="wrap">
      <div class="body">
        <p><strong>What is collected.</strong> If you use the contact form, the Center receives the name, email address, organization and message you enter. If you write by email, it receives whatever your message contains. Nothing else is collected from you directly.</p>
        <p><strong>What it is used for.</strong> To answer you. The Center does not sell, rent or share what you send with anyone, and does not use it for advertising.</p>
        <p><strong>How long it is kept.</strong> Correspondence is kept as long as it is useful to the conversation it belongs to, and deleted on request.</p>
        <p><strong>Hosting and analytics.</strong> This site is a static site served by Netlify, which records standard server logs. The Center does not run advertising trackers or third-party analytics profiles across this site.</p>
        <p><strong>Your choices.</strong> Write to <a href={"mailto:" + ORG.email}>{ORG.email}</a> to ask what the Center holds about you, to correct it, or to have it deleted.</p>
      </div>
    </div>
  </section>
</Base>
