---
import PageHead from "../components/PageHead.astro";
import Base from "../layouts/Base.astro";
import { MEDIA, MEDIA_BY_DATE, ORG } from "../config";

const logoFiles: any = import.meta.glob("../assets/media/*.{png,svg,webp,jpg}", { eager: true });
const logoFor = (slug: string) =>
  (Object.entries(logoFiles).find(([path]) => path.includes(`/${slug}.`))?.[1] as any)?.default;

const featuredOrder = ["montreal-review", "cnbc", "senate-of-canada"];
const featuredTone: Record<string, string> = { "montreal-review": "red", cnbc: "amber", "senate-of-canada": "teal" };
const featured = featuredOrder
  .map((slug) => MEDIA.find((m) => m.slug === slug))
  .filter((m): m is (typeof MEDIA)[number] => Boolean(m))
  .map((m) => ({ ...m, logo: logoFor(m.slug) }));
---
<Base
  title="In the press"
  description="Every published appearance by the Center for Innovating the Future and its principals since 2016, each with its source."
>
  <PageHead tone="press">In the press.</PageHead>

  <section>
    <div class="wrap">
      <div class="shead"><h2>Selected coverage.</h2></div>
      <div class="feat">
        {featured.map((m) => (
          <a class={`ft ft--${featuredTone[m.slug] ?? "red"}`} href={m.u} target="_blank" rel="noopener noreferrer">
            <span class="ftlogo">
              {m.logo && <img src={m.logo.src} alt={m.n} width={Math.round(m.logo.width / 3)} height={Math.round(m.logo.height / 3)} />}
            </span>
            <span class="ftbody">
              <h3>{m.n}</h3>
              <p>{m.note}</p>
              <span class="go">{m.date} &nbsp;&middot;&nbsp; Read &rsaquo;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="shead"><h2>Everything.</h2></div>
      <div class="rows">
        {MEDIA_BY_DATE.map((m) => (
          <a class="row" href={m.u} target="_blank" rel="noopener noreferrer">
            <span class="mono">{m.date}</span>
            <div>
              <h3>{m.n}</h3>
              <span class="attrib">{m.note}</span>
            </div>
            <span class="src">Read &rsaquo;</span>
          </a>
        ))}
      </div>
      <p class="dnote">
        Press inquiries go to <a href={"mailto:" + ORG.email}>{ORG.email}</a>.
      </p>
    </div>
  </section>
</Base>
