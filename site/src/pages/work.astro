---
import Base from "../layouts/Base.astro";
import { PROPERTIES } from "../config";
---
<Base title="Work" description="The Center for Innovating the Future owns and operates its institutions. A Toronto strategy innovation lab, established December 2010.">
  <header class="phero field field--warm">
    <span class="orb orb--a" aria-hidden="true"></span>
    <span class="orb orb--b" aria-hidden="true"></span>
    <span class="orb orb--c" aria-hidden="true"></span>
    <div class="wrap">
      <div>
        <p class="kick">What we do</p>
        <h1>The Center owns and operates its institutions.</h1>
        <p class="lede">Each one carries its own remit, its own audience, and its own standard.</p>
      </div>
    </div>
  </header>

  <section style="padding-bottom:clamp(40px,4vw,56px)">
    <div class="wrap">
      <p class="lede">
        Every institution the Center holds carries its own remit, its own audience, and its own
        standard. Each is built to outlast the attention cycle it was formed in.
      </p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="pcards">
        {PROPERTIES.map((p, i) => (
          <a class="pc" href={p.page ?? p.url}>
            <span class="pcart" style={`background:color-mix(in srgb, ${p.hue} 8%, transparent)`}>
              <img src={p.tile} alt="" loading="lazy" />
            </span>
            <span class="pcnum" style={`color:${p.hue}`}>{String(i + 1).padStart(2, "0")}</span>
            <h3>{p.name}</h3>
            <p>{p.blurb}</p>
            <span class="go">Read more <i>&rsaquo;</i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="shead"><h2>Appearances and events</h2></div>
      <div class="rows">
        <div class="row row--flat">
          <span class="mono">Feb 2025</span>
          <div>
            <h3>Microsoft Reactor Toronto</h3>
            <span class="attrib">The Center creates and hosts an event in the opening series at Microsoft Reactor Toronto.</span>
          </div>
          <span class="src">Microsoft Reactor</span>
        </div>
        <a class="row" href="https://www.roboticsbusinessreview.com/ai/global-futurist-robobusiness-speaker-aseem-prakash-shares-thoughts-coexisting-with-robots/" target="_blank" rel="noopener noreferrer">
          <span class="mono">Aug 2017</span>
          <div>
            <h3>RoboBusiness</h3>
            <span class="attrib">The Center speaks on coexisting with robots. Robotics Business Review publishes the interview.</span>
          </div>
          <span class="src">Robotics Business Review &rsaquo;</span>
        </a>
        <a class="row" href="https://sencanada.ca/en/content/sen/Committee/421/soci/14ev-53044-e" target="_blank" rel="noopener noreferrer">
          <span class="mono">Feb 2017</span>
          <div>
            <h3>Witness before the Senate of Canada</h3>
            <span class="attrib">The Standing Senate Committee on Social Affairs, Science and Technology hears the Center in its study of robotics, 3D printing and artificial intelligence in the health care system.</span>
          </div>
          <span class="src">Committee transcript &rsaquo;</span>
        </a>
      </div>
    </div>
  </section>
</Base>
