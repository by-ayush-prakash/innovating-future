---
import SiteImage from '../components/SiteImage.astro';
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Arrow from "../components/Arrow.astro";
import { SKEPTICISM, MANTIC, PODCAST } from "../config";

const properties = [
  { ...SKEPTICISM, photo: "/images/coexisting-with-ai.jpg", alt: "A head in silhouette opening onto a green field, with a bird on the steps and clouds passing through", cta: "Learn more" },
  { ...MANTIC, panel: "mantic", photo: null, alt: "", cta: "Visit Mantic" },
  { ...PODCAST, photo: "/images/podcast-cover.png", alt: "The Ayush Prakash Podcast cover", fit: "contain", cta: "Explore episodes" },
];

const appearances = [
  {
    d: "Feb 2025", h: "Microsoft Reactor Toronto",
    a: "The Center creates and hosts an event in the opening series at Microsoft Reactor Toronto.",
    s: "The session", u: "/work/coexisting-with-ai/microsoft-reactor", ext: false,
  },
  {
    d: "Aug 2017", h: "RoboBusiness",
    a: "The Center speaks on coexisting with robots. Robotics Business Review publishes the interview.",
    s: "Robotics Business Review", u: "https://www.roboticsbusinessreview.com/ai/global-futurist-robobusiness-speaker-aseem-prakash-shares-thoughts-coexisting-with-robots/", ext: true,
  },
  {
    d: "Feb 2017", h: "Witness before the Senate of Canada",
    a: "The Standing Senate Committee on Social Affairs, Science and Technology hears the Center in its study of robotics, 3D printing and artificial intelligence in the health care system.",
    s: "The scorecard", u: "/senate-2017", ext: false,
  },
];
---
<Base ctaField="dark-slate" title="Work" description="The Center for Innovating the Future owns and operates its institutions. A Toronto strategy innovation lab, established December 2010.">
  <PageHead className="work-head">
    The Center owns and operates its institutions.
    <p slot="lede" class="lede">
      Every institution the Center holds carries its own remit, its own audience, and its own
      standard. Each is built to outlast the attention cycle it was formed in.
    </p>
    <div slot="cta" class="cta">
      <a class="btn" href="/contact">Work with the Center</a>
      <a class="btn btn--gh" href="#institutions">See the institutions</a>
    </div>
  </PageHead>

  <section class="sec" id="institutions">
    <div class="wrap">
      <div class="alt">
        {properties.map((p, i) => (
          <div class={i % 2 === 1 ? "arow arow--f" : "arow"}>
            <div class:list={["afig", p.fit === "contain" && "afig--art", p.panel === "mantic" && "mantic-panel"]}>
              {p.panel === "mantic" ? (
                <div class="mantic-panel__inner" aria-hidden="true">
                  <span class="mantic-panel__kicker">Mantic Publishing</span>
                  <span class="mantic-panel__monogram">M</span>
                  <span class="mantic-panel__mark mantic-panel__mark--mint"></span>
                  <span class="mantic-panel__mark mantic-panel__mark--lavender"></span>
                  <span class="mantic-panel__underline"></span>
                  <span class="mantic-panel__place">Toronto · Montreal / Independent Press</span>
                </div>
              ) : (
                <SiteImage class="rn" src={p.photo} alt={p.alt} loading="lazy" />
              )}
            </div>
            <div>
              <h3>{p.name}</h3>
              <p>{p.blurb}</p>
              <a class="go" href={p.page}>{p.cta} <Arrow /></a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--t">
    <div class="wrap">
      <div class="g2">
        <a class="ncard" href="/work/coexisting-with-ai/record/">
          <div class="im"><SiteImage class="rn" src="/images/first-ai-native-generation.jpg" alt="A model brain on a yellow grid, marked by a cursor and a red dot" loading="lazy" /></div>
          <div class="bd bd--lg">
            <h4 style="font-size:clamp(24px,2.6vw,32px)">The Co-Existence Record</h4>
            <p class="sm mut">A source-linked public record for exploring questions, evidence, and perspectives about AI.</p>
            <span class="go">Explore the Record <Arrow /></span>
          </div>
        </a>
        <a class="ncard ncard--d" href="/senate-2017">
          <div class="im"><SiteImage class="rn" src="/images/senate-02.jpg" alt="" loading="lazy" /></div>
          <div class="bd bd--lg">
            <h4 style="font-size:clamp(24px,2.6vw,32px)">CIF Before the Senate</h4>
            <p class="sm mut">The Center gave evidence in 2017. Nine years on, every claim it made that day is graded in public, with sources. Three held. Three failed.</p>
            <span class="go">Read the scorecard <Arrow /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="sec sec--t">
    <div class="wrap">
      <div class="shead"><h3>Appearances and events</h3></div>
      <div class="rows">
        {appearances.map((r) => (
          <a class="rrow" href={r.u} target={r.ext ? "_blank" : undefined} rel={r.ext ? "noopener noreferrer" : undefined}>
            <span class="mono">{r.d}</span>
            <div>
              <h3>{r.h}</h3>
              <span class="attrib">{r.a}</span>
            </div>
            <span class="src">{r.s} &rsaquo;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
