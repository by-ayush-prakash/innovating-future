---
import PageHead from "../components/PageHead.astro";
import Base from "../layouts/Base.astro";

const people = [
  {
    name: "Aseem Prakash",
    role: "Founder and Chair",
    photo: "/images/aseem-prakash.jpg",
    bio: [
      "Aseem Prakash is the founder of the Center for Innovating the Future, which he established in Toronto in December 2010. He is a global futurist and strategist whose work examines how organizations and the people inside them adapt to automation and artificial intelligence.",
      "He has presented at RoboBusiness and at International Robotics Week in Delft. Robotics Business Review interviewed him on coexistence with robotics. In 2025 he created and hosted Coexisting with AI: Succeeding In the New Era at Microsoft Reactor Toronto. His writing has appeared in Fibre2Fashion and Risk Group.",
    ],
    links: [
      { label: "LinkedIn", urlText: "in/aseemprakash", url: "https://www.linkedin.com/in/aseemprakash" },
    ],
    based: "Toronto",
  },
  {
    name: "Ayush Prakash",
    role: "Director",
    photo: "/images/ayush-prakash.jpg",
    bio: [
      "Ayush Prakash is Director of the Center for Innovating the Future, where he leads its programs, publishing, and partnerships.",
      "He is the author of AI for Gen Z, first published in 2021 with a second edition in 2024, a study of how digital technology shapes cognition, identity, and work for the generation raised inside it. He has co-authored work with Karl Friston in The Montr\u00e9al Review and with Ran D. Anbar, MD, in Psychology Today. He hosts The Ayush Prakash Podcast. Guests include Avi Loeb, Karl Friston, and Yaron Brook.",
      "He is also Director of Strategic Initiatives at New Sapience, an artificial intelligence company, where he leads strategy and operations. He holds a BA in Philosophy from Toronto Metropolitan University.",
    ],
    links: [
      { label: "Website", urlText: "ayushprakash.com", url: "https://ayushprakash.com" },
      { label: "LinkedIn", urlText: "in/prakash-ayush", url: "https://linkedin.com/in/prakash-ayush" },
    ],
    based: "Montreal",
  },
];

---
<Base title="Leadership" description="Leadership at the Center for Innovating the Future.">
  <PageHead>Leadership.</PageHead>

  <section>
    <div class="wrap">
      {people.map((p) => (
        <div class="person">
          <div class="photo">
            {p.photo ? <img src={p.photo} alt={p.name} /> : <span class="noph">{p.name.split(" ").map((w) => w[0]).join("")}</span>}
          </div>
          <div>
            <h2>{p.name}</h2>
            <span class="role">{p.role}</span>
            {p.bio.map((para) => <p>{para}</p>)}
            <div class="clinks">
              {p.links.map((l) => (
                <div class="cl">
                  <span class="lbl">{l.label}</span>
                  <a href={l.url} target="_blank" rel="noopener noreferrer">{l.urlText}</a>
                </div>
              ))}
              <div class="cl"><span class="lbl">Based in</span><span>{p.based}</span></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
