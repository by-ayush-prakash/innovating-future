---
import Base from "../layouts/Base.astro";
import Marks from "../components/Marks.astro";
import Diagram from "../components/Diagram.astro";
import { PRINCIPLES, IHF, MANTIC, PODCAST } from "../config";

const cards = [
  { ...IHF, art: "ihf", go: "Read more", href: IHF.page },
  { ...MANTIC, art: "mantic", go: "Read more", href: MANTIC.page },
  { ...PODCAST, art: "podcast", go: "All episodes", href: PODCAST.page },
];
---
<Base description="The Center for Innovating the Future is a Toronto strategy innovation lab, established in 2010. It works on artificial intelligence, geopolitics, and the technologies remaking daily life, and builds the institutions that examine them.">
  <header class="hero">
    <Marks set={[{ name: "dots", pos: "tl" }, { name: "target", pos: "tr" }, { name: "zig", pos: "bl" }, { name: "grid", pos: "br" }]} />
    <div class="wrap">
      <h1>The forces that change what it means to be human, examined in public.</h1>
      <p class="sub">
        The Center for Innovating the Future is a Toronto strategy innovation lab,
        established in 2010. Artificial intelligence, geopolitics, and the technologies
        remaking daily life are changing what a person is and what a country can do. We
        build the institutions that examine those changes, and publish what they find in a
        form the people who have to decide can use.
      </p>
      <div class="cta">
        <a class="pill pill--solid" href="/work">See our work</a>
        <a class="pill pill--ghost" href="/leadership">Who runs it</a>
      </div>
    </div>
  </header>

  <section>
    <div class="wrap">
      <div class="shead">
        <h2>The Center builds institutions and holds them. <em>Each answers to the question, not the funder.</em></h2>
        <a class="pill pill--ghost" href="/work">All work &rsaquo;</a>
      </div>
      <div class="props">
        {cards.map((c) => (
          <a class="prop" href={c.href}>
            <div class="art"><Diagram name={c.art} /></div>
            <h3>{c.name}</h3>
            <p>{c.blurb}</p>
            <span class="go">{c.go} <i>&rsaquo;</i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="shead"><h2>How the Center works.</h2></div>
      <div class="prin">
        {PRINCIPLES.slice(0, 3).map((p) => (
          <div class="pr">
            <h3>{p.h}</h3>
            <p>{p.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <section class="close">
    <svg width="420" height="300" viewBox="0 0 420 300" fill="none" aria-hidden="true"><g stroke="#fff" stroke-opacity=".55"><path d="M20 300V120M44 300V160M68 300V80M92 300V190M116 300V140M140 300V60M164 300V210M188 300V110M212 300V170M236 300V40M260 300V150M284 300V200M308 300V90M332 300V180M356 300V130M380 300V220M404 300V100"/></g></svg>
    <div class="wrap">
      <h2>Work with the Center.</h2>
      <p>Host institutions, researchers, and collaborators working on the same questions
      can reach the Center directly.</p>
      <a class="pill" href="/contact">Start a conversation &rsaquo;</a>
    </div>
  </section>
</Base>
