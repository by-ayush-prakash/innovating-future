---
import Base from "../layouts/Base.astro";
import { SKEPTICISM, MANTIC, PODCAST, ORG, MEDIA } from "../config";
import { getFeed } from "../lib/feed";

// Drop a file at src/assets/media/<slug>.png and it appears on the wall.
// Exported at 3x, so display size is the intrinsic size divided by three.
const logoFiles: any = import.meta.glob("../assets/media/*.{png,svg,webp,jpg}", { eager: true });
const logoFor = (slug: string) =>
  (Object.entries(logoFiles).find(([path]) => path.includes(`/${slug}.`))?.[1] as any)?.default;

const wall = MEDIA.map((m) => ({ ...m, logo: logoFor(m.slug) }))
  .filter((m) => m.logo)
  .sort((a, b) => a.r - b.r);

const { episodes } = await getFeed();
const latest = episodes[0] ?? null;
const latestDate = latest
  ? new Date(latest.pubDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
  : "";


---
<Base description="The Center for Innovating the Future is a Toronto strategy innovation lab, established in 2010, working to ensure that the forces remaking human life, such as artificial intelligence and geopolitics, are built on purpose rather than inherited.">
  <header class="hero field field--warm">
    <span class="orb orb--a" aria-hidden="true"></span>
    <span class="orb orb--b" aria-hidden="true"></span>
    <span class="orb orb--c" aria-hidden="true"></span>
    <div class="wrap">
      <div class="hcopy">
        <p class="kick">Toronto &middot; Established {ORG.founded}</p>
        <h1>The future is innovated, not predicted.</h1>
        <p class="sub">
          A strategy innovation lab working to ensure the forces remaking human life are
          built on purpose rather than inherited.
        </p>
        <div class="cta">
          <a class="pill pill--solid" href="/work">See our work</a>
          <a class="pill pill--ghost" href="/leadership">Who runs it</a>
        </div>
      </div>
    </div>
  </header>

  <section class="feature field field--cool">
    <span class="orb orb--a orb--cool-a" aria-hidden="true"></span>
    <span class="orb orb--b orb--cool-b" aria-hidden="true"></span>
    <div class="wrap">
      <div class="feat-head">
        <p class="kick kick--cool">The Center's current research</p>
        <h2>The First AI-Native Generation</h2>
      </div>
      <p class="feat-q">
        A generation is coming of age inside a technology nobody has finished
        understanding. The Center is asking what sustained interaction with conversational
        AI does to cognition, identity, and agency, and publishing what it finds.
      </p>
      <div class="feat-grid">
        <div class="fcard">
          <div class="n">Output 01</div>
          <h4>The report</h4>
          <p>Thirty to fifty pages on what the evidence supports, what it does not, and where the open questions are.</p>
        </div>
        <div class="fcard">
          <div class="n">Output 02</div>
          <h4>The policy brief</h4>
          <p>Six to ten pages for the people who write rules, written so they can act on it.</p>
        </div>
        <div class="fcard">
          <div class="n">Output 03</div>
          <h4>The framework</h4>
          <p>A developmentally responsible AI framework organizations can apply without a research team.</p>
        </div>
      </div>
      <div class="feat-foot">
        <a class="pill pill--slate" href="/work/coexisting-with-ai">Read the research &rsaquo;</a>
        <span class="note">Evidence gathered through the Co-Existing with AI interview series. First outputs November 2026.</span>
      </div>
    </div>
  </section>

  <section class="band" id="media">
    <div class="wrap">
      <h2 class="wallh">The Center in the media</h2>
      <div class="wall">
        {wall.map((m) => (
          <span class="wl">
            <img
              src={m.logo.src}
              alt={m.n}
              width={Math.round(m.logo.width / 3)}
              height={Math.round(m.logo.height / 3)}
              loading="lazy"
            />
          </span>
        ))}
      </div>
      <p class="wnote"><a href="/media">View all media appearances</a></p>
      <p class="wnote">Press inquiries: <a href={"mailto:" + ORG.email}>{ORG.email}</a></p>
    </div>
  </section>

  <section class="stmt">
    <div class="wrap">
      <h2>Our organization turns long-term questions into institutions that can carry them.</h2>
      <p>
        At CIF, we believe the forces remaking human life deserve more than commentary.
        Artificial intelligence and geopolitics move faster than the institutions meant to
        examine them. Most of the analysis that does exist is written for the people building
        the technology, not the people living with it. The Center builds and owns institutions
        that close that gap. It keeps them independent enough to say what they find.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="wrows">

        <div class="wrow">
          <div class="wfig" style="background:var(--accent-t)">
            <span class="wtag" style="background:var(--accent)">Program</span>
            <svg viewBox="0 0 500 350" fill="none" aria-hidden="true">
              <g stroke="#DE3A11" stroke-opacity=".26">
                <circle cx="250" cy="175" r="140" /><circle cx="250" cy="175" r="106" />
                <circle cx="250" cy="175" r="72" /><circle cx="250" cy="175" r="38" />
              </g>
              <g stroke="#DE3A11" stroke-opacity=".5">
                <path d="M110 175h280M250 35v280" />
              </g>
              <circle cx="250" cy="175" r="8" fill="#DE3A11" />
              <circle cx="356" cy="175" r="5.5" fill="#DE3A11" fill-opacity=".7" />
              <circle cx="250" cy="103" r="5.5" fill="#DE3A11" fill-opacity=".7" />
              <circle cx="178" cy="175" r="5.5" fill="#DE3A11" fill-opacity=".7" />
            </svg>
          </div>
          <div>
            <h3>{SKEPTICISM.name}</h3>
            <p>{SKEPTICISM.blurb}</p>
            <a class="go" style="color:var(--accent-ink)" href={SKEPTICISM.page}>Learn more about the program &rsaquo;</a>
          </div>
        </div>

        <div class="wrow wrow--rev">
          <div class="wfig" style="background:var(--amber-t)">
            <span class="wtag" style="background:var(--amber)">Press</span>
            <svg viewBox="0 0 500 350" fill="none" aria-hidden="true">
              <g stroke="#C67E16" stroke-opacity=".34">
                <rect x="150" y="70" width="200" height="210" />
                <rect x="168" y="88" width="164" height="174" />
              </g>
              <g stroke="#C67E16" stroke-opacity=".55">
                <path d="M192 128h116M192 156h116M192 184h84M192 212h116M192 240h60" />
              </g>
              <path d="M250 70v210" stroke="#C67E16" stroke-opacity=".7" />
              <circle cx="250" cy="70" r="7" fill="#C67E16" />
            </svg>
          </div>
          <div>
            <h3>{MANTIC.name}</h3>
            <p>{MANTIC.blurb}</p>
            <a class="go" style="color:var(--amber-ink)" href={MANTIC.page}>Visit Mantic &rsaquo;</a>
          </div>
        </div>

        <div class="wrow">
          <div class="wfig" style="background:var(--teal-t)">
            <span class="wtag" style="background:var(--teal)">Public channel</span>
            <svg viewBox="0 0 500 350" fill="none" aria-hidden="true">
              <g stroke="#1C6E63" stroke-opacity=".45" stroke-linecap="round">
                <path d="M120 175v-34M150 175v-62M180 175v-90M210 175v-48M240 175v-104M270 175v-70M300 175v-92M330 175v-40M360 175v-66M390 175v-28"
                  transform="translate(0,86)" />
                <path d="M120 175v34M150 175v62M180 175v90M210 175v48M240 175v104M270 175v70M300 175v92M330 175v40M360 175v66M390 175v28"
                  transform="translate(0,-86)" />
              </g>
              <path d="M96 175h318" stroke="#1C6E63" stroke-opacity=".7" />
              <circle cx="240" cy="175" r="8" fill="#1C6E63" />
            </svg>
          </div>
          <div>
            <h3>{PODCAST.name}</h3>
            <p>{PODCAST.blurb}</p>
            {latest && (
              <p class="mono" style="margin-bottom:18px">Latest &middot; {latestDate} &middot; {latest.title}</p>
            )}
            <a class="go" style="color:var(--teal-ink)" href={PODCAST.page}>Explore episodes &rsaquo;</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="close">
    <svg width="420" height="300" viewBox="0 0 420 300" fill="none" aria-hidden="true"><g stroke="#fff" stroke-opacity=".55"><path d="M20 300V120M44 300V160M68 300V80M92 300V190M116 300V140M140 300V60M164 300V210M188 300V110M212 300V170M236 300V40M260 300V150M284 300V200M308 300V90M332 300V180M356 300V130M380 300V220M404 300V100"/></g></svg>
    <div class="wrap">
      <h2>Work with the Center.</h2>
      <p>Host institutions, researchers, and collaborators working on the same questions
      can reach the Center directly.</p>
      <a class="pill" href="/contact">Start a conversation &rsaquo;</a>
    </div>
  </section>
</Base>
