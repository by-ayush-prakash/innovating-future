---
import Base from "../layouts/Base.astro";
import Field from "../components/Field.astro";
import Mark from "../components/Mark.astro";
import Arrow from "../components/Arrow.astro";
import { SKEPTICISM, MANTIC, PODCAST, ORG, MEDIA } from "../config";
import { getFeed } from "../lib/feed";

// Drop a file at src/assets/media/<slug>.png and it appears on the wall.
// Exported at 3x, so display size is the intrinsic size divided by three.
const logoFiles: any = import.meta.glob("../assets/media/*.{png,svg,webp,jpg}", { eager: true });
const logoFor = (slug: string) =>
  (Object.entries(logoFiles).find(([path]) => path.includes(`/${slug}.`))?.[1] as any)?.default;

const wall = MEDIA.map((m) => ({ ...m, logo: logoFor(m.slug) }))
  .filter((m) => m.logo)
  .sort((a, b) => a.r - b.r);

const { episodes } = await getFeed();
const latest = episodes[0] ?? null;
const latestDate = latest
  ? new Date(latest.pubDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
  : "";

// The three principles. Line art, drawn not illustrated.
const pillars = [
  {
    h: "Independence",
    p: "The Center owns the institutions it builds and funds them so they can publish findings that no sponsor commissioned.",
    href: "/work",
  },
  {
    h: "Convening",
    p: "Closed rooms and public forums that put researchers, operators, and regulators on the same question at the same time.",
    href: SKEPTICISM.page,
  },
  {
    h: "Publication",
    p: "Reports, briefs, and books. Every claim sourced, every method stated before the finding, every error graded in public.",
    href: "/senate-2017",
  },
];

// Graded in 2026 against public evidence. Full working at /senate-2017.
const grades = [
  { v: "held", l: "Held", c: "A national robotics strategy would matter" },
  { v: "held", l: "Held", c: "Hospitals will rent robots, not buy them" },
  { v: "held", l: "Held", c: "Phones become clinical biosensors" },
  { v: "partly", l: "Partly", c: "Algorithms beat dermatologists" },
  { v: "failed", l: "Failed", c: "Watson reaches 99% diagnostic accuracy" },
  { v: "failed", l: "Failed", c: "42% of Canadian jobs at risk" },
];

const properties = [
  { ...SKEPTICISM, note: SKEPTICISM.blurb },
  { ...MANTIC, note: MANTIC.blurb },
  { ...PODCAST, note: PODCAST.blurb },
];
---
<Base description="The Center for Innovating the Future is a Toronto strategy innovation lab, established in 2010, working to ensure that the forces remaking human life, such as artificial intelligence and geopolitics, are built on purpose rather than inherited.">

  <header class="hero">
    <div class="wrap">
      <p class="mono" style="margin-bottom:26px">{ORG.city} &middot; Established {ORG.founded}</p>
      <h1>The future is innovated, not predicted.</h1>
      <p class="lede">
        A strategy innovation lab working to ensure the forces remaking human life are
        built on purpose rather than inherited.
      </p>
      <div class="cta">
        <a class="btn" href="/work">See our work</a>
        <a class="btn btn--gh" href="/leadership">Who runs it</a>
      </div>

      <div class="hcards">
        <a class="card" href="/work/ai-native-generation">
          <Field v="dark-violet" id="ha" w={1600} h={1000} />
          <span class="cardlab">
            <span class="mono">Current research</span>
            <span class="lg" style="display:block;margin-top:8px">The First <span style="white-space:nowrap">AI-Native</span> Generation</span>
          </span>
        </a>
        <a class="card" href={SKEPTICISM.page}>
          <Field v="sand" id="hb" w={900} h={920} />
          <span class="cardlab cardlab--d">
            <span class="mono">Program</span>
            <span class="lg" style="display:block;margin-top:8px">Co&#8209;Existing with AI</span>
          </span>
        </a>
      </div>
    </div>
  </header>

  <section class="sec">
    <div class="wrap">
      <div class="g3">
        {pillars.map((p, i) => (
          <div>
            <svg width="126" height="126" viewBox="0 0 120 120" fill="none" stroke="#000" stroke-width="1" style="margin-bottom:44px" aria-hidden="true">
              {i === 0 && (
                <g><path d="M60 6 114 60 60 114 6 60Z"/><path d="M60 26 94 60 60 94 26 60Z"/><path d="M60 44 76 60 60 76 44 60Z"/><circle cx="60" cy="60" r="5"/></g>
              )}
              {i === 1 && (
                <g><circle cx="60" cy="60" r="53"/><ellipse cx="60" cy="60" rx="18" ry="53"/><ellipse cx="60" cy="60" rx="36" ry="53"/><path d="M7 60h106M15 34h90M15 86h90"/><circle cx="60" cy="42" r="4.5"/><circle cx="60" cy="78" r="4.5"/></g>
              )}
              {i === 2 && (
                <g><rect x="14" y="10" width="92" height="100"/><path d="M14 26h92M14 42h92M14 58h92M14 74h92M14 90h92M30 10v100M46 10v100M62 10v100M78 10v100M94 10v100"/></g>
              )}
            </svg>
            <h2 style="margin-bottom:16px">{p.h}</h2>
            <p style="color:var(--ink-2);max-width:36ch">{p.p}</p>
            <a class="go" href={p.href} style="margin-top:34px">Learn more <Arrow /></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="rnw"><Field v="dark-teal" id="hs" w={2400} h={900} /></div>
    <div class="wrap">
      <span class="fmark" style="color:#fff"><Mark last="#fff" /> senate&nbsp;2017</span>
      <div class="bandgrid">
        <div>
          <h3>We graded our own testimony.</h3>
          <p>
            The Center appeared before the Standing Senate Committee on Social Affairs, Science and
            Technology on 2 February 2017. Nine years on, the record is old enough to check. Three
            claims held. Three failed. We published all of them.
          </p>
          <a class="btn btn--w" style="margin-top:34px" href="/senate-2017">Read the scorecard</a>
        </div>
        <div class="ui">
          {grades.map((g) => (
            <div class="row">
              <span class="v">{g.c}</span>
              <span class={`tag t-${g.v}`}>{g.l}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="media">
    <div class="wrap">
      <div class="shead">
        <h2>Cited where the decisions get made</h2>
        <a class="go sm" href="/media">All media appearances <Arrow /></a>
      </div>
      <div class="wall">
        {wall.map((m) => (
          <a class="wl" href={m.u} target="_blank" rel="noopener noreferrer" aria-label={m.n}>
            <img src={m.logo.src} alt={m.n} width={Math.round(m.logo.width / 3)} height={Math.round(m.logo.height / 3)} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--t">
    <div class="wrap">
      <div class="arow">
        <div class="afig" style="aspect-ratio:1/1"><Field v="stone" id="hp" w={900} h={900} /></div>
        <div>
          <div class="rule"></div>
          <div class="lrows" style="border-top:0">
            {properties.map((p) => (
              <a class="lrow" href={p.page}>
                <span class="t">{p.name}</span>
                <p>{p.note}</p>
              </a>
            ))}
            <a class="lrow" href="/work/ai-native-generation">
              <span class="t">The First AI-Native Generation</span>
              <p>Fieldwork on what sustained interaction with conversational AI does to cognition, identity, and agency.</p>
            </a>
          </div>
          {latest && (
            <p class="mono" style="margin-top:26px">Latest episode &middot; {latestDate} &middot; {latest.title}</p>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--t">
    <div class="wrap">
      <div class="qcard" style="border-radius:var(--r);min-height:520px;display:flex;align-items:center">
        <div class="rnw" style="position:absolute;inset:0"><Field v="dark-slate" id="hq" w={1400} h={700} /></div>
        <div style="position:relative;z-index:2;padding:clamp(40px,6vw,86px) clamp(40px,6.6vw,96px);color:#FAFAFA;width:100%">
          <p class="mono" style="color:rgba(250,250,250,.5)">Why the work is different</p>
          <h3 style="margin-top:26px;color:#fff;max-width:22ch;font-size:clamp(28px,3.9vw,56px)">
            Most of the material written about AI is produced by the companies selling it.
            The Center works the other side.
          </h3>
          <div class="strip" style="margin-top:clamp(40px,5vw,76px);max-width:1000px">
            <div><div class="n" style="color:#fff">{ORG.founded}</div><p style="color:rgba(250,250,250,.6)">Established in {ORG.city}. Sixteen years of published record.</p></div>
            <div><div class="n" style="color:#fff">241</div><p style="color:rgba(250,250,250,.6)">Industrial robots per 10,000 Canadian manufacturing workers. Korea is at 1,220.</p></div>
            <div><div class="n" style="color:#fff">150+</div><p style="color:rgba(250,250,250,.6)">Long-form interviews on the record, published in full.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--t">
    <div class="wrap">
      <div class="shead">
        <h3>The latest</h3>
        <a class="go sm" href="/media">See everything <Arrow /></a>
      </div>
      <div class="g3">
        <a class="ncard" href="https://www.themontrealreview.com/Articles/the_infinity_of_the_brain_and_the_void_of_the_machine.php" target="_blank" rel="noopener noreferrer">
          <div class="im"><Field v="sand" id="n1" w={1200} h={675} /></div>
          <div class="bd">
            <p class="mono">The Montr&eacute;al Review &middot; Jul 2026</p>
            <h4>The Infinity of the Brain and the Void of the Machine</h4>
            <p class="sm mut">Written with Karl Friston. Why prediction in a brain and prediction in a model are not the same operation.</p>
            <span class="go">Read <Arrow /></span>
          </div>
        </a>
        <a class="ncard" href="https://www.psychologytoday.com/sg/blog/understanding-hypnosis/202511/the-risks-of-ai-and-social-media-for-the-developing-brain" target="_blank" rel="noopener noreferrer">
          <div class="im"><Field v="grey-teal" id="n2" w={1200} h={675} /></div>
          <div class="bd">
            <p class="mono">Psychology Today &middot; Nov 2025</p>
            <h4>The Risks of AI and Social Media for the Developing Brain</h4>
            <p class="sm mut">Written with Ran D. Anbar, MD. What the evidence supports about adolescent use, and what it does not.</p>
            <span class="go">Read <Arrow /></span>
          </div>
        </a>
        <a class="ncard" href="/work/ai-native-generation">
          <div class="im"><Field v="dark-violet" id="n3" w={1200} h={675} /></div>
          <div class="bd">
            <p class="mono">Fieldwork &middot; Open</p>
            <h4>The First AI-Native Generation</h4>
            <p class="sm mut">Two evidence layers, kept separate: what experts believe is happening, and what AI-native people actually do.</p>
            <span class="go">Take part <Arrow /></span>
          </div>
        </a>
      </div>
    </div>
  </section>
</Base>
