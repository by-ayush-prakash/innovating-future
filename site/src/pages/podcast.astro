---
import SiteImage from '../components/SiteImage.astro';
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Arrow from "../components/Arrow.astro";
import { PODCAST, ORG } from "../config";
import { getFeed } from "../lib/feed";

const { episodes, fetchFailed } = await getFeed();
const latest = episodes[0] ?? null;
const rest = episodes.slice(1);
const cover = PODCAST.cover;

const APPLE = "https://podcasts.apple.com/ca/podcast/ayush-prakash-podcast/id1557703631";
const SPOTIFY = "https://open.spotify.com/show/1ILhje5HSua1FEOlTyFAhG";
const SUBSCRIBE_LINKS = [
  { label: "YouTube", href: PODCAST.url, icon: "youtube" },
  { label: "Spotify", href: SPOTIFY, icon: "spotify" },
  { label: "Apple Podcasts", href: APPLE, icon: "apple-podcasts" },
];

// Feed descriptions carry a tail of promo links. Keep the human part.
function blurb(text: string) {
  if (!text) return "";
  const cut = text
    .split(/Connect with|Podcast Info:|https?:\/\//)[0]
    .replace(/([.!?])(?=[A-Z])/g, "$1 ")
    .replace(/\s+/g, " ")
    .trim();
  const completeSentence = cut.match(/^(.{80,340}?[.!?])(?:\s|$)/)?.[1];
  if (completeSentence) return completeSentence;
  return cut.length > 300 ? cut.slice(0, 297).trimEnd() + "\u2026" : cut;
}

function fmtDate(pubDate: string) {
  const d = new Date(pubDate);
  if (isNaN(d.getTime())) return "";
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}

---
<Base
  title="Podcast"
  description="The Ayush Prakash Podcast: long-form conversations on the technologies reshaping how we think."
  ctaHeading="Follow the show."
  ctaBody="New conversations publish on YouTube, Spotify, and Apple Podcasts."
  ctaLabel="Subscribe"
  ctaLinks={SUBSCRIBE_LINKS}
  ctaField="dark-red"
>
  <PageHead id="pd">
    Conversations on the technologies reshaping how we think.
    <div slot="aside" class="cov"><SiteImage src={cover} alt={`${PODCAST.name} cover art`} /></div>
    <p slot="lede" class="lede">
      {PODCAST.blurb} Hosted by Ayush Prakash, Director of the Center.
    </p>
    <div slot="cta" class="plat">
      <a href={APPLE} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="5.4" fill="currentColor"/><g fill="#fff"><circle cx="12" cy="9.1" r="2.15"/><path d="M12 12.4c-1.55 0-2.6.8-2.6 1.85 0 .5.28 2.2.5 3.16.2.88.62 1.34 1.05 1.55.4.2 1.7.2 2.1 0 .43-.21.85-.67 1.05-1.55.22-.96.5-2.66.5-3.16 0-1.05-1.05-1.85-2.6-1.85Z"/><path d="M12 3.9a5.6 5.6 0 0 0-3.5 9.97.72.72 0 0 0 .9-1.12A4.16 4.16 0 1 1 16.16 9.5c0 1.28-.58 2.44-1.5 3.2a.72.72 0 1 0 .9 1.13A5.6 5.6 0 0 0 12 3.9Z"/></g></svg>
        <span>Apple Podcasts</span>
      </a>
      <a href={SPOTIFY} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="currentColor"/><g stroke="#fff" stroke-linecap="round" fill="none"><path d="M6.6 9.3c3.4-1 7.2-.7 10.3 1" stroke-width="2.1"/><path d="M7.4 12.6c2.8-.8 5.9-.5 8.4.9" stroke-width="1.8"/><path d="M8.2 15.7c2.2-.6 4.6-.4 6.6.7" stroke-width="1.5"/></g></svg>
        <span>Spotify</span>
      </a>
      <a href={PODCAST.url} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect y="4.4" width="24" height="15.2" rx="4.2" fill="currentColor"/><path d="M10 8.6l5.6 3.4L10 15.4V8.6Z" fill="#fff"/></svg>
        <span>YouTube</span>
      </a>
    </div>
  </PageHead>

  {fetchFailed ? (
    <section class="sec">
      <div class="wrap">
        <p class="lede">
          Episodes couldn't be loaded from the feed at build time. Listen on
          <a href={PODCAST.url} target="_blank" rel="noopener noreferrer" style="color:var(--ink);border-bottom:1px solid var(--red)"> YouTube</a>
          or <a href={SPOTIFY} target="_blank" rel="noopener noreferrer" style="color:var(--ink);border-bottom:1px solid var(--red)">Spotify</a> in the meantime.
        </p>
      </div>
    </section>
  ) : (
    <>
      <section class="sec" id="latest">
        <div class="wrap">
          {latest && (
            <article class="latest-feature">
              <div class="latest-feature__art">
                <span class="latest-feature__shape latest-feature__shape--circle" aria-hidden="true"></span>
                <span class="latest-feature__shape latest-feature__shape--square" aria-hidden="true"></span>
                <SiteImage src={latest.image || cover} alt={`${latest.title} episode artwork`} />
                <span class="latest-feature__number">Episode {episodes.length}</span>
              </div>
              <div class="latest-feature__copy">
                <div class="latest-feature__meta">
                  <span>Latest episode</span>
                  <time datetime={new Date(latest.pubDate).toISOString()}>{fmtDate(latest.pubDate)}</time>
                </div>
                <h2>{latest.title}</h2>
                {latest.description && <p class="latest-feature__blurb">{blurb(latest.description)}</p>}
                {latest.audio && (
                  <div class="latest-player" data-audio-player>
                    <audio class="latest-player__native" controls preload="metadata" src={latest.audio} data-audio></audio>
                    <div class="latest-player__custom">
                      <button type="button" class="latest-player__toggle" aria-label="Play latest episode" data-audio-toggle>
                        <span aria-hidden="true"></span>
                      </button>
                      <div class="latest-player__timeline">
                        <input type="range" min="0" max="100" step="0.1" value="0" aria-label="Episode progress" data-audio-range />
                        <div class="latest-player__times" aria-live="off">
                          <span data-audio-current>0:00</span>
                          <span data-audio-duration>0:00</span>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </article>
          )}
        </div>
      </section>

      <section class="sec sec--paper" id="all">
        <div class="wrap">
          <div class="shead">
            <h3>All episodes</h3>
            <input class="srch" id="ep-search" type="text" placeholder="Search episodes" aria-label="Search episodes" />
          </div>
          <div class="eplist" id="ep-list" style="background:#fff;border-radius:var(--r);padding:0 clamp(20px,3vw,32px);border-top:0">
            {rest.map((ep, i) => (
              <a class="eprow" href={ep.audio || PODCAST.url} target="_blank" rel="noopener noreferrer"
                 data-title={ep.title.toLowerCase()} data-desc={ep.description.toLowerCase()}>
                <span class="epcov"><SiteImage src={cover} alt="" loading="lazy" /></span>
                <span class="epn">{String(rest.length - i).padStart(3, "0")}</span>
                <span>
                  <span class="ept">{ep.title}</span>
                  <span class="epd">{fmtDate(ep.pubDate)}</span>
                </span>
                <span class="epa go sm">Listen <Arrow /></span>
              </a>
            ))}
          </div>
          <p id="ep-empty" style="display:none;padding:40px 0;color:var(--mut)">No episodes match that search.</p>
          <div id="ep-more-wrap" class="epmore">
            <button id="ep-more" class="epmore__button" type="button" aria-label="Load more episodes">
              <span aria-hidden="true">+</span>
            </button>
          </div>
        </div>
      </section>
    </>
  )}

  <section class="sec" id="authors">
    <div class="wrap">
      <div class="g2">
        <a class="ncard ncard--d" href="/work/mantic">
          <div class="bd bd--lg" style="justify-content:center">
            <h4 style="font-size:clamp(24px,2.6vw,32px)">Every published Mantic author gets a seat.</h4>
            <p class="sm mut">
              A long-form conversation about the book with an audience that will push on it.
              The book is where the argument starts. This is where it gets tested.
            </p>
            <span class="go">About Mantic <Arrow /></span>
          </div>
        </a>
        <div class="ncard ncard--o">
          <div class="bd bd--lg" style="justify-content:center">
            <h4 style="font-size:clamp(24px,2.6vw,32px)">Working on something most people have wrong?</h4>
            <p class="sm mut">
              Send the question you have been sitting with, what the consensus answer is,
              and why it does not hold.
            </p>
            <a class="btn" style="margin-top:18px;align-self:flex-start" href="/contact">Pitch the show</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>("#ep-search");
  const list = document.getElementById("ep-list");
  const empty = document.getElementById("ep-empty");
  const moreBtn = document.getElementById("ep-more");
  const moreWrap = document.getElementById("ep-more-wrap");

  if (list) {
    const rows = Array.from(list.querySelectorAll<HTMLElement>(".eprow"));
    const FIRST = 5;
    const STEP = 10;
    let shown = FIRST;

    function draw() {
      const q = input ? input.value.trim().toLowerCase() : "";
      let matches = 0;

      for (const row of rows) {
        const hit = !q || (row.dataset.title || "").includes(q) || (row.dataset.desc || "").includes(q);
        if (hit) matches++;
        // searching reaches the whole back catalogue; browsing is paged
        row.style.display = q ? (hit ? "" : "none") : (matches <= shown && hit ? "" : "none");
      }

      rows.forEach((row) => row.classList.remove("is-visible-last"));
      const visibleRows = rows.filter((row) => row.style.display !== "none");
      visibleRows.at(-1)?.classList.add("is-visible-last");

      if (empty) empty.style.display = matches === 0 ? "block" : "none";
      const remaining = rows.length - shown;
      if (moreWrap) moreWrap.style.display = !q && remaining > 0 ? "flex" : "none";
    }

    if (moreBtn) moreBtn.addEventListener("click", () => { shown += STEP; draw(); });
    if (input) input.addEventListener("input", draw);
    draw();
  }

  document.querySelectorAll<HTMLElement>("[data-audio-player]").forEach((player) => {
    const audio = player.querySelector<HTMLAudioElement>("[data-audio]");
    const toggle = player.querySelector<HTMLButtonElement>("[data-audio-toggle]");
    const range = player.querySelector<HTMLInputElement>("[data-audio-range]");
    const current = player.querySelector<HTMLElement>("[data-audio-current]");
    const duration = player.querySelector<HTMLElement>("[data-audio-duration]");
    if (!audio || !toggle || !range || !current || !duration) return;

    const formatTime = (seconds: number) => {
      if (!Number.isFinite(seconds)) return "0:00";
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60).toString().padStart(2, "0");
      return `${mins}:${secs}`;
    };

    const render = () => {
      const progressValue = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
      range.value = String(progressValue);
      range.style.setProperty("--audio-progress", `${progressValue}%`);
      current.textContent = formatTime(audio.currentTime);
      duration.textContent = formatTime(audio.duration);
      player.classList.toggle("is-playing", !audio.paused);
      toggle.setAttribute("aria-label", audio.paused ? "Play latest episode" : "Pause latest episode");
    };

    player.classList.add("is-ready");
    audio.addEventListener("loadedmetadata", render);
    audio.addEventListener("timeupdate", render);
    audio.addEventListener("play", render);
    audio.addEventListener("pause", render);
    audio.addEventListener("ended", render);
    toggle.addEventListener("click", async () => {
      if (audio.paused) {
        try { await audio.play(); } catch { /* Browser or network blocked playback. */ }
      } else {
        audio.pause();
      }
    });
    range.addEventListener("input", () => {
      if (audio.duration) audio.currentTime = (Number(range.value) / 100) * audio.duration;
      render();
    });
    render();
  });
</script>
