---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SubNav from "../components/SubNav.astro";
import Field from "../components/Field.astro";
import Arrow from "../components/Arrow.astro";
import { PODCAST, ORG } from "../config";
import { getFeed } from "../lib/feed";

const { episodes, fetchFailed } = await getFeed();
const latest = episodes[0] ?? null;
const rest = episodes.slice(1);
const cover = PODCAST.cover;

const APPLE = "https://podcasts.apple.com/ca/podcast/ayush-prakash-podcast/id1557703631";
const SPOTIFY = "https://open.spotify.com/show/1ILhje5HSua1FEOlTyFAhG";

// Feed descriptions carry a tail of promo links. Keep the human part.
function blurb(text: string) {
  if (!text) return "";
  const cut = text.split(/Connect with|Podcast Info:|https?:\/\//)[0].trim();
  return cut.length > 260 ? cut.slice(0, 257).trimEnd() + "\u2026" : cut;
}

function fmtDate(pubDate: string) {
  const d = new Date(pubDate);
  if (isNaN(d.getTime())) return "";
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}

// Sourced from the Center's own published bio and the feed. Extend as the
// roster grows; the band reads straight from this list.
const guests = [
  { n: "Avi Loeb", r: "Astrophysicist, Harvard" },
  { n: "Karl Friston", r: "Neuroscientist, University College London" },
  { n: "Sheldon Solomon", r: "Psychologist, Skidmore College" },
  { n: "Nidhi Hegde", r: "Computing science, University of Alberta" },
];

const sections = [
  { label: "Latest", href: "#latest" },
  { label: "All episodes", href: "#all" },
  { label: "Who comes on", href: "#guests" },
  { label: "For Mantic authors", href: "#authors" },
];
---
<Base
  title="Podcast"
  description="The Ayush Prakash Podcast: long-form conversations on the technologies reshaping how we think."
  ctaHeading="Follow the show."
  ctaBody="New conversations publish on YouTube, Spotify, and Apple Podcasts."
  ctaLabel="Subscribe on YouTube"
  ctaHref={PODCAST.url}
>
  <PageHead id="pd">
    Conversations on the technologies reshaping how we think.
    <div slot="aside" class="cov"><img src={cover} alt={`${PODCAST.name} cover art`} /></div>
    <p slot="lede" class="lede">
      {PODCAST.blurb} Hosted by Ayush Prakash, Director of the Center.
    </p>
    <div slot="cta" class="plat">
      <a href={APPLE} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="5.4" fill="currentColor"/><g fill="#fff"><circle cx="12" cy="9.1" r="2.15"/><path d="M12 12.4c-1.55 0-2.6.8-2.6 1.85 0 .5.28 2.2.5 3.16.2.88.62 1.34 1.05 1.55.4.2 1.7.2 2.1 0 .43-.21.85-.67 1.05-1.55.22-.96.5-2.66.5-3.16 0-1.05-1.05-1.85-2.6-1.85Z"/><path d="M12 3.9a5.6 5.6 0 0 0-3.5 9.97.72.72 0 0 0 .9-1.12A4.16 4.16 0 1 1 16.16 9.5c0 1.28-.58 2.44-1.5 3.2a.72.72 0 1 0 .9 1.13A5.6 5.6 0 0 0 12 3.9Z"/></g></svg>
        <span>Apple Podcasts</span>
      </a>
      <a href={SPOTIFY} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="currentColor"/><g stroke="#fff" stroke-linecap="round" fill="none"><path d="M6.6 9.3c3.4-1 7.2-.7 10.3 1" stroke-width="2.1"/><path d="M7.4 12.6c2.8-.8 5.9-.5 8.4.9" stroke-width="1.8"/><path d="M8.2 15.7c2.2-.6 4.6-.4 6.6.7" stroke-width="1.5"/></g></svg>
        <span>Spotify</span>
      </a>
      <a href={PODCAST.url} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect y="4.4" width="24" height="15.2" rx="4.2" fill="currentColor"/><path d="M10 8.6l5.6 3.4L10 15.4V8.6Z" fill="#fff"/></svg>
        <span>YouTube</span>
      </a>
    </div>
  </PageHead>

  <SubNav items={sections} />

  {fetchFailed ? (
    <section class="sec">
      <div class="wrap">
        <p class="lede">
          Episodes couldn't be loaded from the feed at build time. Listen on
          <a href={PODCAST.url} target="_blank" rel="noopener noreferrer" style="color:var(--ink);border-bottom:1px solid var(--red)"> YouTube</a>
          or <a href={SPOTIFY} target="_blank" rel="noopener noreferrer" style="color:var(--ink);border-bottom:1px solid var(--red)">Spotify</a> in the meantime.
        </p>
      </div>
    </section>
  ) : (
    <>
      <section class="sec" id="latest">
        <div class="wrap">
          <div class="shead"><h3>Latest episode</h3></div>
          {latest && (
            <div>
              <div class="rule"></div>
              <div class="arow" style="align-items:start;padding-top:clamp(28px,3.4vw,44px)">
                <div>
                  <h4 style="font-size:clamp(24px,2.8vw,34px);line-height:1.22">{latest.title}</h4>
                  <p class="mono" style="margin-top:12px">{fmtDate(latest.pubDate)}</p>
                  {latest.audio && <audio controls preload="none" src={latest.audio} style="margin-top:26px;width:100%;max-width:520px"></audio>}
                </div>
                {latest.description && <p class="mut">{blurb(latest.description)}</p>}
              </div>
            </div>
          )}
        </div>
      </section>

      <section class="sec sec--g" id="all">
        <div class="wrap">
          <div class="shead">
            <h3>All episodes</h3>
            <input class="srch" id="ep-search" type="text" placeholder="Search episodes" aria-label="Search episodes" />
          </div>
          <div class="eplist" id="ep-list" style="background:#fff;border-radius:var(--r);padding:0 clamp(20px,3vw,32px);border-top:0">
            {rest.map((ep, i) => (
              <a class="eprow" href={ep.audio || PODCAST.url} target="_blank" rel="noopener noreferrer"
                 data-title={ep.title.toLowerCase()} data-desc={ep.description.toLowerCase()}>
                <span class="epcov"><img src={cover} alt="" loading="lazy" /></span>
                <span class="epn">{String(rest.length - i).padStart(3, "0")}</span>
                <span>
                  <span class="ept">{ep.title}</span>
                  <span class="epd">{fmtDate(ep.pubDate)}</span>
                </span>
                <span class="epa go sm">Listen <Arrow /></span>
              </a>
            ))}
          </div>
          <p id="ep-empty" style="display:none;padding:40px 0;color:var(--mut)">No episodes match that search.</p>
          <div id="ep-more-wrap" class="epmore">
            <button id="ep-more" class="btn btn--gh" style="background:#fff" type="button">Load more</button>
            <span id="ep-left" class="cnt"></span>
          </div>
        </div>
      </section>
    </>
  )}

  <section class="band band--dim" id="guests">
    <div class="rnw"><Field v="dark-slate" id="pg" w={2400} h={900} /></div>
    <div class="wrap">
      <h3 style="max-width:20ch">Researchers, critics, and builders.</h3>
      <p>
        The show books people who have spent years on a question and are willing to be pushed on
        the answer. Conversations run as long as they need to, because the interesting part is
        rarely in the first twenty minutes.
      </p>
      <div class="pts" style="grid-template-columns:repeat(4,1fr)">
        {guests.map((g) => (
          <div class="pt">
            <h4>{g.n}</h4>
            <p>{g.r}</p>
          </div>
        ))}
      </div>
      <p class="mono" style="margin-top:clamp(28px,3vw,40px);color:rgba(255,255,255,.5)">
        {episodes.length > 0 ? episodes.length : "160+"} conversations since 2021, published in full
      </p>
    </div>
  </section>


  <section class="sec" id="authors">
    <div class="wrap">
      <div class="g2">
        <a class="ncard ncard--d" href="/work/mantic">
          <div class="bd bd--lg" style="justify-content:center">
            <h4 style="font-size:clamp(24px,2.6vw,32px)">Every published Mantic author gets a seat.</h4>
            <p class="sm mut">
              A long-form conversation about the book with an audience that will push on it.
              The book is where the argument starts. This is where it gets tested.
            </p>
            <span class="go">About Mantic <Arrow /></span>
          </div>
        </a>
        <div class="ncard ncard--o">
          <div class="bd bd--lg" style="justify-content:center">
            <h4 style="font-size:clamp(24px,2.6vw,32px)">Working on something most people have wrong?</h4>
            <p class="sm mut">
              Send the question you have been sitting with, what the consensus answer is,
              and why it does not hold.
            </p>
            <a class="btn" style="margin-top:18px;align-self:flex-start" href="/contact">Pitch the show</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const input = document.getElementById("ep-search");
  const list = document.getElementById("ep-list");
  const empty = document.getElementById("ep-empty");
  const moreBtn = document.getElementById("ep-more");
  const moreWrap = document.getElementById("ep-more-wrap");
  const left = document.getElementById("ep-left");

  if (list) {
    const rows = Array.from(list.querySelectorAll(".eprow"));
    const FIRST = 5;
    const STEP = 10;
    let shown = FIRST;

    function draw() {
      const q = input ? input.value.trim().toLowerCase() : "";
      let matches = 0;

      for (const row of rows) {
        const hit = !q || row.dataset.title.includes(q) || row.dataset.desc.includes(q);
        if (hit) matches++;
        // searching reaches the whole back catalogue; browsing is paged
        row.style.display = q ? (hit ? "" : "none") : (matches <= shown && hit ? "" : "none");
      }

      if (empty) empty.style.display = matches === 0 ? "block" : "none";
      const remaining = rows.length - shown;
      if (moreWrap) moreWrap.style.display = !q && remaining > 0 ? "flex" : "none";
      if (left) left.textContent = remaining > 0 ? `${remaining} more` : "";
    }

    if (moreBtn) moreBtn.addEventListener("click", () => { shown += STEP; draw(); });
    if (input) input.addEventListener("input", draw);
    draw();
  }
</script>
