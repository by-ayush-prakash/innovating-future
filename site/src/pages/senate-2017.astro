---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SubNav from "../components/SubNav.astro";
import Arrow from "../components/Arrow.astro";

const facts = [
  { k: "Date", v: "2 February 2017" },
  { k: "Body", v: "Standing Senate Committee on Social Affairs, Science and Technology" },
  { k: "Study", v: "Robotics, 3D printing and artificial intelligence in the healthcare system" },
  { k: "Witness", v: "Abishur Prakash, Director, 2012 to 2022" },
  { k: "Appearing with", v: "Dr Bertalan Meskó, by video from Hungary" },
  { k: "Record", v: "Committee evidence, 42nd Parliament" },
];

// Verdicts are graded against public evidence gathered in 2026. Sources on each row.
const scorecard = [
  {
    v: "held",
    claim: "Canada needs an official robotics strategy.",
    then: "Japan had a New Robot Strategy. China had Made in China 2025. Canada, the Center told the committee, had grants.",
    now: "Canada still has no federal robotics strategy, and no provincial one. The 2026 national AI strategy names robotics once, as a sector. Canada installs 241 robots per 10,000 manufacturing workers, against Korea's 1,220.",
    src: "https://www.cigionline.org/articles/its-time-to-invest-in-canadian-robotics/",
    srcName: "CIGI, 2024",
  },
  {
    v: "held",
    claim: "Hospitals will rent robots rather than buy them.",
    then: "A subscription model, argued against six-figure capital outlays that lock a hospital into the year it purchased.",
    now: "Robotics-as-a-Service is now a named category worth roughly $2 to $3 billion. Diligent Robotics' Moxi runs in about 100 US hospitals and is not sold outright to any of them.",
    src: "https://www.fortunebusinessinsights.com/robots-as-a-service-market-111525",
    srcName: "Fortune Business Insights",
  },
  {
    v: "held",
    claim: "Phones will talk to biosensors and monitor people continuously.",
    then: "Described as remote monitoring through a device the patient already owns.",
    now: "Apple Watch sleep apnea notifications cleared by the FDA in 2024, hypertension notifications in 2025, and Dexcom Stelo cleared as the first over-the-counter glucose biosensor in 2024.",
    src: "https://www.cnbc.com/2024/09/16/fda-clears-apples-sleep-apnea-detection-feature-for-here-how-it-works.html",
    srcName: "FDA clearances, 2024 to 2025",
  },
  {
    v: "partly",
    claim: "An algorithm will diagnose skin cancer.",
    then: "Cited as an early example of machine diagnosis reaching clinical standard.",
    now: "The most vindicated call. DermaSensor cleared in 2024, and NICE conditionally recommended Skin Analytics' DERM for the NHS in 2025 after more than 165,000 patients. But published models lost most of their accuracy on darker skin, and NICE now requires clinician review for Black and brown patients.",
    src: "https://www.nice.org.uk/news/articles/ai-skin-cancer-detection-system-gets-green-light-for-conditional-nhs-use",
    srcName: "NICE, 2025",
  },
  {
    v: "failed",
    claim: "IBM Watson prescribed the same treatment as doctors 99 percent of the time.",
    then: "Offered to the committee as evidence that clinical AI was ready.",
    now: "The number was real and the inference was wrong. Agreement with doctors measures imitation, not correctness. Seventeen days after this testimony, an audit found MD Anderson had spent more than $62 million on Watson without using it on a patient. IBM sold Watson Health in 2022 for a reported $1 billion, against roughly $4.6 billion spent assembling it.",
    src: "https://www.statnews.com/2018/07/25/ibm-watson-recommended-unsafe-incorrect-treatments/",
    srcName: "STAT, 2018",
  },
  {
    v: "failed",
    claim: "42 percent of Canadian jobs, 7.5 million, are at risk of automation.",
    then: "Taken from the Brookfield Institute's 2016 study and used to argue urgency.",
    now: "Canada added about 2.6 million jobs between 2017 and 2026. Retrospectives now call that generation of automation forecasts wildly inaccurate. The C.D. Howe Institute published a rebuttal six weeks after this hearing. The Center cited the alarming study when the counter-evidence was already available.",
    src: "https://hdsr.mitpress.mit.edu/pub/ppjz2dg9/download/pdf",
    srcName: "Harvard Data Science Review, 2025",
  },
  {
    v: "failed",
    claim: "AI on phones will spot an epidemic from patterns of coughing and sneezing.",
    then: "Offered as a public health application of ambient sensing.",
    now: "This got the largest possible test. A UK study of audio from 67,842 people during COVID found models that looked 98.5 percent accurate had simply learned to detect symptoms. Against a symptom questionnaire, the audio added nothing.",
    src: "https://www.turing.ac.uk/blog/can-sound-someones-cough-be-used-detect-covid-19",
    srcName: "Alan Turing Institute",
  },
  {
    v: "open",
    claim: "Pathology and radiology will be automated within 15 to 20 years.",
    then: "A window running to 2032 at the earliest.",
    now: "Nine years in, running the other way. Radiologist pay reached a record in 2025, roughly 4,300 US posts sit open, and fewer than 15 percent of US health systems have even chosen a digital pathology vendor. Geoffrey Hinton's harder version of this call, made in 2016, has been withdrawn.",
    src: "https://car.ca/wp-content/uploads/2026/04/CAR-Wait-Times-Policy-Statement-EN_2026-03.pdf",
    srcName: "Canadian Association of Radiologists, 2026",
  },
];

const label: Record<string, string> = { held: "Held up", partly: "Partly", failed: "Did not hold", open: "Still open" };
const tally = {
  held: scorecard.filter((s) => s.v === "held").length,
  failed: scorecard.filter((s) => s.v === "failed").length,
  other: scorecard.filter((s) => s.v === "partly" || s.v === "open").length,
};

const sections = [
  { label: "The appearance", href: "#appearance" },
  { label: "What we said", href: "#said" },
  { label: "The scorecard", href: "#scorecard" },
  { label: "What still stands", href: "#stands" },
];
---
<Base
  title="Before the Senate"
  description="In February 2017 the Center gave evidence to the Standing Senate Committee on Social Affairs, Science and Technology on robotics, 3D printing and AI in healthcare. This is what it said, and what nine years did to it."
  ctaHeading="The Center gives evidence."
  ctaBody="It has appeared before a Senate committee and been cited by the Brookings Institution and the Foreign Policy Research Institute. Committees, agencies and standards bodies working on robotics, automation or AI policy can write directly."
>
  <PageHead field="dark-teal" id="sn">
    CIF Before the Senate.
    <p slot="lede" class="lede">
      The Center was called as a witness on what robotics, 3D printing and artificial intelligence
      would do to Canadian healthcare. Nine years have passed. Every claim it made that day is on
      the public record, so here is the scorecard, including the parts it got wrong.
    </p>
    <div slot="cta" class="cta">
      <a class="btn" href="#scorecard">The scorecard</a>
      <a class="btn btn--gh" href="https://sencanada.ca/en/content/sen/Committee/421/soci/14ev-53044-e" target="_blank" rel="noopener noreferrer">Full transcript</a>
    </div>
  </PageHead>

  <SubNav items={sections} />

  <section class="sec" id="appearance">
    <div class="wrap">
      <div class="arow" style="align-items:start">
        <div>
          <div class="strip" style="grid-template-columns:repeat(3,1fr)">
            <div><div class="n">{tally.held}</div><p>Claims that held up against public evidence.</p></div>
            <div><div class="n">{tally.failed}</div><p>Claims that did not hold, published here anyway.</p></div>
            <div><div class="n">{tally.other}</div><p>Partly right, or still open nine years on.</p></div>
          </div>
          <p class="dnote">
            The full transcript is published by the
            <a href="https://sencanada.ca/en/content/sen/Committee/421/soci/14ev-53044-e" target="_blank" rel="noopener noreferrer">Senate of Canada</a>.
            The committee's report, <em>Challenge Ahead</em>, followed in October 2017.
          </p>
        </div>
        <div class="reg">
          {facts.map((f) => (
            <div class="rg"><span class="lbl">{f.k}</span><span>{f.v}</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--g" id="said">
    <div class="wrap">
      <div class="shead"><h3>What the Center said</h3></div>
      <div class="alt">
        <div class="arow">
          <div class="afig" style="aspect-ratio:16/9">
            <img src="/images/senate-01.jpg" alt="The Senate of Canada committee page for the Standing Committee on Social Affairs, Science and Technology, Issue No. 14, Evidence, 2 February 2017." width="1600" height="773" style="width:100%;height:100%;object-fit:cover" />
          </div>
          <div>
            <p style="color:var(--ink-2)">
              The evidence was a survey of what other countries were already doing and Canada was
              not. Robots delivering medicine and changing sheets in American hospitals. A smart
              contact lens in South Korea monitoring diabetes through the eye. Printed blood vessels
              implanted in a monkey in China. A robot pharmacist in the UAE dispensing twelve
              medications in under a minute. Eleven robots in Saskatchewan, one of them reaching a
              First Nations reserve.
            </p>
          </div>
        </div>
        <div class="arow arow--f">
          <div class="afig">
            <img src="/images/senate-02.jpg" alt="" width="1600" height="1200" style="width:100%;height:100%;object-fit:cover" />
          </div>
          <div>
            <p style="color:var(--ink-2)">
              Underneath the examples sat one recommendation, repeated to several senators.
              Japan had published a New Robot Strategy. China had Made in China 2025 and a single
              province with $150 billion earmarked. Canada had neither a federal robotics strategy
              nor a provincial one. The Center told the committee that grants are not a strategy.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="scorecard">
    <div class="wrap">
      <div class="shead">
        <h3>The scorecard</h3>
        <p class="sm mut" style="max-width:34ch">Graded in 2026 against public evidence. Sources on each row.</p>
      </div>
      <div class="rule"></div>
      <div class="scard" style="border-top:0">
        {scorecard.map((s) => (
          <div class="sc">
            <div><span class={`tag t-${s.v}`}>{label[s.v]}</span></div>
            <div>
              <h3>{s.claim}</h3>
              <p class="sc-then"><span class="mono">2017</span>{s.then}</p>
              <p class="sc-now"><span class="mono">2026</span>{s.now}</p>
              <a class="sc-src" href={s.src} target="_blank" rel="noopener noreferrer">{s.srcName} &rsaquo;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--g" id="stands">
    <div class="wrap">
      <div class="shead"><h3>What still stands</h3></div>
      <div class="arow">
        <div class="afig" style="background:#fff;aspect-ratio:16/10;display:flex;align-items:center;padding:clamp(20px,3vw,40px)">
          <img src="/images/robot-density.svg" alt="Industrial robot density by country in 2024. Canada 241 robots per 10,000 manufacturing employees, world average 132, Republic of Korea 1,220." style="width:100%" />
        </div>
        <div class="body">
          <p><strong>Canada does not have too many robots. It has too few.</strong> At 241 per
          10,000 manufacturing workers it sits behind Korea, Singapore, Germany, Japan and the
          United States, and it imports nearly all of them.</p>
          <p>
            The recommendation survived the reasoning that produced it. In 2017 the Center argued
            Canada needed a robotics strategy partly because automation was about to take 42 percent
            of Canadian jobs. It did not. Canada added roughly 2.6 million jobs instead.
          </p>
          <p>
            The Canadian Robotics Council, formed five years after this hearing, is still asking for
            the same document the Center asked for in 2017.
          </p>
          <p>
            That is the useful thing about being on the record. A position taken in public can be
            checked, and the parts that break tell you more than the parts that hold.
          </p>
          <a class="go" href="/media" style="margin-top:8px">Everything the Center is on the record for <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
</Base>
