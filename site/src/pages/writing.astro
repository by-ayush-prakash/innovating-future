---
import Base from "../layouts/Base.astro";

const items = [
  {
    date: "July 2026",
    headline: "The Infinity of the Brain and the Void of the Machine",
    attribution: "Ayush Prakash & Karl Friston",
    source: "The Montréal Review",
    url: "https://www.themontrealreview.com/Articles/the_infinity_of_the_brain_and_the_void_of_the_machine.php",
  },
  {
    date: "Nov 14, 2025",
    headline: "The Risks of AI and Social Media for the Developing Brain",
    attribution: "Ran D. Anbar, MD & Ayush Prakash",
    source: "Psychology Today",
    url: "https://www.psychologytoday.com/sg/blog/understanding-hypnosis/202511/the-risks-of-ai-and-social-media-for-the-developing-brain",
  },
];
---
<Base title="Writing" description="Essays by CIF's director, published in outlets CIF does not control.">
  <div class="wrap phead">
    <h1>Writing.</h1>
    <p class="sub">
      Essays published in outlets CIF does not control.
    </p>
  </div>

  <section>
    <div class="wrap">
      <div class="rows">
        {items.map((it) => (
          <a class="row" href={it.url} target="_blank" rel="noopener noreferrer">
            <span class="mono">{it.date}</span>
            <div>
              <h3>{it.headline}</h3>
              <span class="attrib">{it.attribution}</span>
            </div>
            <span class="src">{it.source} &rsaquo;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
