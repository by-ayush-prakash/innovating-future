---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";

const checks = [
  { n: "01", h: "Conviction over credentials", p: "People who have taken positions in public and defended them, rather than held titles." },
  { n: "02", h: "Builders", p: "A preference for people who produce work over people who administer it." },
  { n: "03", h: "Comfort with ambiguity", p: "The Center's programs are being defined as they are built. That is the work, not a stage of it." },
];
---
<Base
  title="Careers"
  description="The Center is not currently hiring for defined roles. Proposals for roles that do not yet exist are welcome."
  ctaHeading="Start with the work."
  ctaBody="It sets the standard anyone joining the Center would be asked to help hold."
  ctaLabel="See our work"
  ctaHref="/work"
>
  <PageHead photo="/images/careers.jpg" alt="Three people working together at a table" id="cr">
    Careers.
    <p slot="lede" class="lede">
      The Center is not currently hiring for defined roles. Proposals for roles that do not yet
      exist are welcome. They should make their own case.
    </p>
    <div slot="cta" class="cta">
      <a class="btn" href="/contact">Make the case</a>
      <a class="btn btn--gh" href="/work">See our work</a>
    </div>
  </PageHead>

  <section class="sec">
    <div class="wrap">
      <div class="arow" style="align-items:start">
        <div>
          <h3>Proposals, not applications.</h3>
        </div>
        <div class="body" style="max-width:none">
          <p>CIF builds institutions and holds them. Each will need people running it as it matures.</p>
          <p>That makes a position here less a matter of an opening that exists today than of which institution someone wants to help build. Early positions carry wide scope and direct ownership of outcomes.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--t">
    <div class="wrap">
      <div class="rule"></div>
      <div class="nums">
        {checks.map((c) => (
          <div class="nrow"><span class="n">{c.n}</span><h4>{c.h}</h4><p>{c.p}</p></div>
        ))}
      </div>
    </div>
  </section>
</Base>
