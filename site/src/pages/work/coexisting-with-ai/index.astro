---
import Base from "../../../layouts/Base.astro";
import PageHead from "../../../components/PageHead.astro";
import SubNav from "../../../components/SubNav.astro";
import Field from "../../../components/Field.astro";
import Arrow from "../../../components/Arrow.astro";
import { SKEPTICISM, ORG } from "../../../config";

const holds = [
  {
    n: "01",
    h: "Coexistence is not acceptance.",
    p: "Living alongside a technology means asking it to show its work before granting it trust. Every institution is held to that standard. Artificial intelligence has mostly been exempted from it. The Center holds itself to the same test.",
    photo: "/images/prog-01.jpg",
  },
  {
    n: "02",
    h: "The question is older than the technology.",
    p: "The Center has worked on this since 2010. Through robotics. Through the last automation cycle. Now through this one. The through line is not the tool. It is what happens to the people standing next to it.",
    photo: "/images/prog-02.jpg",
  },
  {
    n: "03",
    h: "Written for the person who has to act.",
    p: "Not for the reader who wants to be persuaded. Every session, assessment and paper ends in something a specific person can do. In an organization that already exists. With the constraints it already has.",
    photo: "/images/prog-03.jpg",
  },
];

const motions = [
  { n: "01", h: "Convene", p: "Researchers, policy staff and operators in one room, on one question. Not separate rooms describing it to each other." },
  { n: "02", h: "Publish", p: "Assessments that let someone outside an institution measure it against a standard it did not set. Then the step-by-step material for whoever has to act on the result." },
  { n: "03", h: "Advise", p: "Private briefings and workshops for leadership teams, delivered by the Center's own principals. No client, sponsor or employer determines what the program publishes." },
];

// Ways an organization takes the program on. Named as shapes, not tiers,
// and never priced on the page. Every one is built for the room.
const shapes = [
  { t: "A briefing",
    p: "Ninety minutes with a leadership team. The argument, the evidence behind it, and what it means for one specific operation rather than for the economy." },
  { t: "A working session",
    p: "A full day, built around the decisions actually in front of the team. They leave with their own answer written down, not the Center's." },
  { t: "A standing arrangement",
    p: "The Center works alongside a team across a quarter or a year, because the question keeps moving and a single session freezes it." },
  { t: "A hosted convening",
    p: "The organization hosts a public session and shapes the agenda alongside the Center rather than joining a finished one." },
];

const sections = [
  { label: "The program", href: "#program" },
  { label: "How it works", href: "#how" },
  { label: "Sessions", href: "#sessions" },
  { label: "Bring it in", href: "#bring" },
  { label: "The record", href: "#record" },
  { label: "More from the Center", href: "#more" },
];
---
<Base
  title={SKEPTICISM.name}
  description="The Center's program on what changes for people and organizations when the work starts being done alongside a machine. Convenings, research, and executive sessions."
  ctaHeading="Host, partner, or bring the program in."
  ctaBody="Host institutions shape the agenda alongside the Center rather than joining a finished one. Partners and organizations working on the same questions can write directly."
  ctaField="dark-teal"
>
  <PageHead photo="/images/coexisting-with-ai.jpg" alt="A head in silhouette opening onto a green field, with a bird on the steps and clouds passing through" id="cx">
    Co-Existing with AI.
    <p slot="lede" class="lede">
      Whether you are a student, an entrepreneur, or the leader of a business or a nation, you
      will need new strategies to become, and remain, successful.
    </p>
    <div slot="cta" class="cta">
      <a class="btn" href="/contact">Work with the Center</a>
      <a class="btn btn--gh" href="#program">What the program holds</a>
    </div>
  </PageHead>

  <SubNav items={sections} />

  <section class="sec">
    <div class="wrap">
      <div class="intro">
        <h3>Artificial intelligence is not arriving as a product decision.</h3>
        <p class="lede">
          It is arriving as a change to what work is, who does it, and what a person is for
          inside an organization. The Center studies the human side of it. What actually happens
          to people when the work is done alongside a machine. What a leader is supposed to do
          about it on Monday.
        </p>
      </div>
    </div>
  </section>

  <section class="sec" id="program">
    <div class="wrap">
      <div class="shead"><h3>AI is new. The question is not.</h3></div>
      <div class="alt">
        {holds.map((k, i) => (
          <div class={i % 2 === 1 ? "arow arow--f" : "arow"}>
            <div class="afig"><img class="rn" src={k.photo} alt="" width="1600" height="1200" loading="lazy" /></div>
            <div>
              <h3>{k.h}</h3>
              <p>{k.p}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--g" id="how">
    <div class="wrap">
      <div class="shead">
        <h3>How the program works</h3>
      </div>
      <div class="nums">
        {motions.map((m) => (
          <div class="nrow"><span class="n">{m.n}</span><h4>{m.h}</h4><p>{m.p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="record">
    <div class="wrap">
      <div class="shead"><h3>The record</h3></div>
      <div class="arow" style="align-items:center">
        <div class="afig">
          <img class="rn" src="/images/senate-02.jpg" alt="The colonnade of a parliamentary building" loading="lazy" />
        </div>
        <div>
          <p class="mono">Senate of Canada &middot; 2 February 2017</p>
          <h3 style="margin-top:18px;max-width:24ch">We told the Senate Canada needed a robotics strategy. It still does.</h3>
          <p style="margin-top:20px">
            Japan had published a New Robot Strategy. China had Made in China 2025. Canada, the
            Center told the committee, had grants. Nine years on it installs 241 industrial robots
            per 10,000 manufacturing workers against Korea's 1,220, and the Canadian Robotics
            Council is still asking for the document the Center asked for in 2017.
          </p>
          <p style="margin-top:16px">
            Every claim from that appearance is graded in public, with sources. The ones that broke
            are on the same page as the ones that held.
          </p>
          <a class="go" style="margin-top:28px" href="/senate-2017">Read the scorecard <Arrow /></a>
        </div>
      </div>
    </div>
  </section>


  <section class="sec" id="sessions">
    <div class="wrap">
      <div class="shead"><h3>From the program</h3></div>
      <a class="arow" href="/work/coexisting-with-ai/microsoft-reactor" style="align-items:center">
        <div class="afig" style="aspect-ratio:16/10">
          <img class="rn" src="/images/microsoft-reactor.jpg" alt="Microsoft Reactor Toronto at CIBC Square, people arriving for a session" loading="lazy" />
        </div>
        <div>
          <p class="mono">Microsoft Reactor Toronto &middot; 20 February 2025</p>
          <h3 style="margin-top:18px">Coexisting with AI: Succeeding In the New Era</h3>
          <p style="margin-top:20px">
            Created and hosted by the Center at CIBC Square. Part of the opening series at
            Microsoft Reactor Toronto.
          </p>
          <span class="go" style="margin-top:28px">The session <Arrow /></span>
        </div>
      </a>
    </div>
  </section>

  <section class="sec sec--g" id="bring">
    <div class="wrap">
      <div class="arow" style="align-items:start">
        <div>
          <h3>Bring the program into your organization.</h3>
          <p class="lede" style="margin-top:24px">
            Delivered by the people who did the research, shaped around what your
            organization is working through.
          </p>
          <div class="cta" style="margin-top:34px">
            <a class="btn" href="/contact">Start a conversation</a>
            <a class="btn btn--gh" style="background:#fff" href="/work/coexisting-with-ai/microsoft-reactor">See a session</a>
          </div>
        </div>
        <div>
          <div class="rule"></div>
          <div class="lrows" style="border-top:0">
            {shapes.map((k) => (
              <div class="lrow">
                <span class="t">{k.t}</span>
                <p>{k.p}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="more">
    <div class="wrap">
      <div class="shead"><h3>More from the Center</h3></div>
      <div class="g3">
        <a class="ncard" href="/work/ai-native-generation">
          <div class="im"><img class="rn" src="/images/first-ai-native-generation.jpg" alt="A model brain on a yellow grid, marked by a cursor and a red dot" loading="lazy" /></div>
          <div class="bd">
            <h4>The First AI-Native Generation</h4>
            <p class="sm mut">What sustained interaction with conversational AI does to cognition, identity, and agency.</p>
            <span class="go">Take part <Arrow /></span>
          </div>
        </a>
        <a class="ncard" href="/work/mantic">
          <div class="im"><Field v="sand" id="cn2" w={1200} h={675} /></div>
          <div class="bd">
            <h4>Mantic Publishing</h4>
            <p class="sm mut">The Center's press. Long-form arguments on the ideas changing what it means to be human.</p>
            <span class="go">Visit Mantic <Arrow /></span>
          </div>
        </a>
        <a class="ncard" href="/podcast">
          <div class="im im--art"><img src="/images/podcast-cover.png" alt="The Ayush Prakash Podcast cover art" loading="lazy" /></div>
          <div class="bd">
            <h4>The Ayush Prakash Podcast</h4>
            <p class="sm mut">Long-form conversations with researchers, critics, and builders.</p>
            <span class="go">Explore episodes <Arrow /></span>
          </div>
        </a>
      </div>
    </div>
  </section>
</Base>
