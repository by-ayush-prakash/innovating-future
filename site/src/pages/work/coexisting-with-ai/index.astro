---
import Base from "../../../layouts/Base.astro";
import PageHead from "../../../components/PageHead.astro";
import SubNav from "../../../components/SubNav.astro";
import Field from "../../../components/Field.astro";
import Arrow from "../../../components/Arrow.astro";
import { SKEPTICISM, ORG } from "../../../config";

const holds = [
  {
    n: "01",
    h: "Coexistence is not acceptance.",
    p: "Living alongside a technology means asking it to show its work before granting it trust. Every institution is held to that standard. Artificial intelligence has mostly been exempted from it. The Center holds itself to the same test.",
    field: "sand",
  },
  {
    n: "02",
    h: "The question is older than the technology.",
    p: "The Center has worked on this since 2010. Through robotics. Through the last automation cycle. Now through this one. The through line is not the tool. It is what happens to the people standing next to it.",
    field: "stone",
  },
  {
    n: "03",
    h: "Written for the person who has to act.",
    p: "Not for the reader who wants to be persuaded. Every session, assessment and paper ends in something a specific person can do. In an organization that already exists. With the constraints it already has.",
    field: "dark-red",
  },
];

const motions = [
  { n: "01", h: "Convene", p: "Researchers, policy staff and operators in one room, on one question. Not separate rooms describing it to each other." },
  { n: "02", h: "Publish", p: "Assessments that let someone outside an institution measure it against a standard it did not set. Then the step-by-step material for whoever has to act on the result." },
  { n: "03", h: "Advise", p: "Private briefings and workshops for leadership teams, delivered by the Center's own principals. No client, sponsor or employer determines what the program publishes." },
];

const sections = [
  { label: "The program", href: "#program" },
  { label: "How it works", href: "#how" },
  { label: "Sessions", href: "#sessions" },
  { label: "The record", href: "#record" },
  { label: "More from the Center", href: "#more" },
];
---
<Base
  title={SKEPTICISM.name}
  description="The Center's program on what changes for people and organizations when the work starts being done alongside a machine. Convenings, research, and executive sessions."
  ctaHeading="Host, partner, or bring the program in."
  ctaBody="Host institutions shape the agenda alongside the Center rather than joining a finished one. Partners and organizations working on the same questions can write directly."
>
  <PageHead kicker="A program of the Center" field="dark-red"
            caption="Microsoft Reactor Toronto &middot; CIBC Square &middot; February 2025" id="cx">
    Co-Existing with AI.
    <p slot="lede" class="lede">
      Whether you are a student, an entrepreneur, or the leader of a business or a nation, you
      will need new strategies to become, and remain, successful.
    </p>
    <div slot="cta" class="cta" style="margin-top:34px">
      <a class="btn" href="/contact">Work with the Center</a>
      <a class="btn btn--gh" href="#program">What the program holds</a>
    </div>
  </PageHead>

  <SubNav items={sections} />

  <section class="sec">
    <div class="wrap" style="max-width:1180px">
      <h3>
        Artificial intelligence is not arriving as a product decision. It is arriving as a change
        to what work is, who does it, and what a person is for inside an organization.
      </h3>
      <p class="lede" style="margin-top:34px;max-width:64ch">
        Most of the material written about that change is produced by the companies selling it.
        The Center works the other side. What actually happens to people when the work is done
        alongside a machine. What a leader is supposed to do about it on Monday.
      </p>
    </div>
  </section>

  <section class="sec sec--t" id="program">
    <div class="wrap">
      <div class="shead"><h3>What the program holds</h3></div>
      <div class="alt">
        {holds.map((k, i) => (
          <div class={i % 2 === 1 ? "arow arow--f" : "arow"}>
            <div class="afig"><Field v={k.field} id={`cp${i}`} w={1000} h={750} /></div>
            <div>
              <p class="mono" style="margin-bottom:20px">{k.n}</p>
              <h3>{k.h}</h3>
              <p>{k.p}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--g" id="how">
    <div class="wrap">
      <div class="shead">
        <h3>How the program works</h3>
        <p class="sm mut" style="max-width:38ch">
          Each motion feeds the next. What comes out of a room becomes something published.
          What gets published is what an organization pays the Center to help it act on.
        </p>
      </div>
      <div class="rule"></div>
      <div class="nums">
        {motions.map((m) => (
          <div class="nrow"><span class="n">{m.n}</span><h4>{m.h}</h4><p>{m.p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="record">
    <div class="rnw"><Field v="dark-teal" id="cs" w={2400} h={900} /></div>
    <div class="wrap">
      <p class="mono">The record</p>
      <h3 style="margin-top:26px">
        We told a Senate committee that 42 per cent of Canadian jobs were at risk.
        Canada added jobs instead.
      </h3>
      <p>
        The Center appeared before the Standing Senate Committee on Social Affairs, Science and
        Technology on 2 February 2017. Nine years on we graded every claim we made, in public,
        with sources. Three held. Three failed. This is the standard the program applies to
        everyone else, so it applies here first.
      </p>
      <a class="btn btn--w" style="margin-top:34px" href="/senate-2017">Read the scorecard</a>
    </div>
  </section>

  <section class="sec" id="sessions">
    <div class="wrap">
      <div class="shead"><h3>From the program</h3></div>
      <div class="g2">
        <a class="ncard" href="/work/coexisting-with-ai/microsoft-reactor">
          <div class="im"><Field v="sand-amber" id="cm" w={1200} h={675} /></div>
          <div class="bd">
            <p class="mono">Microsoft Reactor Toronto &middot; 20 February 2025</p>
            <h4>Coexisting with AI: Succeeding In the New Era</h4>
            <p class="sm mut">Created and hosted by the Center at CIBC Square. Part of the opening series at Microsoft Reactor Toronto.</p>
            <span class="go">The session <Arrow /></span>
          </div>
        </a>
        <div class="ncard ncard--d">
          <div class="bd bd--lg" style="justify-content:center">
            <p class="mono">Private</p>
            <h4 style="font-size:clamp(24px,2.6vw,32px)">Bring it to your organization.</h4>
            <p class="sm mut">
              The Center runs the session as a private briefing or a full-day workshop for
              leadership teams working out what changes in their own operation.
            </p>
            <a class="btn btn--w" style="margin-top:18px;align-self:flex-start" href="/contact">Enquire</a>
          </div>
        </div>
      </div>
      <p class="dnote">
        Requests for the material go to <a href={"mailto:" + ORG.email}>{ORG.email}</a>.
      </p>
    </div>
  </section>

  <section class="sec sec--t" id="more">
    <div class="wrap">
      <div class="shead"><h3>More from the Center</h3></div>
      <div class="g3">
        <a class="ncard" href="/work/ai-native-generation">
          <div class="im"><Field v="grey-red" id="cn1" w={1200} h={675} /></div>
          <div class="bd">
            <p class="mono">Research &middot; Fieldwork open</p>
            <h4>The First AI-Native Generation</h4>
            <p class="sm mut">What sustained interaction with conversational AI does to cognition, identity, and agency.</p>
            <span class="go">Take part <Arrow /></span>
          </div>
        </a>
        <a class="ncard" href="/work/mantic">
          <div class="im"><Field v="sand" id="cn2" w={1200} h={675} /></div>
          <div class="bd">
            <p class="mono">Press</p>
            <h4>Mantic Publishing</h4>
            <p class="sm mut">The Center's press. Long-form arguments on the ideas changing what it means to be human.</p>
            <span class="go">Visit Mantic <Arrow /></span>
          </div>
        </a>
        <a class="ncard" href="/podcast">
          <div class="im"><Field v="grey-teal" id="cn3" w={1200} h={675} /></div>
          <div class="bd">
            <p class="mono">Public channel</p>
            <h4>The Ayush Prakash Podcast</h4>
            <p class="sm mut">Long-form conversations with researchers, critics, and builders.</p>
            <span class="go">Explore episodes <Arrow /></span>
          </div>
        </a>
      </div>
    </div>
  </section>
</Base>
