---
import Base from "../../../layouts/Base.astro";
import { ORG } from "../../../config";

const facts = [
  { k: "Date", v: "20 February 2025" },
  { k: "Venue", v: "Microsoft Reactor Toronto, CIBC Square, 81 Bay Street" },
  { k: "Host", v: "Aseem Prakash, Founder and Chair" },
  { k: "Program", v: "Co-existing with AI" },
];
---
<Base
  title="Coexisting with AI: Succeeding In the New Era"
  description="A Center for Innovating the Future event at Microsoft Reactor Toronto, February 2025, created and hosted by Aseem Prakash."
>
  <div class="wrap phead">
    <h1>Coexisting with AI: Succeeding In the New Era.</h1>
  </div>

  <section>
    <div class="wrap">
      <div class="reg">
        {facts.map((f) => (
          <div class="rg"><span class="lbl">{f.k}</span><span>{f.v}</span></div>
        ))}
      </div>
    </div>
  </section>

  {/* TODO Ayush: replace the two paragraphs below with the real session write-up. */}
  <section style="padding-top:0">
    <div class="wrap">
      <div class="shead"><h2>The session.</h2></div>
      <div class="body">
        <p>
          The Center brought the question it has worked on since 2010 to a room of people
          building with artificial intelligence: what changes for an organization, and for
          the people inside it, when the work starts being done alongside a machine rather
          than by a person alone.
        </p>
        <p>
          The session was created and hosted by Aseem Prakash at Microsoft Reactor Toronto.
        </p>
      </div>
      <p class="dnote">
        The event listing is on
        <a href="https://reactor.microsoft.com/en-us/reactor/events/24836/" target="_blank" rel="noopener noreferrer">Microsoft Reactor</a>.
        Requests for the material go to <a href={"mailto:" + ORG.email}>{ORG.email}</a>.
      </p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <a class="pill pill--ghost" href="/work/coexisting-with-ai">All of Co-existing with AI &rsaquo;</a>
    </div>
  </section>
</Base>
