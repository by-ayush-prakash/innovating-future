---
import Base from "../../../../layouts/Base.astro";

const voices = [
  { n: "01", h: "AI and machine-learning researchers", p: "What current AI can do, where it fails and what remains unresolved." },
  { n: "02", h: "Researchers of mind and behaviour", p: "What intelligence, consciousness and judgment mean for people and machines." },
  { n: "03", h: "Educators and learning researchers", p: "How AI affects learning, skill, attention and the ability to think for ourselves." },
  { n: "04", h: "Philosophers, ethicists and critics", p: "Which assumptions and values shape AI, and who bears the consequences." },
  { n: "05", h: "Policymakers and legal scholars", p: "Who makes the rules, who is accountable and how people’s rights are protected." },
  { n: "06", h: "Builders, founders and operators", p: "What changes when AI moves into products, workplaces and essential services." },
];

const archiveStages = [
  { n: "01", h: "Conversation", p: "Question-led, across episodes." },
  { n: "02", h: "Idea", p: "Agreement, difference and uncertainty." },
  { n: "03", h: "Context", p: "Transcript, timestamp and surrounding exchange." },
  { n: "04", h: "Access", p: "Open, correctable and current." },
];

---
<Base
  title="The Co-Existence Record"
  description="The Co-Existence Record is a living public record of source-linked conversations about AI from The Ayush Prakash Podcast."
  ctaHeading="Help make AI understandable."
  ctaBody="CIF is looking for partners and funders who want expert knowledge to reach the public. Support can help expand the archive, verify sources, improve accessibility and keep the Record free."
  ctaLabel="Partner with CIF"
  ctaHref="/contact"
  ctaField="dark-slate"
>
  <section class="report-hero" aria-labelledby="report-title">
    <h1 id="report-title">Explore how people co-exist with AI.</h1>

    <div class="report-art-stack" aria-label="Three views of artificial intelligence">
      <figure class="report-art report-art--left"><img src="/images/ai-everyday-use.jpg" alt="A person using an AI writing prompt on a phone" /></figure>
      <figure class="report-art report-art--center"><img src="/images/ai-brain-artwork.png" alt="A sculptural brain, the letters AI and a cursor on a tiled background" /></figure>
      <figure class="report-art report-art--right"><img src="/images/ai-light-field.jpg" alt="Blue illuminated lines suggesting a digital network" /></figure>
    </div>

    <a class="report-enter" href="/work/coexisting-with-ai/record/explore/" aria-label="Explore the Co-Existence Record">
      <span class="report-enter-label">Explore the Record</span>
      <span class="report-enter-arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="sec" id="goal">
    <div class="wrap">
      <div class="intro">
        <h3>Big questions about AI, made understandable.</h3>
        <div class="body">
          <p>Researchers, scientists, educators, philosophers, policymakers and builders have explored AI on <a class="podcast-link" href="/podcast">The Ayush Prakash Podcast</a>. Their ideas matter, but they are spread across long episodes and often expressed in specialist language.</p>
          <p>CIF is turning those conversations into a free, interactive public record. Start with a question, read a clear explanation, compare perspectives and follow any idea back to its source. No technical background or institutional access required.</p>
        </div>
      </div>
      <div class="goal-dedication">
        <div class="goal-dedication-header">
          <span>In memory of Aaron Swartz</span>
          <details class="report-aaron-note">
            <summary aria-label="About Aaron Swartz">i</summary>
            <div class="report-aaron-tooltip" role="tooltip"><b>Aaron Swartz · 1986–2013</b><p>Aaron Swartz was a programmer, writer and activist who fought to make knowledge freely accessible, and died by suicide while facing an aggressive federal prosecution over downloaded academic articles that his family condemned as intimidation and prosecutorial overreach.</p></div>
          </details>
        </div>
        <div class="goal-dedication-principles">
          <h4>Knowledge should be accessible to everyone.</h4>
          <p>Aaron Swartz’s belief that knowledge should be open shapes how this project is built. Institutions may help fund, host, or extend the work. Access remains public.</p>
          <ul aria-label="The project’s open-access commitments">
            <li><div><b>No paywall</b><p>No purchase or subscription.</p></div></li>
            <li><div><b>No institutional gate</b><p>No university, employer, funder, partner, or professional affiliation.</p></div></li>
            <li><div><b>No required email</b><p>No registration. Email is only for optional updates.</p></div></li>
            <li><div><b>Inspectable sources</b><p>Every explanation links to its transcript, timestamp, and context.</p></div></li>
            <li class="goal-dedication-critique"><div><b>Open to critique</b><p>CIF welcomes disagreement in public or private. Critiques grounded in clear reasoning and relevant evidence will be reviewed. Corrections will be made when warranted, and substantive changes will remain visible in the record.</p></div></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="voices">
    <div class="wrap">
      <div class="shead">
        <h3>Who is shaping how we live with AI?</h3>
        <p>The current source archive comes from <a class="podcast-link" href="/podcast">The Ayush Prakash Podcast</a>. Each guest adds a perspective to explore. Together, they do not represent everyone or measure public opinion.</p>
      </div>
      <div class="nums">
        {voices.map((v) => (
          <div class="nrow"><span class="n">{v.n}</span><h4>{v.h}</h4><p>{v.p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="method">
    <div class="wrap">
      <div class="shead"><h3>Begin with a question. Follow it to the source.</h3></div>
      <div class="archive-explorer" data-archive-explorer data-active="0">
        <div class="archive-tabs" role="tablist" aria-label="How the living source archive works">
          {archiveStages.map((stage, i) => (
            <button
              class={`archive-tab archive-tab--${i + 1}`}
              type="button"
              role="tab"
              id={`archive-tab-${i + 1}`}
              aria-controls={`archive-panel-${i + 1}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? "0" : "-1"}
              data-archive-tab={i}
            >
              <span class="archive-tab-number">{stage.n}</span>
              <span class="archive-tab-copy"><b>{stage.h}</b><small>{stage.p}</small></span>
            </button>
          ))}
        </div>

        <div class="archive-stage" aria-live="polite">
          <article class="archive-detail is-active" role="tabpanel" id="archive-panel-1" aria-labelledby="archive-tab-1" data-archive-panel="0">
            <h4>Start with a question.</h4>
            <div>
              <p>A published episode of <a class="podcast-link" href="/podcast">The Ayush Prakash Podcast</a> enters the source archive. Questions gather relevant passages across conversations, so you do not have to know which guest to search first.</p>
              <p>The archive reflects the guests currently included. It does not measure public opinion.</p>
            </div>
          </article>
          <article class="archive-detail" role="tabpanel" id="archive-panel-2" aria-labelledby="archive-tab-2" data-archive-panel="1" aria-hidden="true">
            <h4>Compare the answers.</h4>
            <div>
              <p>Each relevant passage stays connected to the speaker and timestamp. The Record shows where ideas meet, where definitions or priorities differ, and what remains unresolved.</p>
              <p>No single answer is presented as the required view.</p>
            </div>
          </article>
          <article class="archive-detail" role="tabpanel" id="archive-panel-3" aria-labelledby="archive-tab-3" data-archive-panel="2" aria-hidden="true">
            <h4>Open the source.</h4>
            <div>
              <p>Every explanation links back to the transcript, timestamp and surrounding exchange. Unverified claims and missing perspectives stay visible.</p>
              <p>The summary leads into the record and preserves the context needed to assess it.</p>
            </div>
          </article>
          <article class="archive-detail" role="tabpanel" id="archive-panel-4" aria-labelledby="archive-tab-4" data-archive-panel="3" aria-hidden="true">
            <h4>Keep the record current.</h4>
            <div>
              <p>Guests can request corrections, updates or removal of their transcript. New conversations and source changes appear in a dated change history.</p>
              <p>CIF compiles and provides access. It does not assign positions to guests or prescribe a position for the public. Read the material, compare perspectives and decide for yourself.</p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="sec report-updates" id="updates">
    <div class="wrap">
      <div class="updates-panel">
        <h3>Follow the Co-Existence Record as it grows.</h3>
        <div class="updates-body">
          <p>Leave your email to hear when new questions, sources, and perspectives are added to the Record. Signing up is optional and never affects access.</p>
          <form class="report-signup" name="coexistence-record-updates" method="POST" action="/work/coexisting-with-ai/record/?submitted=updates" data-netlify="true" data-netlify-honeypot="bot-field" data-report-signup>
            <input type="hidden" name="form-name" value="coexistence-record-updates" />
            <p class="report-honeypot" aria-hidden="true"><label>Do not fill this out<input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
            <label><span>Email address</span><input type="email" name="email" autocomplete="email" inputmode="email" placeholder="Email address" required /></label>
            <button type="submit">Notify me</button>
            <p data-report-signup-status aria-live="polite"></p>
          </form>
          <p class="updates-privacy">Updates are sent manually when the Record changes. Your email is used only for these updates, and you can request removal through CIF’s contact page.</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .report-hero{box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:calc(100svh - 92px);padding:clamp(72px,8vh,104px) var(--pad) clamp(60px,7vh,90px);overflow:hidden;background:#fff;color:#171719;text-align:center}
    .report-art-stack{position:relative;flex:0 0 auto;width:min(760px,78vw);height:auto;aspect-ratio:1.86;margin-bottom:clamp(72px,8vh,104px)}
    .report-art{position:absolute;display:block;height:auto;overflow:hidden;border:8px solid #fff;border-radius:28px;background:#ead9aa;box-shadow:0 16px 40px rgba(23,23,28,.14);animation:report-stack-in .86s cubic-bezier(.22,1,.36,1) both}
    .report-art img{display:block;width:100%;height:100%;object-fit:cover}
    .report-art--left{z-index:1;top:25%;left:2%;width:44%;aspect-ratio:1.12;transform:rotate(-10deg);animation-delay:.18s}
    .report-art--center{z-index:3;top:0;left:50%;width:45%;aspect-ratio:1.08;transform:translateX(-50%) rotate(-1deg);animation-delay:.28s}
    .report-art--center img{transform:scale(1.2)}
    .report-art--right{z-index:2;top:24%;right:1%;width:46%;aspect-ratio:1.12;transform:rotate(10deg);animation-delay:.38s}
    .report-hero h1{max-width:calc(100vw - (var(--pad) * 2));margin:0 0 clamp(48px,5.5vh,72px);color:#171719;font:500 clamp(54px,5.2vw,96px)/.92 var(--sans);letter-spacing:-.055em;white-space:nowrap;text-align:center;animation:report-copy-in .72s .04s cubic-bezier(.22,1,.36,1) both}
    .report-enter{position:relative;display:flex;align-items:center;justify-content:space-between;width:280px;min-height:58px;margin:0 auto;padding:0 22px 0 26px;border:1px solid transparent;border-radius:999px;background:linear-gradient(110deg,#171719 0%,#171719 22%,#5a3fbd 38%,#a92e1d 54%,#08756d 70%,#171719 86%,#171719 100%) padding-box,var(--grad) border-box;background-size:320% 100%,100% 100%;background-position:0 50%,0 0;color:#fff;font:600 15px var(--sans);text-decoration:none;box-shadow:0 12px 30px rgba(23,23,25,.12);transition:transform .2s ease,box-shadow .2s ease;animation:report-copy-in .72s .5s cubic-bezier(.22,1,.36,1) both,atlas-entry-colour 12s 1.22s ease-in-out infinite}.report-enter-arrow{font-size:20px;line-height:1;transition:transform .2s ease}.report-enter:hover{transform:translateY(-2px);box-shadow:0 16px 34px rgba(23,23,25,.17)}.report-enter:hover .report-enter-arrow{transform:translateX(4px)}.report-enter:focus-visible{outline:2px solid #171719;outline-offset:4px}
    .report-signup{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;width:100%;margin:28px 0 0;gap:10px}
    .report-signup label{display:flex;align-items:center;width:100%;min-height:48px;padding:0 21px;border:1px solid #b8b7bb;border-radius:999px;background:#fff;text-align:left;transition:border-color .2s ease,box-shadow .2s ease}.report-signup label:focus-within{border-color:#171719;box-shadow:0 0 0 3px rgba(23,23,25,.08)}.report-signup label>span{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    .report-signup input{width:100%;border:0;outline:0;background:transparent;color:#171719;font:400 13px var(--sans)}.report-signup input::placeholder{color:#67666b}
    .report-signup button{width:auto;min-width:118px;min-height:48px;padding:0 21px;border:1px solid #171719;border-radius:999px;background:#171719;color:#fff;font:500 13px var(--sans);cursor:pointer;transition:background .2s ease,transform .2s ease}.report-signup button:hover{background:#2b2a2e;transform:translateY(-2px)}.report-signup button:focus-visible{outline:2px solid #171719;outline-offset:3px}.report-signup button:disabled{cursor:wait;opacity:.55;transform:none}
    .report-signup>p{grid-column:1/-1;margin:2px 0 0;color:#5d5c61;font:500 11px/1.35 var(--sans);text-align:left}.report-signup>p:empty{display:none}.report-signup .report-honeypot{position:absolute;width:1px;height:1px;margin:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
    .report-aaron-note{position:relative}.report-aaron-note summary{display:grid;place-items:center;width:24px;height:24px;border:1px solid #aaa9ad;border-radius:50%;background:#fff;color:#252429;font:600 12px Georgia,serif;cursor:help;list-style:none}.report-aaron-note summary::-webkit-details-marker{display:none}
    .report-aaron-tooltip{position:absolute;z-index:20;left:calc(100% + 20px);top:50%;width:min(430px,calc(100vw - 36px));padding:20px 22px;border:1px solid #bebdc1;border-radius:20px;background:#fff;color:#252429;box-shadow:0 18px 48px rgba(23,23,25,.15);opacity:0;visibility:hidden;transform:translateY(calc(-50% + 8px));transition:opacity .18s ease,transform .18s ease,visibility .18s ease;text-align:left}.report-aaron-tooltip b{display:block;font:500 24px/1.15 var(--sans);letter-spacing:-.025em}.report-aaron-tooltip p{margin:10px 0 0;font:400 14px/1.55 var(--sans)}
    .report-aaron-note:hover .report-aaron-tooltip,.report-aaron-note:focus-within .report-aaron-tooltip,.report-aaron-note[open] .report-aaron-tooltip{opacity:1;visibility:visible;transform:translateY(-50%)}
    .goal-dedication .report-aaron-tooltip{right:auto;left:0;top:calc(100% + 14px);transform:translateY(8px)}.goal-dedication .report-aaron-note:hover .report-aaron-tooltip,.goal-dedication .report-aaron-note:focus-within .report-aaron-tooltip,.goal-dedication .report-aaron-note[open] .report-aaron-tooltip{transform:translateY(0)}
    @keyframes report-stack-in{from{opacity:0;transform:translateY(34px) rotate(0deg) scale(.92)}}
    @keyframes report-copy-in{from{transform:translateY(22px)}}
    .archive-explorer{--archive-active:#ffe1d8}
    .archive-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(12px,1.5vw,22px);margin-bottom:clamp(18px,2vw,28px)}
    .archive-tab{display:flex;flex-direction:column;min-width:0;min-height:250px;padding:22px;border:1px solid rgba(23,23,25,.1);border-radius:22px;color:#171719;font-family:var(--sans);text-align:left;cursor:pointer;appearance:none;transition:transform .2s ease,box-shadow .2s ease,filter .2s ease}
    .archive-tab--1{background:#ffe1d8}.archive-tab--2{background:#ffedb8}.archive-tab--3{background:#dcefd8}.archive-tab--4{background:#d7edf1}
    .archive-tab:hover,.archive-tab:focus-visible,.archive-tab[aria-selected="true"]{transform:translateY(-6px);box-shadow:0 18px 34px rgba(23,23,25,.1);filter:saturate(1.08)}.archive-tab:focus-visible{outline:2px solid #171719;outline-offset:3px}
    .archive-tab-number{display:grid;place-items:center;width:40px;height:40px;border:1px solid rgba(23,23,25,.35);border-radius:50%;background:rgba(255,255,255,.62);font:500 11px/1 var(--mono)}
    .archive-tab-copy{display:flex;flex-direction:column;gap:14px;margin-top:auto}.archive-tab-copy b{font:500 clamp(25px,2.3vw,32px)/1.08 var(--sans);letter-spacing:-.025em}.archive-tab-copy small{max-width:25ch;color:#35343a;font:400 14px/1.5 var(--sans)}
    .archive-stage{display:grid;overflow:hidden;border:1px solid rgba(23,23,25,.1);border-radius:28px;background:var(--archive-active);transition:background .2s ease}.archive-explorer[data-active="0"]{--archive-active:#ffe1d8}.archive-explorer[data-active="1"]{--archive-active:#ffedb8}.archive-explorer[data-active="2"]{--archive-active:#dcefd8}.archive-explorer[data-active="3"]{--archive-active:#d7edf1}
    .archive-detail{grid-area:1/1;display:grid;grid-template-columns:minmax(260px,.78fr) minmax(0,1.22fr);gap:clamp(42px,8vw,130px);align-items:center;min-height:330px;padding:clamp(36px,5vw,68px);opacity:0;visibility:hidden;transform:translateY(10px);transition:opacity .2s ease,transform .2s ease,visibility .2s ease}.archive-detail.is-active{opacity:1;visibility:visible;transform:translateY(0)}
    .archive-detail h4{max-width:10ch;margin:0;font:500 clamp(42px,4.4vw,66px)/.98 var(--sans);letter-spacing:-.045em}.archive-detail>div{max-width:660px}.archive-detail p{margin:0;color:#29282d;font-size:clamp(16px,1.3vw,19px);line-height:1.55}.archive-detail p+p{margin-top:22px}
    .intro .body p,.shead>p,.updates-body>p{color:var(--mut);font-size:18px;line-height:1.55}
    .shead>p{max-width:610px;margin:0}
    .goal-dedication{position:relative;margin-top:clamp(42px,5vw,72px);padding:clamp(32px,3.5vw,52px);overflow:visible;border:1px solid rgba(23,23,25,.55);border-radius:28px;background:#fff;color:#171719}.goal-dedication::before{content:"";position:absolute;top:-1px;left:26px;right:26px;height:6px;border-radius:0 0 6px 6px;background:var(--grad)}.goal-dedication-header{display:flex;align-items:center;gap:10px;margin-bottom:clamp(24px,2.5vw,34px);font:600 clamp(14px,1.1vw,16px)/1.2 var(--sans)}.goal-dedication-principles h4{max-width:30ch;margin:0;font:500 clamp(34px,3.5vw,54px)/1.01 var(--sans);letter-spacing:-.04em}.goal-dedication-principles>p{max-width:76ch;margin:18px 0 0;font:400 clamp(16px,1.3vw,19px)/1.5 var(--sans)}
    .goal-dedication-principles ul{counter-reset:commitment;margin:clamp(28px,3vw,40px) 0 0;padding:0;border-top:1px solid rgba(23,23,25,.35);list-style:none}
    .goal-dedication-principles li{counter-increment:commitment;display:grid;grid-template-columns:40px minmax(0,1fr);align-items:start;gap:0;padding:20px 0;border-bottom:1px solid rgba(23,23,25,.25);font-family:var(--sans)}.goal-dedication-principles li:last-child{border-bottom:0}.goal-dedication-principles li::before{content:"0" counter(commitment);margin-top:5px;color:#77767c;font:500 10px/1 var(--mono)}
    .goal-dedication-principles li>div{display:grid;grid-template-columns:minmax(180px,.36fr) minmax(0,1fr);gap:clamp(28px,5vw,80px);align-items:start}.goal-dedication-principles li b{display:block;font-size:clamp(14px,1.15vw,17px);font-weight:600;line-height:1.25}.goal-dedication-principles li p{max-width:88ch;margin:0;color:#515056;font-size:13px;line-height:1.45}
    #voices{padding-bottom:0}#voices .nrow:last-child{border-bottom:0}
    .report-updates{padding:0}.updates-panel{display:grid;grid-template-columns:minmax(240px,.7fr) minmax(0,1fr);gap:clamp(48px,9vw,150px);align-items:start;padding:clamp(48px,6vw,82px) 0;border-top:1px solid var(--hair)}.updates-panel h3{margin:0}.updates-body{width:100%;max-width:760px}.updates-body>p{width:100%;max-width:64ch;margin:4px 0 0}.updates-body>.updates-privacy{margin-top:14px;color:#67666b;font:400 12px/1.45 var(--sans)}
    @media(max-height:780px) and (min-width:721px){.report-hero{padding-top:34px;padding-bottom:28px}.report-art-stack{width:480px;margin-bottom:48px}.report-hero h1{margin-bottom:28px;font-size:54px}.report-enter{min-height:50px}}
    @media(max-width:900px){.report-hero h1{max-width:14ch;white-space:normal}.archive-tabs{grid-template-columns:repeat(2,1fr)}.archive-tab{min-height:210px}.archive-detail{grid-template-columns:1fr;gap:30px}.archive-detail h4{max-width:13ch}.updates-panel{grid-template-columns:1fr}.updates-panel{gap:32px}.goal-dedication .report-aaron-tooltip{right:0;left:auto;top:calc(100% + 14px);transform:translateY(8px)}.goal-dedication .report-aaron-note:hover .report-aaron-tooltip,.goal-dedication .report-aaron-note:focus-within .report-aaron-tooltip,.goal-dedication .report-aaron-note[open] .report-aaron-tooltip{transform:translateY(0)}}
    @media(max-width:720px){.report-hero{min-height:calc(100svh - 72px);padding:58px 16px 46px}.report-hero h1{max-width:12ch;margin-bottom:40px;font-size:clamp(42px,12vw,56px)}.report-art-stack{width:min(430px,94vw);margin-bottom:52px}.report-enter{width:min(280px,100%)}.report-signup{grid-template-columns:1fr}.report-signup button{width:100%}}
    @media(max-width:620px){.archive-tabs{gap:10px}.archive-tab{min-height:180px;padding:17px;border-radius:18px}.archive-tab-copy{gap:10px}.archive-tab-copy b{font-size:22px}.archive-tab-copy small{font-size:12px}.archive-detail{min-height:390px;padding:30px 24px}.archive-detail h4{font-size:40px}.goal-dedication{padding:28px 22px;border-radius:22px}.goal-dedication::before{left:20px;right:20px}.goal-dedication-header{margin-bottom:22px}.goal-dedication-principles h4{font-size:clamp(32px,9vw,42px)}.goal-dedication-principles ul{margin-top:26px}.goal-dedication-principles li{grid-template-columns:34px minmax(0,1fr);padding:16px 0}.goal-dedication-principles li>div{grid-template-columns:1fr;gap:8px}.goal-dedication .report-aaron-tooltip{right:0;left:auto}}
    @media(prefers-reduced-motion:reduce){.report-art,.report-hero h1,.report-enter{animation:none!important}}
  </style>

  <script>
    const signup = document.querySelector<HTMLFormElement>('[data-report-signup]');
    const signupStatus = document.querySelector<HTMLElement>('[data-report-signup-status]');
    signup?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = new FormData(signup).get('email')?.toString().trim();
      if (!email) {
        signup.querySelector<HTMLInputElement>('input[type="email"]')?.focus();
        return;
      }
      const submit = signup.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) submit.disabled = true;
      if (signupStatus) signupStatus.textContent = '';
      try {
        if (!['localhost', '127.0.0.1'].includes(location.hostname)) {
          const response = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ 'form-name': 'coexistence-record-updates', email }).toString() });
          if (!response.ok) throw new Error('Subscription failed');
          signup.reset();
          if (signupStatus) signupStatus.textContent = 'You’re subscribed.';
        } else if (signupStatus) {
          signupStatus.textContent = 'Subscription will activate on the published site.';
        }
      } catch {
        if (signupStatus) signupStatus.textContent = 'Something went wrong. Please try again.';
      } finally {
        if (submit) submit.disabled = false;
      }
    });

    const aaronNotes = document.querySelectorAll<HTMLDetailsElement>('.report-aaron-note');
    document.addEventListener('pointerdown', (event) => {
      aaronNotes.forEach((note) => {
        if (!note.contains(event.target as Node)) note.open = false;
      });
    });

    const archiveExplorer = document.querySelector<HTMLElement>('[data-archive-explorer]');
    const archiveTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-archive-tab]'));
    const archivePanels = Array.from(document.querySelectorAll<HTMLElement>('[data-archive-panel]'));
    const activateArchiveStage = (index: number, moveFocus = false) => {
      if (!archiveExplorer || !archiveTabs[index] || !archivePanels[index]) return;
      archiveExplorer.dataset.active = String(index);
      archiveTabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      archivePanels.forEach((panel, panelIndex) => {
        const active = panelIndex === index;
        panel.classList.toggle('is-active', active);
        panel.setAttribute('aria-hidden', String(!active));
      });
      if (moveFocus) archiveTabs[index].focus();
    };

    archiveTabs.forEach((tab, index) => {
      tab.addEventListener('pointerenter', () => activateArchiveStage(index));
      tab.addEventListener('focus', () => activateArchiveStage(index));
      tab.addEventListener('click', () => activateArchiveStage(index));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === 'Home'
          ? 0
          : event.key === 'End'
            ? archiveTabs.length - 1
            : (index + (event.key === 'ArrowRight' ? 1 : -1) + archiveTabs.length) % archiveTabs.length;
        activateArchiveStage(nextIndex, true);
      });
    });
  </script>
</Base>
