      .gate h1{width:min(11ch,100%);font-size:clamp(39px,11vw,52px)}
      .gate h1>span{display:inline;width:auto}
      .gate-kicker{max-width:34ch;margin-bottom:16px}
      .prototype[data-mode] .gate-enter{width:min(260px,100%)}
      .gate-form{grid-template-columns:1fr;width:100%;margin-top:28px}
      .gate-subscribe{width:100%}
      .prototype .gate-return.site-exit{top:20px;left:20px}
    }
    @media(max-width:420px){
      .gate-stage{padding:58px 15px 18px}
      .gate-art-stack{margin-bottom:22px}
      .gate-art-stack .gate-media--artwork{border-width:6px;border-radius:20px}
      .gate h1{font-size:clamp(36px,10.5vw,46px)}
      .gate-form{margin-top:24px;gap:10px}
      .gate-form label{min-height:42px}
      .gate-dedication{margin-top:12px}
    }
    @media(prefers-reduced-motion:reduce){
      .gate-art-stack .gate-media--artwork{animation:none!important;opacity:1!important}
    }

    /* Atlas workspace ------------------------------------------------------
       One restrained editorial system replaces the inherited solarpunk skin.
       Colour now signals meaning or interaction instead of decorating panels. */
    :global(body){background:#fff}
    .prototype{
      --atlas-ink:#111111;
      --atlas-muted:#67635c;
      --atlas-line:#c9c3b8;
      --atlas-soft:#f7f2e8;
      --atlas-red:#d83a2e;
      --atlas-blue:#2f6db5;
      --atlas-yellow:#f2c230;
      --atlas-amber:var(--atlas-yellow);
      --atlas-teal:var(--atlas-blue);
      --atlas-grad:linear-gradient(90deg,var(--atlas-red) 0 33.333%,var(--atlas-blue) 33.333% 66.666%,var(--atlas-yellow) 66.666% 100%);
      color:var(--atlas-ink);
      background:#fff;
      font-family:var(--sans);
    }
    .workspace{
      position:relative;
      height:100dvh;
      display:grid;
      grid-template-rows:68px minmax(0,1fr);
      background:#fff!important;
      color:var(--atlas-ink);
    }
    .eco-app-scene{display:none!important}
    .workspace>*:not(.eco-app-scene){position:relative;z-index:1}
    .workspace>.topbar{
      z-index:100;
      box-sizing:border-box;
      display:grid;
      grid-template-columns:minmax(280px,1fr) auto auto;
      align-items:center;
      gap:18px;
      height:68px;
      min-height:68px;
      padding:0 20px 0 180px;
      overflow:visible;
      border:0;
      border-bottom:1px solid var(--atlas-line);
      background:rgba(255,255,255,.94)!important;
      box-shadow:none!important;
      backdrop-filter:blur(18px);
    }
    .workspace>.app-return,
    .prototype .site-exit.app-return{
      position:fixed;
      z-index:120;
      top:14px;
      left:18px;
      display:inline-flex;
      align-items:center;
      gap:8px;
      width:max-content;
      height:40px;
      padding:0 14px;
      border:1px solid var(--atlas-ink);
      border-radius:999px;
      background:#fff;
      color:var(--atlas-ink);
      box-shadow:none;
      font:500 12px var(--sans);
      backdrop-filter:none;
    }
    .prototype .site-exit.app-return:hover{background:var(--atlas-ink);color:#fff}
    .search-shell{position:relative;min-width:0}
    .global-search{
      display:flex;
      align-items:center;
      gap:10px;
      max-width:760px;
      margin:0;
      padding:0 16px;
      border:1px solid var(--atlas-line);
      border-radius:999px;
      background:#fff;
      box-shadow:none;
    }
    .global-search svg{width:16px;stroke:var(--atlas-muted)}
    .global-search input{height:40px;color:var(--atlas-ink);font:400 13px var(--sans)}
    .global-search input::placeholder{color:#8b8a90}
    .edition{
      display:grid;
      grid-template-columns:8px auto;
      column-gap:9px;
      align-items:center;
      padding:0;
      white-space:nowrap;
    }
    .edition>span{
      grid-row:1/3;
      width:7px;
      height:7px;
      border:0;
      border-radius:50%;
      background:var(--atlas-amber);
      box-shadow:none;
    }
    .edition b{color:var(--atlas-ink);font:500 10px var(--mono)}
    .edition small{color:var(--atlas-muted);font-size:10px}
    .question-bar{display:flex;justify-content:flex-end}
    .compare-launch,
    .topbar .compare-launch{
      min-height:40px;
      padding:0 15px;
      border:1px solid var(--atlas-ink);
      border-radius:999px;
      background:var(--atlas-ink);
      color:#fff;
      box-shadow:none;
      font:500 11px var(--sans);
    }
    .compare-launch:hover,.compare-launch.active{transform:translateY(-1px);background:#303034}
    .workspace>.control-peek{
      position:fixed;
      z-index:120;
      top:14px;
      right:16px;
      min-height:40px;
      padding:0 14px;
      border:1px solid var(--atlas-ink);
      border-radius:999px;
      background:#fff;
      color:var(--atlas-ink);
      box-shadow:none;
      font:500 11px var(--sans);
    }
    .workspace .global-search{
      border:1px solid var(--atlas-line);
      border-radius:999px;
      box-shadow:none;
    }
    .search-results{
      top:calc(100% + 10px);
      left:0;
      right:0;
      padding:8px;
      border:1px solid var(--atlas-line);
      border-radius:18px;
      background:#fff;
      box-shadow:0 20px 60px rgba(0,0,0,.12);
    }
    .search-results button{border-bottom-color:var(--atlas-line);color:var(--atlas-ink);font-family:var(--sans)}
    .search-results button:hover,.search-results button:focus-visible{border-radius:10px;background:var(--atlas-soft)}
    .search-results small{color:var(--atlas-red)}
    .search-results span,.search-results>p{color:var(--atlas-muted)}

    .workgrid{
      z-index:1!important;
      min-height:0;
      display:grid;
      grid-template-columns:minmax(0,1fr);
      grid-template-rows:minmax(0,1fr);
    }
    .evidence-canvas{
      min-width:0;
      min-height:0;
      overflow:auto;
      background:#fff!important;
      background-image:none!important;
      backdrop-filter:none;
    }
    .question-heading-selector{
      z-index:20;
      box-sizing:border-box;
      width:min(1320px,100%);
      max-width:none;
      margin:0 auto;
      padding:38px clamp(24px,5vw,76px) 10px;
    }
    .question-heading-selector>.current-question{
      position:relative;
      z-index:2;
      display:grid;
      grid-template-columns:minmax(0,1fr) auto;
      gap:26px;
      align-items:end;
      width:100%;
      padding:0 0 28px;
      overflow:visible;
      border:0;
      border-bottom:3px solid transparent;
      border-radius:0!important;
      background:linear-gradient(#fff,#fff) padding-box,var(--atlas-grad) border-box!important;
      box-shadow:none!important;
      color:var(--atlas-ink);
      text-align:left;
    }
    .question-heading-selector>.current-question>b{
      overflow:visible;
      color:var(--atlas-ink);
      font:400 clamp(42px,4.8vw,66px)/.98 var(--sans);
      letter-spacing:-.045em;
      white-space:normal;
      text-overflow:clip;
    }
    .question-heading-selector>.current-question>em{
      display:flex;
      align-items:center;
      gap:10px;
      width:auto;
      height:42px;
      min-height:42px;
      margin:0;
      padding:0 15px;
      border:1px solid var(--atlas-ink);
      border-radius:999px;
      background:#fff!important;
      box-shadow:none!important;
      color:var(--atlas-ink);
      font:500 11px var(--sans);
    }
    .question-heading-selector>.current-question>em span{font:500 11px var(--sans)}
    .question-heading-selector>.current-question>em i{font:500 15px var(--sans)}
    .question-heading-selector>.current-question:hover>em{transform:translateY(-2px);background:var(--atlas-soft)!important}
    .question-heading-selector>.current-question[aria-expanded="true"]>em{transform:none;background:var(--atlas-ink)!important;color:#fff}
    .question-heading-selector>.question-panel{
      top:calc(100% + 8px);
      left:auto;
      right:clamp(24px,5vw,76px);
      box-sizing:border-box;
      width:min(900px,calc(100% - 48px));
      padding:24px;
      overflow:hidden;
      border:1px solid var(--atlas-line);
      border-radius:22px;
      box-shadow:0 26px 80px rgba(0,0,0,.14);
      backdrop-filter:none;
    }
    .question-heading-selector>.question-panel .rail-head{padding:0 0 20px}
    .question-heading-selector>.question-panel .rail-head p{max-width:none;font:400 26px/1.05 var(--sans)}
    .question-heading-selector>.question-panel .rail-head small{color:var(--atlas-muted);font:400 12px/1.45 var(--sans)}
    .question-heading-selector>.question-panel nav{gap:10px;margin-top:18px}
    .question-heading-selector>.question-panel .question-tab,
    .question-heading-selector>.question-panel .question-tab:nth-child(n){
      min-height:142px;
      padding:18px;
      border:1px solid var(--atlas-line);
      border-radius:16px;
      color:var(--atlas-ink);
    }
    .question-heading-selector>.question-panel .question-tab:hover{transform:translateY(-3px);border-color:#aaa9ae;box-shadow:0 12px 28px rgba(0,0,0,.07)}
    .question-heading-selector>.question-panel .question-tab.active{border-color:var(--atlas-ink);box-shadow:none}
    .question-heading-selector>.question-panel .question-tab>span{
      width:28px;
      height:28px;
      border:1px solid currentColor;
      color:var(--atlas-red);
      font:500 9px var(--mono);
    }
    .question-heading-selector>.question-panel .question-tab b{font:400 19px/1.15 var(--sans)}
    .question-heading-selector>.question-panel .question-tab small{color:var(--atlas-muted);font:500 9px var(--mono)}

    .question-view,.comparison-view{
      box-sizing:border-box;
      width:min(1320px,100%);
      max-width:none;
      margin:0 auto;
      padding:20px clamp(24px,5vw,76px) 100px;
    }
    .synthesis{
      position:relative;
      grid-template-columns:minmax(0,1.5fr) minmax(300px,.5fr);
      margin-top:0;
      padding:0;
      overflow:hidden;
      border:1px solid var(--atlas-line);
      border-radius:24px;
      box-shadow:0 12px 38px rgba(0,0,0,.045);
      color:var(--atlas-ink);
      transform:none;
    }
    .synthesis:before{content:"";position:absolute;height:4px;background:var(--atlas-grad)}
    .synthesis-label{padding:24px 28px 0;color:var(--atlas-muted);font:500 9px var(--mono)}
    .synthesis-label>span{background:var(--atlas-amber)}
    .synthesis-label b{margin-left:auto;padding:5px 9px;border:1px solid var(--atlas-line);border-radius:999px;background:#fff;color:var(--atlas-ink)}
    .synthesis-answer{margin:0!important;padding:24px 28px 28px!important;color:var(--atlas-ink);font:400 clamp(21px,1.8vw,27px)/1.34 var(--sans)!important}
    .orientation-notes{grid-column:2;grid-row:1/3;border-left:1px solid var(--atlas-line)}
    .orientation-notes article,.orientation-notes article+article{padding:22px 24px;background:var(--atlas-soft)!important}
    .orientation-notes article+article{border-top:1px solid var(--atlas-line)}
    .orientation-notes small{color:var(--atlas-muted);font:500 9px var(--mono)}
    .orientation-notes p{color:var(--atlas-ink);font:400 13px/1.5 var(--sans)}
    .synthesis footer{grid-column:1/-1;grid-row:3;margin:0 28px;padding:14px 0 17px;border-top:1px solid var(--atlas-line);color:var(--atlas-muted);font-size:11px}
    .synthesis footer button{border:0;border-bottom:1px solid var(--atlas-ink);background:none;color:var(--atlas-ink);font-weight:500}

    .map{margin-top:64px}
    .map>header{display:block;padding-bottom:17px;border-bottom:1px solid var(--atlas-line)}
    .map>header span{color:var(--atlas-ink);font:400 clamp(29px,3vw,40px)/1.05 var(--sans)}
    .map>header small{margin-top:8px;font-size:13px}
    .lanes{grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:18px}
    .lanes:before{display:none}
    .lane,.lane--agreement,.lane--disagreement,.lane--uncertainty{
      grid-column:auto;
      min-height:260px;
      margin:0;
      padding:12px;
      border:1px solid var(--atlas-line);
      border-radius:18px;
      background:var(--atlas-soft);
      box-shadow:none;
      transform:none;
    }
    .lane-name{padding:7px 6px 15px}
    .lane-name b{color:var(--atlas-ink);font:500 12px var(--sans)}
    .lane--agreement .lane-name i{background:var(--atlas-teal)}
    .lane--disagreement .lane-name i{background:var(--atlas-red)}
    .lane--uncertainty .lane-name i{background:var(--atlas-amber)}
    .evidence-card{
      padding:17px;
      border:1px solid var(--atlas-line);
      border-radius:14px;
      background:#fff;
      box-shadow:none;
      color:var(--atlas-ink);
      transition:transform .24s cubic-bezier(.22,1,.36,1),border-color .24s ease,box-shadow .24s ease;
    }
    .evidence-card:hover,.evidence-card.selected{
      transform:translateY(-3px);
      border-color:#aaa9ae;
      box-shadow:0 12px 26px rgba(0,0,0,.07);
    }
    .evidence-card.selected{border-color:var(--atlas-ink)}
    .evidence-card small{color:var(--atlas-muted)}
    .evidence-card>p{color:var(--atlas-ink);font-size:14px;font-weight:400}
    .evidence-card>div b{color:var(--atlas-red)}

    .reasoning-path{
      margin-top:72px;
      padding:52px 0 0;
      border-radius:0;
      box-shadow:none;
    }
    .reasoning-path h2{color:var(--atlas-ink);font:400 clamp(36px,4vw,54px)/1 var(--sans)}
    .reasoning-path>header p{color:var(--atlas-muted);font:400 14px/1.5 var(--sans)}
    .reasoning-steps{gap:12px;margin-top:28px}
    .reasoning-steps>button{
      min-height:160px;
      border:1px solid var(--atlas-line);
      border-radius:16px;
      box-shadow:none;
      color:var(--atlas-ink);
    }
    .reasoning-steps>button:hover,.reasoning-steps>button.active{
      transform:translateY(-3px);
      border-color:#aaa9ae;
      background:var(--atlas-soft)!important;
      box-shadow:0 12px 28px rgba(0,0,0,.06);
    }
    .reasoning-steps>button>span{color:var(--atlas-red);font:500 10px var(--mono)}
    .reasoning-steps small{color:var(--atlas-muted);font:500 9px var(--mono)}
    .reasoning-steps b{font:500 15px/1.35 var(--sans)}
    .reasoning-decision{gap:12px}
    .reasoning-decision>article,.reasoning-decision>article:first-child,.stance-builder{
      padding:26px;
      border:1px solid var(--atlas-line);
      border-radius:16px;
      background:var(--atlas-soft);
      box-shadow:none;
    }
    .reasoning-decision small{color:var(--atlas-muted);font:500 9px var(--mono)}
    .reasoning-decision h3{font:400 27px/1.1 var(--sans)}
    .reasoning-decision article>p{font-weight:400}
    .stance-builder button{
      padding:9px 12px;
      border:1px solid var(--atlas-line);
      border-radius:999px;
      background:#fff;
      color:var(--atlas-ink);
      box-shadow:none;
      font-weight:500;
    }
    .stance-builder button:hover,.stance-builder button.selected{transform:none;border-color:var(--atlas-ink);background:var(--atlas-ink);box-shadow:none;color:#fff}
    .own-question{
      padding:18px 0;
      border:0;
      border-bottom:1px solid var(--atlas-line);
      border-radius:0;
    }
    .own-question input{border-bottom:1px solid var(--atlas-line);color:var(--atlas-ink);font:400 14px var(--sans)}

    .inquiry-trail{
      position:relative;
      margin-top:42px;
      padding:clamp(32px,4vw,54px);
      border:1px solid var(--atlas-line);
      border-radius:26px;
      background:linear-gradient(145deg,#fff 0 62%,#f4f1ec 100%);
      box-shadow:none;
      overflow:hidden;
    }
    .inquiry-trail:before{content:"";position:absolute;inset:0 0 auto;height:5px;background:linear-gradient(90deg,var(--atlas-red),var(--atlas-amber),var(--atlas-teal))}
    .inquiry-trail small{color:var(--atlas-muted);font:500 10px var(--mono);letter-spacing:.06em}
    .inquiry-trail>header{gap:40px}
    .inquiry-trail>header h3{margin:8px 0 0;color:var(--atlas-ink);font:400 clamp(42px,4.2vw,64px)/.98 var(--sans)}
    .inquiry-trail>header p{margin-top:14px;color:var(--atlas-muted);font-size:16px;line-height:1.45}
    .trail-progress{display:grid;gap:10px;min-width:210px;padding-bottom:5px;text-align:right}
    .trail-progress b{font:600 13px var(--sans)}
    .trail-progress>span{display:block;width:100%;height:7px;overflow:hidden;background:#e3e2df}
    .trail-progress i{display:block;width:0;height:100%;border-radius:999px;background:var(--atlas-red);transition:width .3s ease}
    .trail-states{display:grid;grid-template-columns:minmax(0,1fr) 64px minmax(0,1fr);gap:14px;align-items:stretch;margin-top:38px}
    .trail-states article,.trail-next,.trail-card{
      border:1px solid var(--atlas-line);
      border-radius:16px;
      background:#fff;
    }
    .trail-states .trail-state{display:flex;flex-direction:column;justify-content:space-between;min-height:148px;padding:24px}
    .trail-states .trail-state strong{margin-top:28px;overflow:visible;text-overflow:clip;color:var(--atlas-ink);font:500 clamp(20px,2vw,27px)/1.12 var(--sans);white-space:normal;letter-spacing:-.025em}
    .trail-state--current{border:2px solid var(--atlas-ink)!important;background:#fff8e8!important}
    .trail-shift{display:grid;place-items:center;color:var(--atlas-red);font:300 36px var(--sans)}
    .trail-states .trail-state--opened{grid-column:1/-1;display:grid;grid-template-columns:220px minmax(0,1fr);align-items:center;min-height:0;padding:20px 24px;background:var(--atlas-soft)}
    .trail-states .trail-state--opened strong{margin:0;font-size:18px;line-height:1.35}
    .trail-next{padding:24px;background:var(--atlas-ink)}
    .trail-next small{color:#bdbbc0}
    .trail-next p{max-width:70ch;margin-top:6px;font-size:18px;line-height:1.35}
    .trail-next button,.inquiry-trail>footer>button,.public-actions button,.comparison-head>button{
      padding:10px 14px;
      border:1px solid var(--atlas-ink);
      border-radius:999px;
      background:var(--atlas-ink);
      box-shadow:none;
      color:#fff;
      font:500 12px var(--sans);
    }
    .trail-next button{background:#fff;color:var(--atlas-ink)}
    .trail-next button:hover,.inquiry-trail>footer>button:hover,.public-actions button:hover,.comparison-head>button:hover{transform:translateY(-2px);box-shadow:none}
    .inquiry-trail>footer{margin-top:18px}
    .trail-card b{font:500 17px/1.15 var(--sans)}
    .trail-card span{color:var(--atlas-muted)}

    .revision-story{
      grid-template-columns:minmax(0,1fr) minmax(300px,.7fr);
      margin-top:24px;
      padding:30px;
      border:0;
      border-radius:20px;
      background:var(--atlas-soft);
      box-shadow:none;
    }
    .revision-story h2{font:400 clamp(28px,3vw,40px)/1.05 var(--sans)}
    .revision-story>div>p{color:var(--atlas-muted);font-size:14px}
    .revision-story li>span{border:1px solid var(--atlas-ink);background:#fff}
    .revision-story li.current>span{background:var(--atlas-amber)}
    .revision-story li:not(:last-child)>span:after{left:5px;width:1px;background:var(--atlas-line)}
    .revision-story small{color:var(--atlas-muted);font-weight:500}

    .public-actions{gap:12px;margin-top:24px}
    .public-actions>article,.suggest-action,.follow-action{
      padding:28px;
      border:1px solid var(--atlas-line);
      border-radius:20px;
      background:#fff;
      box-shadow:none;
    }
    .public-actions small{color:var(--atlas-muted);font:500 9px var(--mono)}
    .public-actions h2{font:400 31px/1.05 var(--sans)}
    .public-actions p{color:var(--atlas-muted)}
    .public-actions input{
      padding:12px 14px;
      border:1px solid var(--atlas-line);
      border-radius:999px;
      background:#fff;
      color:var(--atlas-ink);
      font:400 13px var(--sans);
    }

    .inspector{
      position:fixed;
      z-index:130;
      top:68px;
      right:0;
      bottom:0;
      width:min(420px,100%);
      overflow:auto;
      border-left:1px solid var(--atlas-line);
      background:#fff;
      box-shadow:-24px 0 70px rgba(0,0,0,.1);
      color:var(--atlas-ink);
      transform:translateX(100%);
      transition:transform .36s cubic-bezier(.22,1,.36,1);
    }
    .nav-collapsed .inspector{top:0}
    .provisional{color:var(--atlas-muted)}
    .inspector-tabs{border-color:var(--atlas-line)}
    .inspector-tabs button{color:var(--atlas-muted)}
    .inspector-tabs button.active{border-color:var(--atlas-red);color:var(--atlas-ink)}
    .challenge-panel>p{color:var(--atlas-red)}
    .challenge-panel h2{font:400 31px/1.08 var(--sans)}
    .challenge-panel>span,.challenge-panel label,.challenge-panel>small{color:var(--atlas-muted)}
    .challenge-panel select,.challenge-panel textarea{border-color:var(--atlas-line);border-radius:12px;background:#fff;color:var(--atlas-ink)}
    .challenge-panel>button{background:var(--atlas-ink);color:#fff}

    .comparison-head h1{color:var(--atlas-ink);font:400 clamp(42px,5vw,68px)/.98 var(--sans)}
    .comparison-head>div>span{color:var(--atlas-muted)}
    .person-pickers{gap:14px}
    .person-picker>[data-person-toggle],
    .person-picker--a>[data-person-toggle],
    .person-picker--b>[data-person-toggle]{
      min-height:82px;
      padding:14px 18px;
      border:1px solid var(--atlas-line);
      border-radius:16px;
      background:#fff;
      box-shadow:none;
      color:var(--atlas-ink);
    }
    .person-picker>[aria-expanded="true"]{transform:none;border-color:var(--atlas-ink);background:var(--atlas-soft)}
    .person-role i,.person-picker--b .person-role i{border:1px solid var(--atlas-ink);border-radius:50%;background:#fff;color:var(--atlas-ink);transform:none}
    .person-role small{color:var(--atlas-muted);font:500 9px var(--mono)}
    .person-picker>[data-person-toggle] b{font:500 20px var(--sans)}
    .person-chevron{border:1px solid var(--atlas-line);border-radius:50%;background:#fff}
    .versus{color:var(--atlas-muted)}
    .versus b{border:1px solid var(--atlas-line);border-radius:50%;background:#fff;box-shadow:none}
    .person-menu{padding:8px;border:1px solid var(--atlas-line);border-radius:16px;box-shadow:0 18px 50px rgba(0,0,0,.12)}
    .person-menu button{color:var(--atlas-ink);font-weight:500}
    .person-menu button>span{display:grid;gap:2px}.person-menu button>span>b{font:600 14px var(--sans)}.person-menu button>span>small{font:500 11px/1.25 var(--sans);color:var(--atlas-muted)}
    .person-menu button:hover,.person-menu button:focus-visible,.person-picker--a .person-menu button.active,.person-picker--b .person-menu button.active{background:var(--atlas-soft)}
    .comparison-rows{gap:12px}
    .comparison-row{
      grid-template-columns:190px 1fr 1fr;
      border:1px solid var(--atlas-line);
      border-radius:18px;
      box-shadow:none;
    }
    .comparison-row>header{border-color:var(--atlas-line)}
    .comparison-row>header span{color:var(--atlas-red)}
    .comparison-row>header h2{font:500 20px/1.15 var(--sans)}
    .comparison-side--a{border-color:var(--atlas-line)}
    .position-card,.comparison-side--b .position-card{
      border:1px solid var(--atlas-line);
      border-radius:13px;
      background:var(--atlas-soft);
    }
    .position-card>small{color:var(--atlas-muted)}
    .position-card footer a{color:var(--atlas-ink)}
    .no-position{border-color:var(--atlas-line);border-radius:13px;color:var(--atlas-muted)}

    .workspace:not([hidden]) .question-heading-selector{animation:atlas-rise .7s .06s both cubic-bezier(.22,1,.36,1)}
    .workspace:not([hidden]) .synthesis{animation:atlas-rise .7s .14s both cubic-bezier(.22,1,.36,1)}
    .workspace:not([hidden]) .map{animation:atlas-rise .7s .22s both cubic-bezier(.22,1,.36,1)}
    @keyframes atlas-rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}

    @media(max-width:900px){
      .workspace>.topbar{grid-template-columns:minmax(0,1fr) auto;padding-left:164px;gap:10px}
      .global-search{display:flex}
      .edition{display:none}
      .synthesis{grid-template-columns:1fr}
      .synthesis-answer,.orientation-notes{grid-column:1}
      .orientation-notes{grid-row:auto;grid-template-columns:1fr 1fr;border-left:0;border-top:1px solid var(--atlas-line)}
      .orientation-notes article+article{border-top:0;border-left:1px solid var(--atlas-line)}
      .lanes{grid-template-columns:1fr}
      .reasoning-steps,.reasoning-decision,.revision-story{grid-template-columns:1fr}
      .comparison-row{grid-template-columns:1fr}
      .comparison-row>header,.comparison-side--a{border-right:0;border-bottom:1px solid var(--atlas-line)}
    }
    @media(max-width:720px){
      .workspace{grid-template-rows:62px minmax(0,1fr)}
      .workspace>.topbar{height:62px;min-height:62px;padding:0 10px 0 132px;grid-template-columns:minmax(0,1fr) auto}
      .workspace>.app-return,.prototype .site-exit.app-return{top:12px;left:10px;height:38px;padding:0 11px}
      .global-search{margin:0;padding:0 12px}
      .global-search input{height:38px;font-size:12px}
      .question-bar{padding:0}
      .topbar .compare-launch{width:40px;padding:0;font-size:0}
      .topbar .compare-launch span{font-size:14px}
      .question-heading-selector{padding:30px 18px 10px}
      .question-heading-selector>.current-question{grid-template-columns:1fr;padding-bottom:22px}
      .question-heading-selector>.current-question>b{font-size:clamp(38px,11vw,52px)}
      .question-heading-selector>.current-question>em{justify-self:start;height:38px;min-height:38px}
      .question-heading-selector>.question-panel{left:14px;right:14px;width:auto;padding:18px}
      .question-heading-selector>.question-panel nav{grid-template-columns:1fr}
      .question-heading-selector>.question-panel .question-tab{min-height:0}
      .question-view,.comparison-view{padding:22px 18px 72px}
      .synthesis{border-radius:18px}
      .synthesis-label{padding:24px 20px 0}
      .synthesis-answer{padding:24px 20px 28px!important}
      .orientation-notes{grid-template-columns:1fr}
      .orientation-notes article+article{border-left:0;border-top:1px solid var(--atlas-line)}
      .synthesis footer{display:grid;grid-template-columns:1fr;gap:10px;margin:0 20px}
      .synthesis footer button{justify-self:start}
      .map{margin-top:48px}
      .map>header span{font-size:31px}
      .reasoning-path{margin-top:54px;padding-top:38px}
      .reasoning-steps>button{min-height:0}
      .own-question{grid-template-columns:1fr}
      .inquiry-trail,.revision-story,.public-actions>article{padding:22px}
      .inquiry-trail>header{grid-template-columns:1fr;gap:24px;align-items:start}
      .inquiry-trail>header h3{font-size:40px}
      .trail-progress{min-width:0;width:100%;text-align:left}
      .trail-states,.public-actions{grid-template-columns:1fr}
      .trail-states{margin-top:28px}
      .trail-shift{min-height:34px;transform:rotate(90deg)}
      .trail-states .trail-state{min-height:126px}
      .trail-states .trail-state--opened{grid-column:1;grid-template-columns:1fr;gap:12px}
      .trail-next{align-items:flex-start;flex-direction:column}
      .inquiry-trail>footer{grid-template-columns:1fr}
      .inquiry-trail>footer>small{grid-column:1;text-align:left}
      .public-actions form{grid-template-columns:1fr}
      .inspector{top:62px}
      .nav-collapsed .inspector{top:0}
      .person-pickers{grid-template-columns:1fr}
      .versus{grid-template-columns:auto auto}
    }

    /* Public reading path --------------------------------------------------
       Keep the archive machinery available without presenting it as chrome. */
    .workspace>.topbar{grid-template-columns:minmax(0,1fr) auto}
    .atlas-mark{display:flex;align-items:baseline;gap:12px;min-width:0}
    .atlas-mark b{color:var(--atlas-ink);font:500 15px var(--sans);white-space:nowrap}
    .atlas-mark span{overflow:hidden;color:var(--atlas-muted);font:400 10px var(--mono);text-overflow:ellipsis;white-space:nowrap}
    .question-heading-selector>.question-panel .search-shell{margin-top:18px}
    .question-heading-selector>.question-panel .global-search{display:flex;max-width:none;background:var(--atlas-soft)}
    .question-heading-selector>.question-panel nav{margin-top:12px}

    .synthesis{
      display:grid;
      grid-template-columns:minmax(0,1fr);
      overflow:visible;
      border:0;
      border-radius:0;
      background:#fff;
      box-shadow:none;
    }
    .synthesis:before{inset:0 0 auto;height:3px}
    .synthesis-label{grid-column:1;grid-row:1;display:flex;justify-content:flex-end;padding:27px 0 0;text-transform:none;letter-spacing:0}
    .synthesis-answer{
      grid-column:1;
      grid-row:2;
      max-width:37ch;
      padding:22px 0 34px!important;
      font-size:clamp(22px,2vw,30px)!important;
    }
    .orientation-notes{
      grid-column:1;
      grid-row:3;
      display:grid;
      grid-template-columns:1fr 1fr;
      border:0;
      border-top:1px solid var(--atlas-line);
      border-bottom:1px solid var(--atlas-line);
    }
    .orientation-notes article,.orientation-notes article+article{
      padding:22px 28px 22px 0;
      border:0;
      background:#fff!important;
    }
    .orientation-notes article+article{padding-left:28px;border-left:1px solid var(--atlas-line)}
    .orientation-notes h2{font:500 16px/1.25 var(--sans)}
    .orientation-notes p{max-width:48ch}
    .synthesis footer{
      grid-column:1;
      grid-row:4;
      align-items:center;
      margin:0;
      padding:16px 0 0;
      border:0;
    }

    .lanes{
      gap:0;
      align-items:stretch;
      padding:0;
      overflow:hidden;
      border:1px solid var(--atlas-line);
      border-radius:18px;
      background:#fff;
      box-shadow:none;
    }
    .lane,.lane--agreement,.lane--disagreement,.lane--uncertainty{
      display:flex;
      flex-direction:column;
      min-height:0;
      padding:18px 14px 24px;
      border:0;
      border-radius:0;
      background:#fff;
    }
    .lane+.lane{border-left:1px solid var(--atlas-line)}
    .lane-name{padding:0 4px 16px}
    .evidence-card{
      position:relative;
      display:grid;
      grid-template-rows:auto 1fr auto auto;
      flex:1 1 0;
      height:100%;
      padding:18px;
      border-color:var(--atlas-line);
      background:var(--atlas-soft);
    }
    .evidence-card+.evidence-card{margin-top:12px}
    .evidence-card:after{content:"Open source →";display:block;margin-top:14px;color:var(--atlas-muted);font:500 9px var(--mono)}

    .reasoning-path{
      margin-top:58px;
      padding:46px 0 0;
      border:0;
      border-top:1px solid var(--atlas-line);
      border-bottom:1px solid var(--atlas-line);
      background:#fff;
    }
    .reasoning-body{padding:0 0 42px;border:0}
    .reasoning-body>header p{margin-top:8px;color:var(--atlas-muted);font:400 14px/1.5 var(--sans)}
    .reasoning-steps b,.reasoning-decision h3,.inquiry-trail h3,.public-actions h2,.challenge-panel h2{margin-top:0}

    /* Small text now functions as ordinary metadata, never as a decorative eyebrow. */
    .workspace small{
      font-family:var(--sans)!important;
      font-weight:400!important;
      letter-spacing:0!important;
      text-transform:none!important;
    }

    @media(max-width:900px){
      .workspace>.topbar{grid-template-columns:minmax(0,1fr) auto}
      .lanes{grid-template-columns:1fr}
      .lane+.lane{border-left:0;border-top:1px solid var(--atlas-line)}
    }
    @media(max-width:720px){
      .atlas-mark span{display:none}
      .synthesis{border-radius:0}
      .synthesis-label{padding:24px 0 0}
      .synthesis-answer{padding:20px 0 28px!important}
      .orientation-notes{grid-template-columns:1fr}
      .orientation-notes article,.orientation-notes article+article{padding:18px 0;border-left:0}
      .orientation-notes article+article{border-top:1px solid var(--atlas-line)}
      .synthesis footer{margin:0;padding-top:15px}
      .reasoning-path{padding-top:34px!important}
    }

    /* Approved public question page -------------------------------------- */
    .workspace{
      grid-template-rows:78px minmax(0,1fr);
    }
    .workspace.nav-collapsed{
      grid-template-rows:78px minmax(0,1fr);
    }
    .workspace>.topbar,
    .workspace.nav-collapsed>.topbar{
      position:relative;
      z-index:100;
      display:grid;
      grid-template-columns:1fr auto;
      gap:28px;
      height:78px;
      min-height:78px;
      padding:0 clamp(24px,5vw,76px);
      border:0;
      background:rgba(255,255,255,.96)!important;
      opacity:1;
      transform:none;
      pointer-events:auto;
    }
    .workspace>.topbar:after{
      content:"";
      position:absolute;
      right:clamp(24px,5vw,76px);
      bottom:0;
      left:clamp(24px,5vw,76px);
      height:2px;
      background:var(--atlas-grad);
    }
    .atlas-logo{
      display:flex;
      align-items:center;
      width:max-content;
      min-width:190px;
      text-decoration:none;
    }
    .atlas-logo:focus-visible{outline:2px solid var(--atlas-ink);outline-offset:7px}
    .atlas-nav{display:flex;align-items:center;gap:28px}
    .atlas-tab,
    .topbar .atlas-tab,
    .topbar .compare-launch{
      position:relative;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:42px;
      padding:0;
      border:0;
      border-radius:0;
      background:transparent;
      box-shadow:none;
      color:var(--atlas-ink);
      font:400 14px var(--sans);
      text-decoration:none;
      cursor:pointer;
    }
    .atlas-tab:after{
      content:"";
      position:absolute;
      right:0;
      bottom:4px;
      left:0;
      height:2px;
      background:var(--red);
      opacity:0;
      transform:scaleX(.5);
      transition:opacity .18s ease,transform .18s ease;
    }
    .atlas-tab:hover,.atlas-tab.active,.topbar .compare-launch:hover,.topbar .compare-launch.active{background:transparent;color:var(--atlas-ink);transform:none}
    .atlas-tab:hover:after,.atlas-tab.active:after{opacity:1;transform:none}
    .atlas-search-button{
      display:grid;
      place-items:center;
      width:42px;
      height:42px;
      padding:0;
      border:0;
      border-radius:50%;
      background:transparent;
      color:var(--atlas-ink);
      cursor:pointer;
    }
    .atlas-search-button{margin-left:2px;border-left:1px solid var(--atlas-line);border-radius:0;padding-left:20px;width:62px}
    .atlas-search-button:hover{background:var(--atlas-soft)}
    .atlas-search-button svg{width:24px;fill:none;stroke:currentColor;stroke-width:1.6}
    .workspace>.control-peek,.workspace>.app-return{display:none!important}

    .site-exit-dialog{
      width:min(430px,calc(100vw - 32px));
      margin:auto;
      padding:0;
      overflow:hidden;
      border:1px solid #d9d9dc;
      border-radius:20px;
      color:var(--atlas-ink);
      box-shadow:0 24px 80px rgba(0,0,0,.16);
    }
    .site-exit-dialog::backdrop{background:rgba(20,20,24,.18);backdrop-filter:blur(3px)}
    .site-exit-dialog form{position:relative;padding:34px}
    .site-exit-dialog h2{padding-right:48px;font:400 31px/1.08 var(--sans);letter-spacing:-.035em}
    .site-exit-dialog p{margin-top:14px;color:#66656b;font:400 15px/1.5 var(--sans)}
    .site-exit-dialog form>div{display:flex;justify-content:flex-end;align-items:center;gap:10px;margin-top:30px}
    .site-exit-dialog button,.site-exit-dialog a{display:inline-flex;align-items:center;justify-content:center;min-height:46px;border-radius:999px;font:500 14px var(--sans);cursor:pointer}
    .site-exit-stay{border:1px solid #d9d9dc}
    .site-exit-confirm{border:1px solid var(--atlas-ink);background:var(--atlas-ink);color:#fff}
    .site-exit-close{position:absolute;top:18px;right:18px;width:38px;min-height:38px!important;border:1px solid #d9d9dc;font-size:22px!important;font-weight:300!important}
    .site-exit-dialog button:hover{background:#f5f5f6}
    .site-exit-confirm:hover{background:#353439}
    .site-exit-dialog :focus-visible{outline:2px solid var(--red);outline-offset:3px}

    .contribution-dialog{
      width:min(660px,calc(100vw - 28px));
      height:min(500px,calc(100dvh - 32px));
      max-height:calc(100dvh - 32px);
      margin:auto;
      padding:0;
      overflow:auto;
      border:1px solid var(--atlas-line);
      border-radius:18px;
      background:#fff;
      color:var(--atlas-ink);
      box-shadow:0 24px 72px rgba(0,0,0,.16);
    }
    .contribution-dialog::backdrop{background:rgba(20,20,24,.18);backdrop-filter:blur(3px)}
    .contribution-shell{position:relative;height:100%;box-sizing:border-box;padding:28px}
    .contribution-close{
      position:absolute;
      top:20px;
      right:20px;
      display:grid;
      place-items:center;
      width:36px;
      height:36px;
      padding:0;
      border:1px solid var(--atlas-line);
      border-radius:50%;
      background:#fff;
      color:var(--atlas-ink);
      font-size:0;
      cursor:pointer;
    }
    .contribution-close::before,
    .contribution-close::after{
      content:"";
      position:absolute;
      top:50%;
      left:50%;
      width:15px;
      height:1.5px;
      border-radius:999px;
      background:currentColor;
      transform-origin:center;
    }
    .contribution-close::before{transform:translate(-50%,-50%) rotate(45deg)}
    .contribution-close::after{transform:translate(-50%,-50%) rotate(-45deg)}
    .contribution-close:hover{border-color:var(--atlas-ink);background:var(--atlas-soft)}
    .contribution-dialog :focus-visible{outline:2px solid var(--red);outline-offset:2px}
    .contribution-shell>header{padding-right:48px}
    .contribution-shell>header h2{font:400 36px/1 var(--sans);letter-spacing:-.045em}
    .contribution-shell>header p{margin-top:9px;color:var(--atlas-muted);font:400 14px/1.45 var(--sans)}
    .contribution-shell>header strong{color:var(--atlas-ink);font-weight:500}
    .contribution-choices{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:4px;
      margin-top:22px;
      padding:4px;
      border-radius:999px;
      background:var(--atlas-soft);
    }
    .contribution-choices button{
      display:flex;
      align-items:center;
      justify-content:center;
      min-height:44px;
      padding:0 16px;
      border:0;
      border-radius:999px;
      background:transparent;
      color:var(--atlas-ink);
      text-align:center;
      cursor:pointer;
    }
    .contribution-choices button.active{background:#fff;box-shadow:0 1px 4px rgba(0,0,0,.1)}
    .contribution-choices b{font:500 13px var(--sans)}
    .contribution-panel{margin-top:18px;padding-top:18px;border-top:1px solid var(--atlas-line)}
    .contribution-panel[hidden]{display:none}
    .contribution-panel form{display:grid;gap:13px}
    .contribution-panel label{display:grid;gap:7px;color:var(--atlas-ink);font:500 12px var(--sans)}
    .contribution-panel label small{margin-left:5px;color:var(--atlas-muted);font:400 11px var(--sans);text-transform:none;letter-spacing:0}
    .contribution-panel input,.contribution-panel select,.contribution-panel textarea{
      width:100%;
      padding:11px 13px;
      border:1px solid var(--atlas-line);
      border-radius:10px;
      background:#fff;
      color:var(--atlas-ink);
      font:400 14px/1.4 var(--sans);
      outline:none;
    }
    .contribution-panel textarea{min-height:108px;resize:vertical}
    .contribution-panel input:focus,.contribution-panel select:focus,.contribution-panel textarea:focus{border-color:var(--atlas-ink);box-shadow:0 0 0 3px rgba(238,59,24,.08)}
    .contribution-panel form[name="coexistence-record-suggestions"]{grid-template-columns:1fr 1fr}
    .contribution-panel form[name="coexistence-record-suggestions"] label:nth-of-type(1){grid-column:1}
    .contribution-panel form[name="coexistence-record-suggestions"] label:nth-of-type(2){grid-column:1/-1}
    .contribution-panel form[name="coexistence-record-suggestions"] label:nth-of-type(3){grid-column:2;grid-row:1}
    .contribution-panel form[name="coexistence-record-suggestions"] .contribution-status{grid-column:1;align-self:center}
    .contribution-panel form[name="coexistence-record-suggestions"] button[type="submit"]{grid-column:2;justify-self:end}
    .contribution-panel form[name="coexistence-record-question-updates"]{grid-template-columns:1fr auto;align-items:end}
    .contribution-panel form[name="coexistence-record-question-updates"] .contribution-status{grid-column:1/-1;grid-row:2}
    .contribution-panel button[type="submit"]{
      display:inline-flex;
      align-items:center;
      justify-content:space-between;
      gap:28px;
      justify-self:end;
      min-height:44px;
      padding:0 17px;
      border:1px solid var(--atlas-ink);
      border-radius:999px;
      background:var(--atlas-ink);
      color:#fff;
      font:500 13px var(--sans);
      cursor:pointer;
    }
    .contribution-panel button[type="submit"]:disabled{opacity:.55;cursor:wait}
    .contribution-status{min-height:18px;margin:0;color:var(--atlas-muted);font:400 12px/1.4 var(--sans)}
    .quiet-contribution{
      display:flex;
      align-items:center;
      gap:8px;
      width:max-content;
      margin:22px 0 0 auto;
      padding:0 0 5px;
      border:0;
      border-bottom:1px solid var(--atlas-line);
      background:none;
      color:var(--atlas-muted);
      font:400 13px var(--sans);
      cursor:pointer;
    }
    .quiet-contribution:hover,.quiet-contribution:focus-visible{border-color:var(--atlas-ink);color:var(--atlas-ink);outline:none}

    .question-heading-selector{
      position:relative;
      z-index:90;
      width:0;
      height:0;
      margin:0;
      padding:0!important;
    }
    .workspace:not([hidden]) .question-heading-selector{animation:none!important;transform:none!important}
    .question-heading-selector>.current-question{
      position:fixed!important;
      width:1px!important;
      height:1px!important;
      margin:-1px!important;
      padding:0!important;
      overflow:hidden!important;
      clip:rect(0 0 0 0)!important;
      clip-path:inset(50%)!important;
      border:0!important;
      white-space:nowrap!important;
    }
    .question-heading-selector>.question-panel{
      position:fixed;
      top:var(--question-panel-top,88px);
      right:auto;
      left:var(--question-panel-left,50%);
      width:var(--question-panel-width,min(1040px,calc(100vw - 48px)));
      max-height:calc(100dvh - var(--question-panel-top,88px) - 18px);
      padding:0;
      overflow:auto;
      border:1px solid var(--atlas-ink);
      border-radius:18px;
      background:#fff;
      box-shadow:0 24px 70px rgba(20,20,24,.16);
      transform:translateX(-50%);
      animation:atlas-question-reveal .14s ease-out both!important;
    }
    .question-heading-selector>.question-panel[data-anchor="title"]{transform:none}
    .question-heading-selector>.question-panel:before{display:none}
