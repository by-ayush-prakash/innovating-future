      border-radius:22px;
      background:#fff;
      box-shadow:7px 8px 0 var(--neo-ink);
    }
    .journey-builder>section>h2{margin:0 0 20px;font:850 clamp(27px,3vw,38px)/1 var(--sans);letter-spacing:-.04em}
    .journey-question-options,.journey-route-options{display:grid;gap:11px}
    .journey-question-options button,
    .journey-route-options button{
      width:100%;
      min-height:76px;
      padding:16px 18px;
      border:2px solid var(--neo-ink);
      border-radius:13px;
      background:var(--neo-soft-yellow);
      box-shadow:3px 4px 0 var(--neo-ink);
      text-align:left;
      transition:transform .14s ease,box-shadow .14s ease;
