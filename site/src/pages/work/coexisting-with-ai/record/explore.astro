      margin-top:72px;
      padding:0;
      overflow:hidden;
      border:var(--neo-line);
      border-radius:28px;
      background:var(--neo-ink);
      box-shadow:10px 11px 0 var(--neo-pink);
    }
    .reasoning-body{padding:0}
    .reasoning-body>header{padding:30px 32px;border-bottom:var(--neo-line);background:var(--neo-yellow)}
    .reasoning-body>header h2{font:850 clamp(40px,4.6vw,68px)/.94 var(--sans);letter-spacing:-.055em}
    .reasoning-body>header p{max-width:64ch;margin-top:12px;color:var(--neo-ink);font:650 17px/1.45 var(--sans)}
    .reflection-progress{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0;padding:0;border-bottom:var(--neo-line);background:#fff;list-style:none}
    .reflection-progress li{display:grid;grid-template-columns:auto 1fr;gap:7px 12px;min-height:92px;padding:16px 18px;border-right:2px solid var(--neo-ink);background:#fff}
    .reflection-progress li:last-child{border-right:0}
    .reflection-progress li:nth-child(1){--step-color:var(--neo-soft-yellow)}
    .reflection-progress li:nth-child(2){--step-color:var(--neo-soft-pink)}
    .reflection-progress li:nth-child(3){--step-color:var(--neo-soft-teal)}
    .reflection-progress li:nth-child(4){--step-color:var(--neo-soft-lilac)}
