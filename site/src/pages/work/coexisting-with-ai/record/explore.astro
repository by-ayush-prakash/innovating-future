    .question-heading-selector>.question-panel .search-results :global(i){display:grid;grid-column:3;grid-row:1/-1;place-items:center;width:42px;height:42px;border:2px solid var(--neo-ink);border-radius:10px;background:#fff;font:700 20px/1 var(--sans);font-style:normal;box-shadow:3px 4px 0 var(--neo-ink)}
