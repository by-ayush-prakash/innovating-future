    }
    .map .lane--agreement{background:var(--neo-teal)}
    .map .lane--disagreement{background:var(--neo-orange)}
    .map .lane--uncertainty{background:var(--neo-yellow)}
    .lane-name b{color:var(--neo-ink);font-weight:850}
    .evidence-card{
      border:2px solid var(--neo-ink);
      border-radius:16px;
      background:#fff;
      color:var(--neo-ink);
      box-shadow:4px 5px 0 var(--neo-ink);
