    }
    .public-position-card:hover,.public-position-card:focus-visible,.public-position-card.active{
      border-color:var(--neo-ink);
      box-shadow:11px 12px 0 var(--neo-ink);
      transform:translate(-4px,-4px);
    }
    .public-position-card:nth-child(1):hover,.public-position-card:nth-child(1):focus-visible,.public-position-card:nth-child(1).active{background:var(--neo-teal)}
    .public-position-card:nth-child(2):hover,.public-position-card:nth-child(2):focus-visible,.public-position-card:nth-child(2).active{background:var(--neo-lilac)}
    .public-position-card:nth-child(3):hover,.public-position-card:nth-child(3):focus-visible,.public-position-card:nth-child(3).active{background:var(--neo-yellow)}
    .public-position-card:nth-child(4):before{content:"ALL"}
    .public-position-card--all{
      grid-column:1/-1;
      grid-template-columns:auto minmax(220px,.8fr) minmax(300px,1.2fr) auto;
      grid-template-rows:1fr;
      gap:22px;
      align-items:center;
      min-height:132px;
      background:var(--neo-pink);
    }
    .public-position-card--all:before{margin:0}
    .public-position-card--all h2{font-size:clamp(25px,2.4vw,36px)}
    .public-position-card--all p{max-width:52ch;margin:0}
    .public-position-card--all:hover,.public-position-card--all:focus-visible,.public-position-card--all.active{background:var(--neo-pink)}

    .all-positions-panel{
      margin-top:30px;
      padding:30px;
      border:var(--neo-line);
      border-radius:24px;
      background:var(--neo-ink);
      box-shadow:8px 9px 0 var(--neo-lilac);
