    .reflection-progress i{font:650 12px/1.2 var(--sans);font-style:normal}
    .reflection-progress li.complete i:before{content:"✓ ";font-weight:900}
    .reflection-stage{margin:18px;padding:26px;border:var(--neo-line);border-radius:22px;background:#fff;box-shadow:6px 7px 0 var(--neo-lilac)}
    .reflection-stage>header{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:16px 18px;align-items:start}
    .reflection-stage>header>span{display:grid;width:44px;height:38px;place-items:center;border:2px solid var(--neo-ink);border-radius:9px;background:#fff;box-shadow:3px 3px 0 var(--neo-ink);font:850 12px/1 var(--mono)}
    .reflection-stage>header h3{margin:0;font:850 clamp(25px,2.6vw,38px)/1.02 var(--sans);letter-spacing:-.04em}
    .reflection-stage>header p{max-width:62ch;margin-top:8px;font:600 14px/1.45 var(--sans)}
    .reflection-stage>header>b{padding:8px 10px;border:2px solid var(--neo-ink);border-radius:9px;background:#fff;font:800 11px/1 var(--sans);white-space:nowrap}
    .reflection-stage--challenge{background:var(--neo-soft-yellow);box-shadow:6px 7px 0 var(--neo-yellow)}
    .reasoning-steps>button{
      border:var(--neo-line);
      border-radius:18px;
      background:#fff;
      color:var(--neo-ink);
      box-shadow:5px 6px 0 var(--neo-ink);
    }
    .reasoning-steps{gap:16px;margin-top:24px}
    .reasoning-steps>button{min-height:176px;padding:20px}
    .reasoning-steps>button:nth-child(1){background:#fff}
    .reasoning-steps>button:nth-child(2){background:var(--neo-soft-teal)}
    .reasoning-steps>button:nth-child(3){background:var(--neo-soft-lilac)}
    .reasoning-steps>button:hover,.reasoning-steps>button.active{box-shadow:8px 9px 0 var(--neo-ink)}
    .reasoning-steps>button.active{background:var(--neo-yellow)}
    .reasoning-steps>button>span{color:var(--neo-ink);font-weight:850!important}
    .reasoning-steps b{margin-top:0;font:800 16px/1.32 var(--sans)}
    .reasoning-steps p{font:600 14px/1.48 var(--sans)}
    .reflection-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:0 18px}
    .reflection-grid>.reflection-stage{height:100%;margin:0}
