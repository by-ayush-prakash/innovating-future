      .journey-tutorial li{grid-template-columns:38px minmax(0,1fr);padding:18px;border-width:2px;box-shadow:4px 5px 0 var(--neo-ink)}
      .journey-tutorial li>span{width:34px;height:34px}
      .journey-builder>section{padding:21px 17px;border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .journey-onboarding-shell>footer{align-items:stretch;flex-direction:column;padding:18px;border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .journey-onboarding-shell>footer button{width:100%}
      .comparison-head-actions{justify-content:flex-start}
    }

    /* Simple two-screen journey chooser. One decision at a time. */
    .journey-onboarding-shell{
      display:grid;
      min-height:100dvh;
      place-items:center;
      padding:44px clamp(20px,5vw,72px);
    }
    .journey-step{
      width:min(1040px,100%);
    }
    .journey-step[hidden]{display:none}
    .journey-step>header{
      display:grid;
      grid-template-columns:minmax(0,1fr) auto;
      gap:30px;
      align-items:end;
      margin-bottom:28px;
    }
    .journey-step>header h1{
      max-width:12ch;
      margin:0;
      font:850 clamp(52px,7vw,88px)/.9 var(--sans);
      letter-spacing:-.065em;
    }
    .journey-step>header p{
      max-width:30ch;
      margin:0 0 8px;
      font:700 16px/1.4 var(--sans);
    }
    .journey-step[data-journey-step="question"]>header{
      grid-template-columns:minmax(0,1fr);
      gap:12px;
      align-items:start;
      margin-bottom:26px;
    }
    .journey-step[data-journey-step="question"]>header h1{
      max-width:none;
      font-size:clamp(52px,6vw,74px);
      line-height:.94;
      white-space:nowrap;
    }
    .journey-step[data-journey-step="question"]>header p{
      max-width:56ch;
      margin:0;
      padding:0;
      border:0;
      background:transparent;
      box-shadow:none;
      font:700 16px/1.42 var(--sans);
    }
    .journey-step>header [data-journey-question-choice]{
      display:inline-grid;
      grid-template-columns:36px minmax(0,1fr);
      gap:12px;
      align-items:center;
      justify-self:end;
      width:max-content;
      max-width:none;
      margin:0 6px 8px 0;
      padding:8px 18px 8px 8px;
      border:2px solid var(--neo-ink);
      border-radius:12px;
      background:var(--neo-yellow);
