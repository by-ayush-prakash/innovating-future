      color:var(--neo-ink);
      font:800 11px/1 var(--sans)!important;
      white-space:nowrap;
    }
    .all-position-card>div{margin-top:27px}
    .all-position-card h3{margin:0;font:850 24px/1.05 var(--sans);letter-spacing:-.03em}
    .all-position-card em{display:block;margin-top:5px;font:650 12px/1.3 var(--sans);font-style:normal}
    .all-position-card p{margin:25px 0 0;font:650 15px/1.42 var(--sans)}
    .all-position-card>footer{display:flex;align-items:end;justify-content:space-between;gap:14px;margin-top:auto;padding-top:30px}
    .all-position-card>footer>small{
