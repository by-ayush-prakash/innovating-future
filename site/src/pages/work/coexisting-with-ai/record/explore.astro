    .all-positions-panel[hidden]{display:none}
    .all-positions-panel>header{display:flex;align-items:end;justify-content:space-between;gap:24px;padding-bottom:24px}
    .all-positions-panel>header small{color:var(--neo-yellow);font-weight:800!important}
    .all-positions-panel>header h2{margin:0;font:750 clamp(30px,3.2vw,46px)/1 var(--sans);letter-spacing:-.045em}
    .all-positions-panel>header p{max-width:58ch;margin:12px 0 0;font:650 14px/1.4 var(--sans)}
    .all-positions-panel>header button{
