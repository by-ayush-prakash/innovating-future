    .all-position-card--source-industry{background:var(--neo-orange)}
    .all-position-card--source-policy{background:var(--neo-yellow)}
    .all-position-card--source-public{background:var(--neo-lilac)}
    .all-position-card:hover,.all-position-card:focus-visible{outline:none;transform:translate(-3px,-3px);box-shadow:7px 8px 0 #fff}
    .all-position-card>header{display:flex;align-items:center;gap:11px;min-height:34px}
    .all-position-card>header span{
      display:grid;
      flex:0 0 44px;
      min-height:31px;
      place-items:center;
      border:2px solid var(--neo-ink);
      border-radius:8px;
