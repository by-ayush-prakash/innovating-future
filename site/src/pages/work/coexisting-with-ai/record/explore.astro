    /* Reference-led Atlas system: bold, modular, playful, and public-facing. */
    .workspace{
      --neo-ink:#111111;
      --neo-paper:#f7f2e8;
      --neo-red:#d83a2e;
      --neo-blue:#2f6db5;
      --neo-yellow:#f2c230;
      --neo-pink:#f3d8d4;
      --neo-orange:#f3d8d4;
      --neo-teal:#dce7f3;
      --neo-green:#f8edc9;
      --neo-lilac:#dce7f3;
      --neo-soft-pink:#faeeec;
      --neo-soft-yellow:#f8edc9;
      --neo-soft-teal:#edf3f9;
      --neo-soft-lilac:#edf3f9;
      --neo-line:3px solid var(--neo-ink);
      color:var(--neo-ink);
      background:var(--neo-paper);
    }
    .evidence-canvas{
      background-color:var(--neo-paper)!important;
      background-image:
        radial-gradient(circle at 9% 18%,rgba(216,58,46,.11) 0 11vw,transparent 11.1vw),
        radial-gradient(circle at 100% 62%,rgba(47,109,181,.10) 0 14vw,transparent 14.1vw)!important;
    }
    .workspace>.topbar,.workspace.nav-collapsed>.topbar{
      border-bottom:var(--neo-line)!important;
      background:#fff!important;
    }
    .workspace>.topbar:after{display:none}
    .atlas-tab,.topbar .atlas-tab,.topbar .compare-launch{
      flex:0 0 auto;
      min-height:38px;
      padding:0 12px;
      border:2px solid var(--neo-ink);
      border-radius:10px;
      font-weight:700;
    }
    .atlas-tab:after{display:none}
    .topbar .atlas-tab:hover,.topbar .atlas-tab.active,
    .topbar .compare-launch:hover,.topbar .compare-launch.active{
      border-color:var(--neo-ink);
      background:var(--neo-yellow);
      box-shadow:3px 4px 0 var(--neo-ink);
      transform:translate(-1px,-1px);
    }
    .topbar .atlas-tab[data-header-questions]{background:var(--neo-teal)}
    .topbar .atlas-tab[data-show-people]{background:var(--neo-lilac)}
    .topbar .atlas-tab[data-show-compare]{background:var(--neo-orange)}
    .topbar .atlas-tab[data-show-about]{background:var(--neo-yellow)}
