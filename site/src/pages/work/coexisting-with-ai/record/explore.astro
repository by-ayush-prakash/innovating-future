      border-top:2px solid var(--neo-ink);
    }
    .map.is-focused .evidence-card-context>small{font-size:11px;font-weight:800}
    .map .evidence-card-context>p,.map.is-focused .evidence-card-context>p{max-width:72ch;margin-top:0;color:var(--neo-ink);font:600 15px/1.5 var(--sans)}
    .map.is-focused .evidence-card>footer{padding-top:17px;border-top:2px solid var(--neo-ink)}
