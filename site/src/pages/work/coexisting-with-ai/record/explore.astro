      width:max-content;
      margin-bottom:34px;
      padding:5px 8px;
      border:2px solid var(--neo-ink);
      border-radius:8px;
      background:#fff;
      font:800 11px/1 var(--mono);
      box-shadow:2px 3px 0 var(--neo-ink);
    }
    .public-position-card:nth-child(1):before{content:"01"}
    .public-position-card:nth-child(2):before{content:"02"}
    .public-position-card:nth-child(3):before{content:"03"}
    .public-position-card h2{font-weight:750}
    .public-position-card p{color:var(--neo-ink);font-weight:600}
    .public-position-card>span{
      justify-self:end;
      display:grid;
      place-items:center;
      width:48px;
      height:48px;
      border:2px solid var(--neo-ink);
