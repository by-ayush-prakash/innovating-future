    .journey-question-options button{
      grid-template-columns:38px minmax(0,1fr);
      gap:14px;
      align-items:center;
    }
    .journey-question-options button:nth-child(2){background:var(--neo-soft-teal)}
    .journey-question-options button:nth-child(3){background:var(--neo-soft-lilac)}
    .journey-question-options button:nth-child(4){background:var(--neo-soft-pink)}
    .journey-question-options button:nth-child(5){background:#ddf6ce}
    .journey-question-options button>span{font:800 12px var(--sans)}
    .journey-question-options button>strong{font:800 16px/1.25 var(--sans)}
    .journey-route-options strong{font:850 19px/1.05 var(--sans)}
    .journey-route-options span{margin-top:7px;font:600 13px/1.4 var(--sans)}
    .journey-question-options button:hover,
    .journey-question-options button:focus-visible,
    .journey-route-options button:hover,
    .journey-route-options button:focus-visible{
      box-shadow:6px 7px 0 var(--neo-ink);
