      color:var(--neo-ink);
      font:850 10px/1 var(--mono);
      text-transform:uppercase;
    }
    .about-footer-copy>h2{max-width:13ch;margin-top:0;font:850 clamp(38px,4.6vw,66px)/.94 var(--sans);letter-spacing:-.055em}
    .about-footer-copy>p{max-width:48ch;margin-top:22px;color:var(--neo-ink);font:650 16px/1.45 var(--sans);letter-spacing:-.01em}
    .about-footer>.about-footer-actions{display:grid;width:100%;grid-template-rows:1fr 1fr;gap:14px;align-items:stretch}
    .about-footer .about-footer-actions button{
      display:flex;
      min-height:112px;
      align-items:center;
      justify-content:space-between;
      gap:20px;
      padding:20px 22px;
      border:2px solid var(--neo-ink);
      border-radius:16px;
      background:var(--neo-yellow);
      color:var(--neo-ink);
      box-shadow:4px 5px 0 var(--neo-ink);
      text-align:left;
      cursor:pointer;
      transition:transform .18s ease,box-shadow .18s ease;
    }
    .about-footer .about-footer-actions button+button{background:#fff}
    .about-footer .about-footer-actions button:hover,.about-footer .about-footer-actions button:focus-visible{outline:none;background:var(--neo-teal);color:var(--neo-ink);transform:translate(-2px,-2px);box-shadow:6px 7px 0 var(--neo-ink)}
    .about-footer-actions button>span{display:grid;gap:8px}
    .about-footer-actions button small{font:800 10px/1 var(--mono);text-transform:uppercase}
    .about-footer-actions button b{font:850 clamp(19px,1.8vw,25px)/1 var(--sans);letter-spacing:-.03em}
    .about-footer-actions button>i{display:grid;flex:0 0 42px;height:42px;place-items:center;border:2px solid var(--neo-ink);border-radius:10px;background:#fff;box-shadow:3px 3px 0 var(--neo-ink);font:900 22px/1 var(--sans);font-style:normal}

    .inspector,.nav-collapsed .inspector{
      border:var(--neo-line);
      border-radius:24px;
      box-shadow:10px 11px 0 var(--neo-ink);
    }
    .inspector-details{gap:12px;border:0;border-radius:0;background:transparent}
    .inspector-verification>button{
      border:2px solid var(--neo-ink)!important;
      border-radius:14px;
      background:var(--neo-yellow)!important;
      color:var(--neo-ink)!important;
      box-shadow:4px 5px 0 var(--neo-ink)!important;
    }
    .inspector-verification>button:hover{background:var(--neo-pink)!important}
    .inspector-source-status{
      margin:0;
      padding:16px 18px;
      border:2px solid var(--neo-ink);
      border-radius:14px;
      background:var(--neo-soft-lilac);
      color:var(--neo-ink);
      font:750 14px/1.4 var(--sans);
      box-shadow:4px 5px 0 var(--neo-ink);
    }
    .inspector-media-frame{border:var(--neo-line);border-radius:18px;box-shadow:7px 8px 0 var(--neo-ink)}
    .inspector-media-copy{gap:12px;border:0;background:transparent}
    .inspector-media-copy article{border:2px solid var(--neo-ink);border-radius:16px;background:var(--neo-soft-yellow);box-shadow:4px 5px 0 var(--neo-ink)}
    .inspector-media-copy article+article{background:var(--neo-soft-teal)}
    .inspector-media>section>h2{margin-top:0}

    @media(max-width:900px){
      .public-position-grid{gap:18px}
      .public-position-card--all{grid-template-columns:auto minmax(0,1fr) auto;grid-template-rows:auto auto}
      .public-position-card--all p{grid-column:2/4}
      .all-positions-grid{grid-template-columns:1fr 1fr}
      .map .lanes{grid-template-columns:1fr;gap:13px}
      .map .lane{min-height:0}
      .map.is-focused .lane.is-focused{grid-template-columns:1fr}
      .reflection-progress{grid-template-columns:1fr 1fr}
      .reflection-progress li:nth-child(2){border-right:0}
      .reflection-progress li:nth-child(-n+2){border-bottom:2px solid var(--neo-ink)}
      .reflection-grid{grid-template-columns:1fr}
      .trail-summary{grid-template-columns:1fr 1fr}
      .learning-guide,.inquiry-trail{box-shadow:7px 8px 0 var(--neo-ink)}
      .contribution-stage{padding:28px}
      .compare-question-strip{grid-template-columns:1fr}
      .about-footer{grid-template-columns:1fr}
      .about-footer>.about-footer-actions{grid-template-columns:1fr 1fr;grid-template-rows:auto}
    }
    @media(max-width:720px){
      .site-exit-dialog{width:calc(100vw - 24px);border-width:2px;border-radius:18px;box-shadow:7px 8px 0 var(--neo-ink)}
      .site-exit-dialog h2{padding:28px 78px 26px 22px;border-bottom-width:2px;border-radius:15px 15px 0 0;font-size:34px}
      .site-exit-dialog p{padding:22px 22px 0;font-size:16px}
      .site-exit-dialog form>div{grid-template-columns:1fr;padding:22px 22px 28px}
      .site-exit-dialog button,.site-exit-dialog a{width:100%;min-height:54px}
      .site-exit-close{top:14px;right:14px;width:46px!important;min-height:46px!important}
      .workspace>.topbar,.workspace.nav-collapsed>.topbar{grid-template-columns:auto minmax(0,1fr);border-bottom:2px solid var(--neo-ink)!important}
      .atlas-nav{min-width:0;gap:10px;overflow-x:auto;padding:5px 4px 8px}
      .atlas-tab,.topbar .atlas-tab,.topbar .compare-launch{padding:0 8px;border-radius:8px}
      .topbar .compare-launch{width:auto!important;min-width:max-content}
      .topbar .atlas-tab:hover,.topbar .atlas-tab.active,.topbar .compare-launch:hover,.topbar .compare-launch.active{box-shadow:2px 3px 0 var(--neo-ink)}
      .question-title-selector{border-width:2px;border-radius:16px;box-shadow:6px 7px 0 var(--neo-ink)}
      .question-title-selector>i{border-left-width:2px}
      .public-position-card{min-height:0;border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .public-position-card:before{margin-bottom:24px}
      .public-position-card--all{grid-column:1;grid-template-columns:auto minmax(0,1fr) auto;gap:14px}
      .public-position-card--all:before{margin:0}
      .public-position-card--all p{grid-column:1/-1;margin:8px 0 0}
      .all-positions-panel{padding:22px 18px;border-width:2px;border-radius:18px;box-shadow:5px 6px 0 var(--neo-lilac)}
      .all-positions-panel>header{align-items:start;flex-direction:column}
      .all-positions-grid{grid-template-columns:1fr}
      .all-position-card{min-height:220px}
      .map.is-focused{border-radius:20px;box-shadow:6px 7px 0 var(--neo-pink)}
      .map.is-focused>header{align-items:flex-start;flex-direction:column;padding:22px 20px}
      .map.is-focused .map-reset{align-self:flex-start}
      .map.is-focused .lanes{padding:14px}
      .map.is-focused .evidence-card,.map.is-focused .evidence-card.selected{min-height:0;padding:22px 18px;border-width:2px}
      .map.is-focused .evidence-card>header{grid-template-columns:1fr;gap:10px}
      .map.is-focused .evidence-card>header small{width:max-content;text-align:left}
      .reasoning-path{border-width:2px;border-radius:20px;box-shadow:6px 7px 0 var(--neo-pink)}
      .reasoning-body>header{padding:24px 20px;border-bottom-width:2px}
      .reflection-progress{border-bottom-width:2px}
      .reflection-progress li{padding:14px;border-right-width:2px}
      .reflection-stage{margin:12px;padding:20px 16px;border-width:2px;box-shadow:4px 5px 0 var(--neo-lilac)}
      .reflection-stage>header{grid-template-columns:auto minmax(0,1fr);gap:14px}
      .reflection-stage>header>b{grid-column:2;width:max-content}
      .reflection-grid{gap:12px;margin:0 12px}
      .reflection-grid>.reflection-stage{margin:0}
      .reflection-stage--evidence{box-shadow:4px 5px 0 var(--neo-yellow)}
      .reflection-stage--stance{box-shadow:4px 5px 0 var(--neo-lilac)}
      .reflection-stage--question{box-shadow:4px 5px 0 var(--neo-teal)}
      .own-question{grid-template-columns:1fr;padding:14px}
      .inquiry-trail{margin:12px;padding:22px 16px;border-width:2px;border-radius:18px;box-shadow:4px 5px 0 var(--neo-yellow)}
      .inquiry-trail>header{grid-template-columns:1fr;gap:20px;align-items:start}
      .trail-actions{width:100%;min-width:0}
      .trail-data-actions{justify-content:flex-start}
      .trail-progress{width:100%;min-width:0;text-align:left}
      .trail-summary{grid-template-columns:1fr}
      .trail-summary article.trail-summary-question{grid-column:1}
      .trail-next{align-items:flex-start;flex-direction:column}
      .trail-actions>button{justify-self:start}
      .learning-guide{padding:26px 20px;border-width:2px;border-radius:20px;box-shadow:6px 7px 0 var(--neo-ink)}
      .learning-guide>header{border-bottom-width:2px}
      .concept-grid article{border-width:2px}
      .map .lanes{padding:9px;border-width:2px;border-radius:20px;box-shadow:5px 6px 0 var(--neo-pink)}
      .reasoning-decision>article,.reasoning-decision>article:first-child,.stance-builder,.own-question,.inquiry-trail{border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .comparison-row,.contribution-page-head aside,.contribution-stage,.about-grid section,.about-grid section:nth-child(2n),.about-grid section:nth-last-child(-n+2){border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .about-footer{gap:24px;padding:24px 20px;border-width:2px;box-shadow:6px 7px 0 var(--neo-ink)}
      .about-footer-copy>h2{margin-top:0;font-size:42px}
      .about-footer>.about-footer-actions{grid-template-columns:1fr;align-items:stretch}
      .about-footer .about-footer-actions button{width:100%}
      .about-footer .about-footer-actions button{min-height:94px}
      .compare-question-strip{padding:16px;border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .compare-question-strip nav{grid-template-columns:1fr}
      .contribution-stage{padding:24px 18px}
      .record-history{grid-template-columns:1fr;padding:22px 18px}
      .record-history li{grid-template-columns:1fr;gap:10px}
      .question-heading-selector>.question-panel .search-shell{padding:14px 16px 0}
      .question-heading-selector>.question-panel nav{padding:14px 16px 20px}
      .question-heading-selector>.question-panel .question-tab,
      .question-heading-selector>.question-panel .question-tab:nth-child(n){grid-template-columns:38px minmax(0,1fr) 38px;gap:11px;min-height:72px;padding:12px}
      .question-heading-selector>.question-panel .question-tab>span,
      .question-heading-selector>.question-panel .question-tab>i{width:34px;height:34px}
      .question-heading-selector>.question-panel .question-tab b{font-size:18px}
      .question-heading-selector>.question-panel .search-results{left:16px;right:16px;padding:10px}
      .question-heading-selector>.question-panel .search-results :global(button){grid-template-columns:minmax(0,1fr) 38px;grid-template-rows:auto auto auto;gap:6px 12px;min-height:0;padding:15px}
      .question-heading-selector>.question-panel .search-results :global(small){grid-column:1;grid-row:1;font-size:11px}
      .question-heading-selector>.question-panel .search-results :global(span){grid-column:1;grid-row:2}
      .question-heading-selector>.question-panel .search-results :global(b){grid-column:1;grid-row:3;font-size:15px}
      .question-heading-selector>.question-panel .search-results :global(i){grid-column:2;grid-row:1/-1;width:38px;height:38px}
      .contribution-page-head aside .contribution-question-toggle{grid-template-columns:1fr;gap:14px}
      .contribution-page-head aside .contribution-question-toggle strong{font-size:clamp(28px,8.5vw,38px);line-height:1.02;white-space:normal}
      .contribution-page-head aside .contribution-question-toggle>span{padding-bottom:0}
      .inspector,.nav-collapsed .inspector{border-width:2px;box-shadow:none}
      .inspector-details{display:grid;gap:10px}
    }

    /* Explore page: one linear question -> positions -> source -> comparison -> reflection journey. */
    .question-view>.public-position-grid,
    .question-view>.learning-guide,
    .question-view>.map,
    .question-view>.quiet-contribution,
    .question-view>.reasoning-path{display:none!important}
    .question-view{
      width:min(1280px,100%);
      margin:0 auto;
      padding:18px clamp(20px,4vw,58px) 96px;
    }
    .question-view>.public-question-intro{
      display:grid!important;
      grid-template-columns:minmax(0,1fr);
      gap:14px;
      align-items:center;
      margin:0 0 18px;
      text-align:left;
    }
    .public-question-intro h1{width:100%;margin:0}
    .public-question-intro .question-title-selector{
      display:grid;
      grid-template-columns:minmax(0,1fr) 54px;
      align-items:stretch;
      width:100%;
      max-width:100%;
      min-height:62px;
      padding:0;
      overflow:hidden;
      border:var(--neo-line);
      border-radius:14px;
      background:var(--neo-yellow);
      color:var(--neo-ink);
      box-shadow:5px 6px 0 var(--neo-ink);
      text-align:left;
    }
    .public-question-intro .question-title-selector[data-question-id="judgment"]{background:var(--neo-teal)}
    .public-question-intro .question-title-selector[data-question-id="governance"]{background:var(--neo-lilac)}
    .public-question-intro .question-title-selector>span{display:block;min-height:0;padding:15px 18px;background:transparent;font:850 clamp(22px,2.4vw,32px)/1 var(--sans);letter-spacing:-.035em;white-space:nowrap}
    .public-question-intro .question-title-selector>i{display:grid;width:auto;height:auto;place-items:center;border:0;border-left:var(--neo-line);border-radius:0;background:var(--neo-ink);color:#fff;box-shadow:none}
    .public-question-intro .question-title-selector svg{width:21px;fill:none;stroke:currentColor;stroke-width:2}
    .public-question-intro .question-title-selector:hover,.public-question-intro .question-title-selector:focus-visible{outline:none;transform:translate(-2px,-2px);box-shadow:7px 8px 0 var(--neo-ink)}
    .public-question-intro>p{grid-column:1/-1;max-width:68ch;margin:4px 4px 0;font:650 16px/1.48 var(--sans)}
    .explore-question-context{
      display:grid;
      grid-template-columns:minmax(0,1.45fr) minmax(340px,.55fr);
      gap:clamp(40px,5vw,86px);
      align-items:center;
      margin-top:18px;
      padding:30px 36px;
      border:var(--neo-line);
      border-radius:22px;
      background:#fff;
      box-shadow:7px 8px 0 var(--neo-ink);
    }
    .explore-question-context h2{max-width:18ch;margin:0;font:850 clamp(36px,4.1vw,60px)/.94 var(--sans);letter-spacing:-.055em;text-wrap:balance}
    .explore-question-context p{max-width:42ch;margin:0;font:650 17px/1.45 var(--sans);text-wrap:pretty}
    .explore-lenses{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:14px;
      margin-top:34px;
    }
    .explore-lenses button{
      min-height:78px;
      padding:18px 20px;
      border:var(--neo-line);
      border-radius:15px;
      background:var(--neo-teal);
      color:var(--neo-ink);
      font:800 17px/1.2 var(--sans);
      text-align:left;
      box-shadow:5px 6px 0 var(--neo-ink);
      cursor:pointer;
      transition:transform .16s ease,box-shadow .16s ease;
    }
    .explore-lenses button:nth-child(2){background:var(--neo-orange)}
    .explore-lenses button:nth-child(3){background:var(--neo-yellow)}
    .explore-lenses button:hover,.explore-lenses button:focus-visible,.explore-lenses button.active{outline:none;transform:translate(-2px,-2px);box-shadow:8px 9px 0 var(--neo-ink)}
    .explore-lenses button.active{box-shadow:inset 0 0 0 4px #fff,7px 8px 0 var(--neo-ink)}
    .explore-focus{
      box-sizing:border-box;
      display:grid;
      grid-template-columns:minmax(0,1fr) auto;
      gap:34px;
      align-items:center;
      height:184px;
      margin-top:18px;
      padding:28px 30px;
      border:var(--neo-line);
      border-radius:18px;
      background:var(--neo-soft-lilac);
      box-shadow:6px 7px 0 var(--neo-ink);
    }
    .explore-focus h2{margin:0;font:850 clamp(28px,3vw,42px)/1 var(--sans);letter-spacing:-.04em}
    .explore-focus p{max-width:74ch;margin:12px 0 0;font:600 15px/1.5 var(--sans)}
    .explore-focus button,.explore-starters>header button,.explore-compare button{
      min-height:52px;
      padding:0 16px;
      border:2px solid var(--neo-ink);
      border-radius:10px;
      background:#fff;
      color:var(--neo-ink);
      font:800 13px var(--sans);
      box-shadow:3px 4px 0 var(--neo-ink);
      cursor:pointer;
    }
    .explore-starters{
      overflow:hidden;
      margin-top:34px;
      border:var(--neo-line);
      border-radius:22px;
      background:#fff;
      box-shadow:7px 8px 0 var(--neo-ink);
    }
    .explore-starters>header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:24px 26px;border-bottom:var(--neo-line);background:var(--neo-pink)}
    .explore-starters>header h2{margin:0;font:850 clamp(29px,3vw,42px)/1 var(--sans);letter-spacing:-.04em}
    .explore-position-list{display:grid}
    .explore-position-row{
      display:grid;
      grid-template-columns:minmax(170px,.55fr) minmax(300px,1.75fr) auto;
      gap:28px;
      align-items:center;
      width:100%;
      min-height:138px;
      padding:22px 26px;
      border:0;
      border-bottom:2px solid var(--neo-ink);
      background:#fff;
      color:var(--neo-ink);
      font-family:var(--sans);
      text-align:left;
      cursor:pointer;
      transition:padding .16s ease,background .16s ease;
    }
    .explore-position-row:last-child{border-bottom:0}
    .explore-position-row:hover,.explore-position-row:focus-visible,.explore-position-row.active{outline:none;padding-left:34px;background:var(--neo-soft-yellow)}
    .explore-position-row--agreement:hover,.explore-position-row--agreement:focus-visible,.explore-position-row--agreement.active{background:var(--neo-soft-teal)}
    .explore-position-row--disagreement:hover,.explore-position-row--disagreement:focus-visible,.explore-position-row--disagreement.active{background:var(--neo-soft-pink)}
    .explore-position-row--uncertainty:hover,.explore-position-row--uncertainty:focus-visible,.explore-position-row--uncertainty.active{background:var(--neo-soft-yellow)}
    .explore-position-row>span:first-child{display:grid;gap:8px}
    .explore-position-row b{font:800 15px/1.2 var(--sans)}
    .explore-position-row small{font:650 11px/1.25 var(--sans)}
    .explore-position-row strong{display:block;font:850 clamp(20px,2vw,28px)/1.08 var(--sans);letter-spacing:-.03em}
    .explore-position-row p{max-width:65ch;margin:8px 0 0;font:600 13px/1.45 var(--sans)}
    .explore-position-row>span:last-child{display:flex;align-items:center;gap:12px;font:800 12px/1 var(--sans);white-space:nowrap}
    .explore-position-row>span:last-child i{font:900 20px/1 var(--sans);font-style:normal}
    .explore-compare{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:28px;
      margin-top:34px;
      padding:26px 30px;
      border:var(--neo-line);
      border-radius:18px;
      background:var(--neo-teal);
      box-shadow:6px 7px 0 var(--neo-ink);
    }
    .explore-compare p{display:grid;gap:7px;margin:0}
    .explore-compare strong{font:850 clamp(25px,2.5vw,36px)/1 var(--sans);letter-spacing:-.035em}
    .explore-compare span{max-width:62ch;font:600 14px/1.4 var(--sans)}
    .explore-compare button{background:var(--neo-yellow);white-space:nowrap}
    .explore-reflection{
      margin-top:34px;
      padding:26px;
      border:var(--neo-line);
      border-radius:20px;
      background:var(--neo-lilac);
      box-shadow:7px 8px 0 var(--neo-ink);
    }
    .explore-reflection>header{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.72fr);gap:30px;align-items:end;margin-bottom:20px}
    .explore-reflection>header h2{margin:0;font:850 clamp(34px,4vw,54px)/.95 var(--sans);letter-spacing:-.05em}
    .explore-reflection>header p{max-width:46ch;margin:0;font:650 14px/1.45 var(--sans)}
    .explore-reflection>div{display:grid;gap:10px}
    .explore-reflection details{overflow:hidden;border:2px solid var(--neo-ink);border-radius:13px;background:#fff;box-shadow:4px 5px 0 var(--neo-ink)}
    .explore-reflection summary{display:flex;min-height:58px;align-items:center;justify-content:space-between;gap:20px;padding:14px 17px;background:var(--neo-yellow);font:800 16px/1.25 var(--sans);cursor:pointer;list-style:none}
    .explore-reflection summary::-webkit-details-marker{display:none}
    .explore-reflection summary b{font:inherit}
    .explore-reflection details[open] summary{border-bottom:2px solid var(--neo-ink)}
    .explore-reflection details[open] summary span{transform:rotate(45deg)}
    .explore-reflection .stance-builder{padding:18px}
    .explore-reflection .stance-builder>div{display:flex;flex-wrap:wrap;gap:9px}
    .explore-reflection .stance-builder button,.explore-evidence-test button{
      min-height:44px;
      padding:0 13px;
      border:2px solid var(--neo-ink);
      border-radius:9px;
      background:#fff;
      color:var(--neo-ink);
      font:800 13px var(--sans);
      cursor:pointer;
    }
    .explore-reflection .stance-builder button:hover,.explore-reflection .stance-builder button.selected,.explore-evidence-test button:hover,.explore-evidence-test button.selected{background:var(--neo-teal);box-shadow:3px 4px 0 var(--neo-ink);transform:translate(-1px,-1px)}
    .explore-reflection .stance-builder [data-stance-feedback]{margin:16px 0 0;font:700 13px/1.4 var(--sans)}
    .explore-evidence-test{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:22px;align-items:center;padding:18px}
    .explore-evidence-test p{margin:0;font:650 14px/1.45 var(--sans)}
    .explore-evidence-test>div{display:flex;gap:8px}
    .explore-next-question{display:grid;grid-template-columns:200px minmax(0,1fr);gap:16px;align-items:center;padding:18px;font:800 13px var(--sans)}
