      .public-question-intro .question-title-selector>span{padding:14px;font-size:clamp(20px,6.6vw,28px);white-space:normal;text-wrap:balance}
      .public-question-intro .question-title-selector>i{border-left-width:2px}
      .explore-question-context{padding:24px 20px;border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .explore-question-context h2{font-size:38px}
      .explore-lenses{grid-template-columns:1fr;gap:10px}
      .explore-lenses button{min-height:58px;border-width:2px}
      .explore-focus{grid-template-columns:1fr;height:360px;padding:22px 18px;border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .explore-focus button{justify-self:start}
      .explore-starters{border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .explore-starters>header{align-items:flex-start;flex-direction:column;padding:20px 18px;border-bottom-width:2px}
      .explore-position-row{grid-template-columns:1fr;gap:10px;min-height:0;padding:20px 18px}
      .explore-position-row:hover,.explore-position-row:focus-visible,.explore-position-row.active{padding-left:24px}
      .explore-position-row>span:last-child{grid-column:1}
      .explore-compare{align-items:flex-start;flex-direction:column;padding:22px 18px;border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .explore-reflection{padding:22px 18px;border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .explore-reflection .stance-builder>div,.explore-evidence-test>div{display:grid;grid-template-columns:1fr}
      .explore-next-question{grid-template-columns:1fr;padding:16px}
      .people-view,.person-follow-view{padding:20px 16px 70px}
      .people-page-head{padding:25px 20px;border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .people-page-head h1{font-size:50px}
      .people-directory{gap:34px;margin-top:32px}
      .people-group>header>div{align-items:flex-start;flex-direction:column;gap:5px}
      .people-group>header h2{font-size:26px}
      .people-question-toggle{grid-template-columns:minmax(0,1fr) 44px;border-width:2px;box-shadow:4px 5px 0 var(--neo-ink)}
      .people-card{grid-template-columns:52px minmax(0,1fr) 40px;gap:13px;min-height:116px;padding:17px;border-width:2px;box-shadow:4px 5px 0 var(--neo-ink)}
      .people-card>i{width:36px;height:36px}
      .person-profile-head{grid-template-columns:74px minmax(0,1fr);gap:18px;padding:24px 20px;border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .person-profile-head>span{width:70px;font-size:20px}
      .person-profile-head h1{font-size:clamp(40px,12vw,58px)}
      .person-profile-head p{font-size:15px}
      .person-contributions{border-width:2px;box-shadow:5px 6px 0 var(--neo-ink)}
      .person-contributions>header{padding:23px 18px;border-bottom-width:2px}
      .person-position{grid-template-columns:1fr;gap:13px;min-height:0;padding:21px 18px}
      .person-position:hover,.person-position:focus-visible{padding-left:24px}
      .person-position>span:last-child{grid-column:1;justify-content:flex-start}
    }

    /* The Explore content stays out of view until a visitor chooses a route. */
    .workspace.journey-pending{
      grid-template-rows:minmax(0,1fr)!important;
      background:var(--neo-paper)!important;
    }
    .workspace.journey-pending>.topbar{display:none!important}
    .journey-return{display:none}
    .workspace.journey-pending>.journey-return{
      display:inline-flex;
      position:fixed;
      z-index:120;
      top:22px;
      left:24px;
      align-items:center;
      gap:10px;
      min-height:48px;
      padding:0 17px;
      border:2px solid var(--neo-ink);
      border-radius:11px;
      background:#fff;
      color:var(--neo-ink);
      box-shadow:4px 5px 0 var(--neo-ink);
      font:850 13px var(--sans);
      text-decoration:none;
    }
    .workspace.journey-pending>.journey-return:hover,
    .workspace.journey-pending>.journey-return:focus-visible{outline:none;transform:translate(-2px,-2px);box-shadow:6px 7px 0 var(--neo-ink)}
    .workspace.journey-pending>.workgrid{display:none!important}
    .workspace:not(.journey-pending)>.journey-onboarding{display:none}
    .journey-onboarding{
      min-height:0;
      overflow:auto;
      color:var(--neo-ink);
      background:
        radial-gradient(circle at 2% 8%,var(--neo-soft-pink) 0 180px,transparent 181px),
        radial-gradient(circle at 100% 92%,var(--neo-soft-lilac) 0 220px,transparent 221px),
        var(--neo-paper);
    }
    .journey-onboarding-shell{
      box-sizing:border-box;
      width:min(1280px,100%);
      margin:0 auto;
      padding:46px clamp(20px,4vw,58px) 74px;
    }
    .journey-onboarding-shell>header{
      display:grid;
      grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);
      gap:52px;
      align-items:end;
      margin-bottom:30px;
    }
    .journey-onboarding-shell>header h1{
      max-width:10ch;
      margin:0;
      font:850 clamp(52px,7vw,94px)/.88 var(--sans);
      letter-spacing:-.065em;
    }
    .journey-onboarding-shell>header p{
      max-width:48ch;
      margin:0;
      font:650 17px/1.5 var(--sans);
    }
    .journey-tutorial{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:14px;
      margin:0 0 38px;
      padding:0;
      list-style:none;
    }
    .journey-tutorial li{
      display:grid;
      grid-template-columns:46px minmax(0,1fr);
      gap:16px;
      min-height:132px;
      padding:22px;
      border:var(--neo-line);
      border-radius:18px;
      background:var(--neo-soft-teal);
      box-shadow:5px 6px 0 var(--neo-ink);
    }
    .journey-tutorial li:nth-child(2){background:var(--neo-soft-pink)}
    .journey-tutorial li:nth-child(3){background:var(--neo-soft-yellow)}
    .journey-tutorial li>span{
      display:grid;
      width:42px;
      height:42px;
      place-items:center;
      border:2px solid var(--neo-ink);
      border-radius:50%;
      background:#fff;
      font:850 15px var(--sans);
    }
    .journey-tutorial h2{margin:2px 0 9px;font:850 20px/1.05 var(--sans);letter-spacing:-.025em}
    .journey-tutorial p{margin:0;font:600 13px/1.45 var(--sans)}
    .journey-builder{
      display:grid;
      grid-template-columns:minmax(0,1fr) minmax(0,1fr);
      gap:18px;
    }
    .journey-builder>section{
      padding:28px;
