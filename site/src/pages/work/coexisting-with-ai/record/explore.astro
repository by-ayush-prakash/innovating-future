      background:var(--neo-ink);
      box-shadow:none;
    }
    .map.is-focused .lane.is-focused{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:18px;
      max-width:none;
      min-height:0;
      padding:0;
      border:0;
      border-radius:0;
      background:transparent;
    }
    .map.is-focused .lane-name{
      grid-column:1/-1;
      width:max-content;
      margin:0 0 2px;
      padding:9px 12px;
      border:2px solid #fff;
      border-radius:10px;
      background:var(--focus-accent);
      box-shadow:3px 4px 0 #fff;
    }
    .map.is-focused .lane-name i{width:9px;height:9px;background:var(--neo-ink)}
    .map.is-focused .lane-name b{font:850 14px/1 var(--sans)}
    .map.is-focused .evidence-card,.map.is-focused .evidence-card.selected{
      min-height:340px;
