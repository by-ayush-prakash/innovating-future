    .atlas-search-button{
      margin-left:4px;
      padding-left:0;
      width:40px;
      border:2px solid var(--neo-ink);
      border-radius:10px;
      background:#fff;
      box-shadow:3px 4px 0 var(--neo-ink);
    }
    .atlas-search-button:hover{background:var(--neo-pink);transform:translate(-1px,-1px)}

    .site-exit-dialog{
      width:min(600px,calc(100vw - 40px));
      overflow:visible;
      border:var(--neo-line);
      border-radius:22px;
      background:#fff;
