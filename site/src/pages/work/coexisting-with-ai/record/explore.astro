    .concept-grid article:nth-child(1){background:var(--neo-soft-teal)}
    .concept-grid article:nth-child(2){background:var(--neo-soft-lilac)}
    .concept-grid article:nth-child(3){background:var(--neo-soft-yellow)}
    .concept-grid article:nth-child(4){background:var(--neo-soft-pink)}
    .concept-grid article>span{color:var(--neo-ink);font-weight:800}
