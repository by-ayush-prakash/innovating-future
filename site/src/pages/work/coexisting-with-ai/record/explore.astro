    .map.is-focused .evidence-card:hover,.map.is-focused .evidence-card:focus-visible,.map.is-focused .evidence-card.selected:hover{
      border-color:var(--neo-ink);
      background:#fff;
      box-shadow:9px 10px 0 var(--focus-accent);
      transform:translate(-3px,-3px);
    }
    .map.is-focused .evidence-card>header{
      display:grid;
      grid-template-columns:minmax(0,1fr) auto;
      gap:16px;
      align-items:start;
    }
    .map.is-focused .evidence-card>header span{font:850 18px/1.2 var(--sans)}
    .map.is-focused .evidence-card>header small{
      margin:0;
      padding:6px 9px;
      border:2px solid var(--neo-ink);
      border-radius:8px;
      background:var(--focus-accent);
      color:var(--neo-ink);
      box-shadow:2px 3px 0 var(--neo-ink);
