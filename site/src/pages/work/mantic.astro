---
import Base from "../../layouts/Base.astro";
import { MANTIC } from "../../config";
---
<Base
  title={MANTIC.name}
  description="CIF's independent press. Books about the ideas changing what it means to be human."
>
  <div class="wrap phead">
    <h1>{MANTIC.name}.</h1>
    <p class="sub">
      CIF's independent press. An outlet for arguments too long for an essay and too witty
      for a textbook.
    </p>
  </div>

  <section>
    <div class="wrap">
      <div class="shead"><h2>What Mantic looks for.</h2></div>
      <div class="prin">
        <div class="pr">
          <h3>Ideas that demand permanence.</h3>
          <p>An argument that will still be worth reading in ten years, not a thesis timed to a news cycle.</p>
        </div>
        <div class="pr">
          <h3>Authors willing to be held to them.</h3>
          <p>A book is a position with a name on it. Mantic publishes people who intend to defend theirs.</p>
        </div>
        <div class="pr">
          <h3>Subjects that change what being human means.</h3>
          <p>Technology, cognition, money, attention. The forces that alter people before anyone votes on them.</p>
        </div>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="shead">
        <h2>The list.</h2>
        <a class="pill pill--ghost" href="/books">All books &rsaquo;</a>
      </div>
      <div class="rows">
        <a class="row" href="/books">
          <span class="mono">2024</span>
          <div>
            <h3>AI for Gen Z</h3>
            <span class="attrib">Ayush Prakash</span>
          </div>
          <span class="src">Published &rsaquo;</span>
        </a>
        <a class="row" href="/books">
          <span class="mono">Nov 2026</span>
          <div>
            <h3>The Transcendence of Money</h3>
            <span class="attrib">Ayush Prakash</span>
          </div>
          <span class="src">Forthcoming &rsaquo;</span>
        </a>
      </div>
      <p class="dnote">
        Mantic is building its own home at
        <a href={MANTIC.url} target="_blank" rel="noopener noreferrer">manticpublishing.com</a>.
      </p>
    </div>
  </section>
</Base>
