---
import Base from "../../layouts/Base.astro";
import { MANTIC, ORG } from "../../config";
---
<Base
  title={MANTIC.name}
  description="The Center's press. A wholly owned imprint publishing books that break the mainstream narrative."
>
  <header class="phero field field--sand">
    <span class="orb orb--a" aria-hidden="true"></span>
    <span class="orb orb--c" aria-hidden="true"></span>
    <div class="wrap">
      <div>
        <p class="kick kick--amber">The Center's press</p>
        <h1>Mantic Publishing.</h1>
        <p class="lede">Books that break the mainstream narrative. Mantic breaks and builds the
        idea with the author until the argument holds.</p>
        <div class="cta">
          <a class="pill pill--solid" href={MANTIC.url} target="_blank" rel="noopener">Visit Mantic &rsaquo;</a>
        </div>
      </div>
    </div>
  </header>

  <section>
    <div class="wrap">
      <p class="lede">
        A strategy lab produces briefings, assessments and sessions. All of it is built to be useful
        inside a particular year. Some arguments are not that shape. They need the length of a book
        and the patience of an editor, and they need to survive long after the cycle that produced
        them. Mantic exists for those. It is a separate company, wholly owned by the Center, with
        its own editorial line and its own front door at
        <a href={MANTIC.url} target="_blank" rel="noopener noreferrer">manticpublishing.com</a>.
      </p>
    </div>
  </section>

  <section class="closeband field field--cool">
    <span class="orb orb--a orb--cool-a" aria-hidden="true"></span>
    <span class="orb orb--b orb--cool-b" aria-hidden="true"></span>
    <div class="wrap">
      <p class="kick kick--cool">For writers</p>
      <h2>Send Mantic something it can argue with.</h2>
      <p>
        Submissions, standards and the current list live at
        <a href={MANTIC.url} target="_blank" rel="noopener noreferrer" style="border-bottom:1px solid rgba(46,67,114,.4)">manticpublishing.com</a>.
        Anything for the Center itself goes to
        <a href={"mailto:" + ORG.email} style="border-bottom:1px solid rgba(46,67,114,.4)">{ORG.email}</a>.
      </p>
      <a class="pill pill--slate" href={MANTIC.url} target="_blank" rel="noopener">Visit Mantic &rsaquo;</a>
    </div>
  </section>
</Base>
