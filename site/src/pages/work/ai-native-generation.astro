---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
---
<Base
  title="The First AI-Native Generation"
  description="The First AI-Native Generation is a Center for Innovating the Future research project currently in development."
  cta={false}
>
  <PageHead photo="/images/first-ai-native-generation.jpg" alt="A model brain on a yellow grid, marked by a cursor and a red dot" id="an">
    The First <span style="white-space:nowrap">AI-Native</span> Generation.
    <p slot="lede" class="lede">
      A Center for Innovating the Future research project currently in development.
      The corpus, source review, methodology and publication format are still being completed.
    </p>
  </PageHead>

  <section class="sec">
    <div class="wrap">
      <div class="holding">
        <span class="mono">Work in progress</span>
        <h2>The evidence is not ready for publication.</h2>
        <p>
          CIF will publish the project when its source record, limitations and review process
          are ready for public inspection. Working interview counts, provisional claims and
          internal analysis are not public findings and should not be cited as such.
        </p>
      </div>
    </div>
  </section>

  <style>
    .holding{display:grid;grid-template-columns:minmax(0,.5fr) minmax(0,1fr) minmax(280px,.75fr);gap:clamp(28px,5vw,72px);align-items:start;border-top:2px solid transparent;border-image:linear-gradient(to right,#DE3A11,#C67E16,#1C6E63) 1;padding-top:clamp(28px,3.4vw,44px)}
    .holding h2{font-size:clamp(32px,4.6vw,62px);line-height:1.05;max-width:13ch}
    .holding p{color:var(--mut);font-size:17px;line-height:1.65;max-width:48ch}
    @media(max-width:900px){.holding{grid-template-columns:1fr}.holding h2{max-width:16ch}}
  </style>
</Base>
