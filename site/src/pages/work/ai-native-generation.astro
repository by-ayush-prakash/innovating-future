---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import SubNav from "../../components/SubNav.astro";

const voices = [
  { n: "01", h: "AI and machine-learning researchers", p: "The capabilities, limits and unresolved technical questions inside current systems." },
  { n: "02", h: "Researchers of mind and behaviour", p: "Cognition, neuroscience, psychology, intelligence, consciousness and human judgment." },
  { n: "03", h: "Educators and learning researchers", p: "How people learn, build skill, verify information and work with automated assistance." },
  { n: "04", h: "Philosophers, ethicists and critics", p: "The assumptions beneath AI development and the human values placed at risk." },
  { n: "05", h: "Policymakers and legal scholars", p: "Accountability, public institutions, regulation, rights and the distribution of power." },
  { n: "06", h: "Builders, founders and operators", p: "What happens when AI leaves the laboratory and enters products, workplaces and essential systems." },
];

const map = [
  { h: "Agreement", p: "Where conversations from different fields repeatedly arrive at the same position." },
  { h: "Disagreement", p: "Where researchers, policymakers, builders and critics divide, and why." },
  { h: "Uncertainty", p: "Where the archive cannot support a firm conclusion or important evidence is still missing." },
  { h: "Change", p: "How the record and CIF’s analysis develop as new conversations and evidence are added." },
];

const evidencePath = [
  { n: "01", h: "Conversation", p: "A published long-form interview enters the source record." },
  { n: "02", h: "Passage", p: "Relevant statements are preserved with their transcript, timestamp and surrounding exchange." },
  { n: "03", h: "Comparison", p: "CIF compares the position with related arguments, disagreements and evidence across the archive." },
  { n: "04", h: "Conclusion", p: "CIF publishes its analysis with a visible path back to every source that informed it." },
];

const sections = [
  { label: "Goal", href: "#goal" },
  { label: "Who informs it", href: "#voices" },
  { label: "How it works", href: "#method" },
  { label: "Public result", href: "#result" },
  { label: "Status", href: "#status" },
];
---
<Base
  title="The First AI-Native Generation"
  description="CIF’s living, source-linked analysis of agreement, disagreement and uncertainty across its public podcast archive."
  cta={false}
>
  <PageHead photo="/images/first-ai-native-generation.jpg" alt="A model brain on a yellow grid, marked by a cursor and a red dot" id="an">
    The First <span style="white-space:nowrap">AI-Native</span> Generation.
    <p slot="lede" class="lede">
      A living, source-linked analysis of what CIF’s public conversations collectively reveal about
      AI and human life. The project is currently in development; its evidence and findings are not yet published.
    </p>
  </PageHead>

  <SubNav items={sections} />

  <section class="sec" id="goal">
    <div class="wrap">
      <div class="intro">
        <h3>Make the archive understandable as a whole.</h3>
        <div class="body">
          <p>A single podcast episode can explain one person’s position. Understanding the field requires a listener to watch the entire archive, compare different definitions and assumptions, and reach conclusions across conversations that may never directly answer one another.</p>
          <p>This project performs that synthesis. CIF analyzes its published conversations, identifies recurring positions, disagreements and unresolved questions, and develops its own conclusions from the record.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--g" id="voices">
    <div class="wrap">
      <div class="shead"><h3>Who informs the project.</h3></div>
      <div class="nums">
        {voices.map((v) => (
          <div class="nrow"><span class="n">{v.n}</span><h4>{v.h}</h4><p>{v.p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="method">
    <div class="wrap">
      <div class="shead"><h3>Every conclusion will have a visible path back to the conversation.</h3></div>
      <div class="result-grid evidence-path">
        {evidencePath.map((item) => (
          <article><span class="mono">{item.n}</span><h4>{item.h}</h4><p>{item.p}</p></article>
        ))}
      </div>
      <div class="intro compact">
        <h3>Context remains attached.</h3>
        <div class="body">
          <p>Each published conclusion will link to the relevant transcript passage, exact video timestamp and surrounding exchange. Readers can inspect what was said before assessing CIF’s interpretation.</p>
          <p>Those links make the context and reasoning auditable. They do not prevent disagreement with CIF’s analysis, and the report will distinguish a source’s words from CIF’s conclusions.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="result">
    <div class="wrap">
      <div class="shead"><h3>The result will be an explorable evidence map.</h3></div>
      <div class="result-grid">
        {map.map((m, i) => (
          <article><span class="mono">{String(i + 1).padStart(2, "0")}</span><h4>{m.h}</h4><p>{m.p}</p></article>
        ))}
      </div>
      <div class="reader">
        <div><span class="mono">Designed for public use</span><h3>Accessible to the generations it describes.</h3></div>
        <div class="body">
          <p>The First AI-Native Generation report should be accessible to the first AI-native generations. A reader should be able to choose a question, understand CIF’s conclusion, see where the archive agrees or divides, and inspect why.</p>
          <p>Researchers, policymakers, journalists and organizational decision-makers will be able to open the underlying source, context, competing interpretation and revision history.</p>
          <p>The current analysis will update as conversations are added, corrected or withdrawn. Dated editions will preserve what the evidence supported at a specific moment.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--d" id="status">
    <div class="wrap">
      <div class="status">
        <span class="mono">Work in progress</span>
        <h2>The evidence is not ready for publication.</h2>
        <p>CIF is still completing the corpus, source review, methodology and publication format. Working interview counts, names, provisional claims and internal analysis are not public findings and should not be cited as such.</p>
      </div>
    </div>
  </section>

  <style>
    .result-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--hair);margin-bottom:clamp(58px,8vw,110px)}
    .result-grid article{padding:clamp(24px,3vw,38px);border-right:1px solid var(--hair);min-height:260px}
    .result-grid article:first-child{padding-left:0}.result-grid article:last-child{border-right:0;padding-right:0}
    .result-grid h4{font-size:clamp(24px,2.4vw,32px);margin:54px 0 14px}.result-grid p{color:var(--mut);font-size:14px;line-height:1.65}
    .reader{display:grid;grid-template-columns:1fr 1fr;gap:clamp(34px,7vw,110px);align-items:start;background:var(--sand);border-radius:var(--r);padding:clamp(30px,5vw,70px)}
    .reader h3{margin-top:14px;max-width:13ch}.status{display:grid;grid-template-columns:.45fr 1fr .8fr;gap:clamp(28px,5vw,72px);align-items:start}
    .evidence-path{margin-bottom:clamp(48px,7vw,86px)}.compact{padding-top:0}
    .status .mono{color:rgba(255,255,255,.55)}.status h2{font-size:clamp(32px,4.6vw,62px);line-height:1.05;font-weight:400;max-width:13ch}.status p{color:rgba(255,255,255,.65);font-size:17px;line-height:1.65;max-width:48ch}
    @media(max-width:900px){.result-grid{grid-template-columns:repeat(2,1fr)}.result-grid article:nth-child(2){border-right:0}.reader,.status{grid-template-columns:1fr}}
    @media(max-width:620px){.result-grid{grid-template-columns:1fr}.result-grid article,.result-grid article:first-child,.result-grid article:last-child{padding:24px 0;border-right:0;border-bottom:1px solid var(--hair);min-height:0}.result-grid h4{margin:24px 0 10px}.reader{padding:28px 22px}}
  </style>
</Base>
