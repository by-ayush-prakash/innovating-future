---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Arrow from "../../components/Arrow.astro";
import { ORG } from "../../config";
---
<Base title="Message sent" noindex={true} description="Your message reached the Center for Innovating the Future." cta={false}>
  <PageHead id="tk">
    Message sent.
    <p slot="lede" class="lede">
      It has reached the Center and will be read.
    </p>
  </PageHead>

  <section class="sec">
    <div class="wrap">
      <div class="cta">
        <a class="btn" href="/">Back to the homepage</a>
        <a class="btn btn--gh" href="/work">See our work</a>
      </div>
      <a class="go" href="/podcast" style="margin-top:40px">While you wait, the podcast <Arrow /></a>
    </div>
  </section>
</Base>
