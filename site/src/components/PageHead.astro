---
import Field from "./Field.astro";

/*
  Inner-page hero. Stacked, same as the homepage: H1, lede, buttons, image.

  It used to be a two-column split with the H1 bottom-aligned against the
  lede. That only holds when both columns are the same height, which they
  never are, so the headline sank to the bottom of a tall empty box. One
  stacked layout works at every copy length.

  No eyebrow. The heading carries the page.

  Props
    field   Field variant for the bleed image
    photo   path to a real photograph, used instead of field
    fit     "cover" (default) or "contain" for a document or screenshot
    alt     alt text for photo
  Slots
    aside     art that sits beside the copy, e.g. cover art
    media     anything to sit in the hero frame, instead of field/photo
    default   the H1 text
    lede      the paragraph under it
    cta       buttons under the lede
*/
const { field = null, photo = null, alt = "", id = "ph", fit = "cover" } = Astro.props;
const hasMedia = Astro.slots.has("media");
const hasAside = Astro.slots.has("aside");
---
<header class="ph-sec">
  <div class="wrap">
    <div class={hasAside ? "ph-split" : undefined}>
      <div>
        <h1 class="ph"><slot /></h1>
        <slot name="lede" />
        <slot name="cta" />
      </div>
      {hasAside && <div class="ph-aside"><slot name="aside" /></div>}
    </div>

    {hasMedia ? (
      <div class="bleed"><slot name="media" /></div>
    ) : (photo || field) && (
      <div class={fit === "contain" ? "bleed bleed--doc" : "bleed"}>
        {photo
          ? <img class="rn" src={photo} alt={alt} loading="eager" />
          : <Field v={field} id={id} w={2400} h={914} />}
      </div>
    )}
  </div>
</header>
