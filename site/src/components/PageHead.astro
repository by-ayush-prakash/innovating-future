---
import Marks from "./Marks.astro";
const { art = null, hue = null, tone = null } = Astro.props;
---
<header class={tone ? `phead phead--${tone}` : "phead"} style={hue ? `--phead-hue:${hue}` : undefined}>
  <div class="wrap pheadin">
    <h1><slot /></h1>
    {art && (
      <div class="pha" aria-hidden="true">
        <Marks set={[{ name: art, pos: "hd" }]} />
      </div>
    )}
  </div>
</header>
