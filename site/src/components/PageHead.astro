---
// field: warm | cool | fresh | sand. kick: the hue class on the kicker rule.
const {
  hue = null,
  tone = null,
  field = "warm",
  kick = null,
  kicker = null,
} = Astro.props;
const kickClass = kick ? `kick kick--${kick}` : "kick";
---
<header class={`phero field field--${field}${tone ? ` phead--${tone}` : ""}`} style={hue ? `--phead-hue:${hue}` : undefined}>
  <span class="orb orb--a" aria-hidden="true"></span>
  <span class="orb orb--c" aria-hidden="true"></span>
  <div class="wrap">
    <div>
      {kicker && <p class={kickClass}>{kicker}</p>}
      <h1><slot /></h1>
      <slot name="lede" />
    </div>
  </div>
</header>
