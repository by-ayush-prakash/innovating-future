---
import Field from "./Field.astro";

/*
  Inner-page hero. Split grid: H1 left, lede and buttons right, then an
  optional 21:8 bleed image.

  No eyebrow. The heading carries the page.

  Props
    field   Field variant for the bleed image
    photo   path to a real photograph, used instead of field
    alt     alt text for photo
  Slots
    default   the H1 text
    lede      the paragraph on the right
    cta       buttons under the lede
*/
const { field = null, photo = null, alt = "", id = "ph" } = Astro.props;
const hasSide = Astro.slots.has("lede") || Astro.slots.has("cta");
---
<header class="ph-sec">
  <div class="wrap">
    <div class="ph-grid" style={hasSide ? undefined : "grid-template-columns:1fr"}>
      <h1 class="ph"><slot /></h1>
      {hasSide && (
        <div>
          <slot name="lede" />
          <slot name="cta" />
        </div>
      )}
    </div>

    {(photo || field) && (
      <div class="bleed">
        {photo
          ? <img class="rn" src={photo} alt={alt} loading="eager" />
          : <Field v={field} id={id} w={2400} h={914} />}
      </div>
    )}
  </div>
</header>
