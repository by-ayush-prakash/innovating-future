---
// Hand-drawn schematic diagrams. Blueprint register, never 3D illustration.
const { name } = Astro.props;
---
{name === "skepticism" && (
<svg width="216" height="112" viewBox="0 0 216 112" fill="none" role="img" aria-label="Schematic: two bodies of research feeding a single published instrument">
  <g stroke="#111110" stroke-opacity=".2"><rect x="16.5" y="20.5" width="60" height="72"/><rect x="139.5" y="20.5" width="60" height="72"/><path d="M77 56h62"/></g>
  <g stroke="#DE3A11"><rect x="86.5" y="40.5" width="43" height="31"/><path d="M108 40V24M108 72v16"/></g>
  <rect x="94" y="48" width="27" height="3" fill="#DE3A11"/><rect x="94" y="55" width="18" height="3" fill="#DE3A11" fill-opacity=".5"/><rect x="94" y="62" width="22" height="3" fill="#DE3A11" fill-opacity=".5"/>
  <g fill="#111110" fill-opacity=".22"><rect x="26" y="32" width="40" height="3"/><rect x="26" y="41" width="30" height="3"/><rect x="26" y="50" width="36" height="3"/><rect x="26" y="59" width="24" height="3"/><rect x="149" y="32" width="40" height="3"/><rect x="149" y="41" width="26" height="3"/><rect x="149" y="50" width="34" height="3"/><rect x="149" y="59" width="30" height="3"/></g>
  <circle cx="108" cy="24" r="4" fill="#DE3A11"/><circle cx="108" cy="88" r="4" fill="#DE3A11"/>
</svg>
)}
{name === "mantic" && (
<svg width="216" height="112" viewBox="0 0 216 112" fill="none" role="img" aria-label="Schematic: an open book with one line set in the accent colour">
  <g stroke="#111110" stroke-opacity=".2"><path d="M108 26v66"/><rect x="48.5" y="25.5" width="59" height="67"/><rect x="108.5" y="25.5" width="59" height="67"/></g>
  <path d="M48 26q30-14 60 0 30-14 60 0" stroke="#DE3A11"/>
  <g fill="#111110" fill-opacity=".2"><rect x="58" y="42" width="40" height="3"/><rect x="58" y="51" width="34" height="3"/><rect x="58" y="60" width="40" height="3"/><rect x="58" y="69" width="22" height="3"/><rect x="118" y="42" width="40" height="3"/><rect x="118" y="51" width="28" height="3"/><rect x="118" y="60" width="38" height="3"/></g>
  <rect x="118" y="69" width="30" height="3" fill="#DE3A11"/>
  <g stroke="#DE3A11" stroke-opacity=".55"><path d="M28 40v38M188 40v38"/></g>
  <circle cx="28" cy="34" r="3.5" fill="#DE3A11"/><circle cx="188" cy="34" r="3.5" fill="#DE3A11"/>
</svg>
)}
{name === "podcast" && (
<svg width="216" height="112" viewBox="0 0 216 112" fill="none" role="img" aria-label="Schematic: two speakers connected, waveform radiating outward">
  <g stroke="#111110" stroke-opacity=".18"><circle cx="66" cy="56" r="26"/><circle cx="150" cy="56" r="26"/><path d="M92 56h32"/></g>
  <circle cx="66" cy="56" r="9" fill="#DE3A11" fill-opacity=".16" stroke="#DE3A11"/><circle cx="150" cy="56" r="9" fill="#DE3A11" fill-opacity=".16" stroke="#DE3A11"/>
  <g stroke="#DE3A11"><path d="M22 46v20M30 38v36M38 50v12M46 42v28"/><path d="M170 42v28M178 50v12M186 38v36M194 46v20"/></g>
  <g stroke="#111110" stroke-opacity=".2"><path d="M100 44v24M108 38v36M116 48v16"/></g>
</svg>
)}
{name === "structure" && (
<svg width="216" height="112" viewBox="0 0 216 112" fill="none" role="img" aria-label="Schematic: three columns of differing height on a shared baseline">
  <g stroke="#111110" stroke-opacity=".16"><path d="M40 92V34M108 92V20M176 92V48M28 92h160"/></g>
  <g stroke="#DE3A11" stroke-dasharray="3 4"><path d="M40 34h68M108 20h68"/></g>
  <circle cx="40" cy="34" r="4.5" fill="#DE3A11"/><circle cx="108" cy="20" r="4.5" fill="#DE3A11"/><circle cx="176" cy="48" r="4.5" fill="#fff" stroke="#DE3A11"/>
  <rect x="60" y="60" width="96" height="1" fill="#111110" fill-opacity=".12"/><rect x="60" y="70" width="70" height="1" fill="#111110" fill-opacity=".12"/>
</svg>
)}
