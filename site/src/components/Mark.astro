---
/*
  The lockup IS the logo: an accent bracket around the name, nothing else.
  This is CIF's existing mark. Do not replace it with a symbol.

  stack  larger, for the footer
  light  white text, for dark grounds. The bracket stays accent.
*/
const { stack = false, light = false } = Astro.props;
const cls = ["brand", stack && "brand--stack", light && "brand--light"].filter(Boolean).join(" ");
---
<span class={cls}><slot /></span>
