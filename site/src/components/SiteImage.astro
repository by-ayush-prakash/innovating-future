---
import manifest from '../data/image-manifest.json';
const { src, width, height, loading = 'lazy', decoding = 'async', sizes = '(max-width: 900px) 100vw, 60vw', ...attributes } = Astro.props;
const image = manifest[src as keyof typeof manifest];
---
<img {...attributes} src={image?.src || src} srcset={image?.srcset} sizes={image ? sizes : undefined} width={width || image?.width} height={height || image?.height} loading={loading} decoding={decoding} />
