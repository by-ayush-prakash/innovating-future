---
import { ORG, SKEPTICISM, MANTIC, PODCAST, COPY } from "../config";
import Mark from "./Mark.astro";
import Field from "./Field.astro";

const year = 2026;

// Closing CTA. Every page gets one; pages override the words via props.
const {
  ctaHeading = "Work with the Center.",
  ctaBody = "Host institutions, researchers, and collaborators working on the same questions can reach the Center directly.",
  // One button, and it goes to the form. The address is deliberately not
  // published across the site; the form is the front door.
  ctaLabel = "Start a conversation",
  ctaHref = "/contact",
  // The field behind it. Pages set this so the closing band is not identical
  // on every page of the site.
  ctaField = "dark-violet",
  ctaLinks = null,
  cta = true,
} = Astro.props;

const cols = [
  {
    h: "What We Do",
    links: [
      { l: SKEPTICISM.name, u: SKEPTICISM.page },
      { l: "The Co-Existence Record", u: "/work/coexisting-with-ai/record/" },
      { l: MANTIC.name, u: MANTIC.page },
      { l: "All work", u: "/work" },
    ],
  },
  {
    h: "Resources",
    links: [
      { l: PODCAST.name, u: PODCAST.page },
      { l: "CIF In The Press", u: "/media" },
      { l: "CIF Before the Senate", u: "/senate-2017" },
    ],
  },
  {
    h: "About Us",
    links: [
      { l: "Team", u: "/team" },
      { l: "Careers", u: "/careers" },
      { l: "Contact", u: "/contact" },
    ],
  },
];
---
{cta && (
  <section class:list={["ctab", { "ctab--menu": ctaLinks?.length }]}>
    <div class="rnw"><Field v={ctaField} id="ctaf" w={2400} h={900} /></div>
    <div class="wrap">
      <h2>{ctaHeading}</h2>
      {ctaBody && <p>{ctaBody}</p>}
      {ctaLinks?.length ? (
        <div class="subscribe-menu" data-subscribe-menu>
          <button class="btn btn--w btn--lg subscribe-menu__trigger" type="button"
            aria-expanded="false" aria-controls="subscribe-platforms" data-subscribe-trigger>
            <span>{ctaLabel}</span>
            <span class="subscribe-menu__icon" aria-hidden="true"></span>
          </button>
          <div class="subscribe-menu__items" id="subscribe-platforms" data-subscribe-items>
            {ctaLinks.map((link: { href: string; icon: string; label: string }) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <span class={`subscribe-menu__brand subscribe-menu__brand--${link.icon}`} aria-hidden="true">
                  {link.icon === "youtube" && (
                    <svg viewBox="0 0 24 24">
                      <rect y="4.4" width="24" height="15.2" rx="4.2" fill="currentColor" />
                      <path d="M10 8.6l5.6 3.4L10 15.4V8.6Z" fill="#fff" />
                    </svg>
                  )}
                  {link.icon === "spotify" && (
                    <svg viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="12" fill="currentColor" />
                      <g stroke="#fff" stroke-linecap="round" fill="none">
                        <path d="M6.6 9.3c3.4-1 7.2-.7 10.3 1" stroke-width="2.1" />
                        <path d="M7.4 12.6c2.8-.8 5.9-.5 8.4.9" stroke-width="1.8" />
                        <path d="M8.2 15.7c2.2-.6 4.6-.4 6.6.7" stroke-width="1.5" />
                      </g>
                    </svg>
                  )}
                  {link.icon === "apple-podcasts" && (
                    <svg viewBox="0 0 24 24">
                      <rect width="24" height="24" rx="5.4" fill="currentColor" />
                      <g fill="#fff">
                        <circle cx="12" cy="9.1" r="2.15" />
                        <path d="M12 12.4c-1.55 0-2.6.8-2.6 1.85 0 .5.28 2.2.5 3.16.2.88.62 1.34 1.05 1.55.4.2 1.7.2 2.1 0 .43-.21.85-.67 1.05-1.55.22-.96.5-2.66.5-3.16 0-1.05-1.05-1.85-2.6-1.85Z" />
                        <path d="M12 3.9a5.6 5.6 0 0 0-3.5 9.97.72.72 0 0 0 .9-1.12A4.16 4.16 0 1 1 16.16 9.5c0 1.28-.58 2.44-1.5 3.2a.72.72 0 1 0 .9 1.13A5.6 5.6 0 0 0 12 3.9Z" />
                      </g>
                    </svg>
                  )}
                </span>
                <span>{link.label}</span>
                <span class="subscribe-menu__arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a class="btn btn--w btn--lg" href={ctaHref}>{ctaLabel}</a>
      )}
    </div>
  </section>
)}

{ctaLinks?.length && (
  <script is:inline>
    (() => {
      document.querySelectorAll('[data-subscribe-menu]').forEach((menu) => {
        const trigger = menu.querySelector('[data-subscribe-trigger]');
        const setOpen = (open) => {
          menu.classList.toggle('is-open', open);
          trigger?.setAttribute('aria-expanded', String(open));
        };

        menu.addEventListener('pointerenter', (event) => {
          if (event.pointerType !== 'mouse') return;
          trigger?.setAttribute('aria-expanded', 'true');
        });
        menu.addEventListener('pointerleave', (event) => {
          if (event.pointerType !== 'mouse') return;
          setOpen(false);
        });
        trigger?.addEventListener('click', () => {
          setOpen(!menu.classList.contains('is-open'));
        });
        document.addEventListener('click', (event) => {
          if (!menu.contains(event.target)) setOpen(false);
        });
        document.addEventListener('mousemove', (event) => {
          if (!menu.contains(event.target)) setOpen(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          setOpen(false);
          trigger?.focus();
        });
        menu.addEventListener('focusout', () => {
          window.setTimeout(() => {
            if (!menu.contains(document.activeElement)) setOpen(false);
          }, 0);
        });
      });
    })();
  </script>
)}

<footer class="site">
  <div class="wrap">
    <div class="fgrid">
      <div>
        <a class="fmark" href="/"><Mark stack={true} light={true}>Center for<br />Innovating<br />the Future</Mark></a>
        <p class="fnote">{COPY.tagline} Established December {ORG.founded}.</p>
        <div class="fsoc">
          <a href={ORG.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6.1 10.4v8M6.1 6.6v.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              <path d="M10.7 18.4v-5.6a2.9 2.9 0 0 1 5.8 0v5.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href={PODCAST.url} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="2" y="5" width="20" height="14" rx="4" stroke="currentColor" stroke-width="1.8" />
              <path d="M10.2 9.2l5 2.8-5 2.8V9.2z" fill="currentColor" />
            </svg>
          </a>
        </div>
      </div>

      {cols.map((c) => (
        <div class="fcol">
          <h4>{c.h}</h4>
          {c.links.map((l) => <a href={l.u}>{l.l}</a>)}
        </div>
      ))}
    </div>

    <div class="fbot">
      <span>
        <a href="/privacy">Privacy Policy</a> &nbsp;&middot;&nbsp;
        <a href="/terms">Terms of Use</a> &nbsp;&middot;&nbsp;
        &copy; {year} Center for Innovating the Future Inc.
      </span>
      <span>{ORG.city}, Ontario</span>
    </div>
  </div>
</footer>
