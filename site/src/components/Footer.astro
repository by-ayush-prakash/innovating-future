---
import { ORG, IHF, MANTIC, PODCAST, COPY } from "../config";
const year = 2026;
---
<footer class="site">
  <div class="wrap">
    <div class="fcols">
      <div>
        <a class="lock lock--stack" href="/">
          <b>CIF</b>
          <span>Center for Innovating the Future</span>
        </a>
        <p class="fnote">{COPY.tagline}</p>
      </div>
      <div>
        <h4>Work</h4>
        <a href="/work">All work</a>
        <a href={IHF.page}>{IHF.name}</a>
        <a href={MANTIC.page}>{MANTIC.name}</a>
        <a href="/podcast">{PODCAST.name}</a>
      </div>
      <div>
        <h4>About</h4>
        <a href="/credo">Credo</a>
        <a href="/funding">Funding</a>
        <a href="/principles">Principles</a>
        <a href="/leadership">Leadership</a>
        <a href="/careers">Careers</a>
        <a href="/contact">Contact</a>
      </div>
      <div>
        <h4>Writing</h4>
        <a href="/writing">Essays</a>
        <a href="/books">Books</a>
        <a href="/podcast">Podcast</a>
      </div>
    </div>
    <div class="fbot">
      <span>&copy; {year} {ORG.name}, Inc.</span>
      <span>
        <a href="/terms">Terms of Use</a> &nbsp;&middot;&nbsp;
        <a href="/privacy">Privacy Policy</a> &nbsp;&middot;&nbsp;
        <a href={ORG.linkedin}>LinkedIn</a>
      </span>
    </div>
  </div>
</footer>
