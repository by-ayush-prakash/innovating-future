---
import { ORG, SKEPTICISM, MANTIC, PODCAST, COPY } from "../config";
const year = 2026;

const cols = [
  {
    h: "What We Do",
    links: [
      { l: SKEPTICISM.name, u: SKEPTICISM.page },
      { l: MANTIC.name, u: MANTIC.page },
      { l: "All work", u: "/work" },
    ],
  },
  {
    h: "Resources",
    links: [
      { l: PODCAST.name, u: PODCAST.page },
      { l: "CIF In The Press", u: "/media" },
      { l: "Before the Senate, 2017", u: "/senate-2017" },
    ],
  },
  {
    h: "About Us",
    links: [
      { l: "Leadership", u: "/leadership" },
      { l: "Careers", u: "/careers" },
      { l: "Contact", u: "/contact" },
    ],
  },
];
---
<footer class="site">
  <div class="wrap">
    <div class="ftop">
      <a class="lock lock--stack" href="/">
        <span>Center for<br />Innovating<br />the Future</span>
      </a>
      <div class="fsoc">
        <a href={ORG.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="11.25" stroke="currentColor" stroke-opacity=".28" />
            <path d="M8.1 9.9v7.1M8.1 7.4v.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <path d="M11.7 17V12.3a2.4 2.4 0 0 1 4.8 0V17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href={PODCAST.url} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="11.25" stroke="currentColor" stroke-opacity=".28" />
            <path d="M10.3 9.2l5 2.8-5 2.8V9.2z" fill="currentColor" />
          </svg>
        </a>
      </div>
    </div>

    <div class="fmid">
      <div class="freach">
        <h4>Get in touch</h4>
        <a class="fmail" href={"mailto:" + ORG.email}>{ORG.email}</a>
        <p class="fnote">{COPY.tagline}</p>
      </div>

      <div class="fcols">
        {cols.map((c) => (
          <div>
            <h4>{c.h}</h4>
            {c.links.map((l) => <a href={l.u}>{l.l}</a>)}
          </div>
        ))}
      </div>
    </div>

    <div class="fbot">
      <span>
        <a href="/privacy">Privacy Policy</a> &nbsp;&middot;&nbsp;
        <a href="/terms">Terms of Use</a> &nbsp;&middot;&nbsp;
        &copy; {year} Center for Innovating the Future Inc. Established December 2010.
      </span>
      <span>Toronto, Ontario</span>
    </div>
  </div>
</footer>
