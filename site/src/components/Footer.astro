---
import { ORG, IHF, MANTIC, PODCAST, COPY } from "../config";
const year = 2026;
---
<footer class="site">
  <div class="wrap">
    <div class="fcols">
      <div>
        <a class="lock lock--stack" href="/">
          <span>Center for<br />Innovating<br />the Future</span>
        </a>
        <p class="fnote">{COPY.tagline}</p>
        <p class="fest">Established December 2010</p>
      </div>
      <div>
        <h4>Work</h4>
        <a href={IHF.page}>{IHF.name}</a>
        <a href={MANTIC.page}>{MANTIC.name}</a>
      </div>
      <div>
        <h4>About</h4>
        <a href="/leadership">Leadership</a>
        <a href="/careers">Careers</a>
        <a href="/contact">Contact</a>
      </div>
      <div>
        <h4>Media</h4>
        <a href="/writing">Writing</a>
        <a href="/books">Books</a>
        <a href={PODCAST.page}>Podcast</a>
      </div>
    </div>
    <div class="fbot">
      <span>&copy; {year} Center for Innovating the Future Inc. Established December 2010.</span>
      <span>
        <a href="/terms">Terms of Use</a> &nbsp;&middot;&nbsp;
        <a href="/privacy">Privacy Policy</a> &nbsp;&middot;&nbsp;
        <a href={ORG.linkedin}>LinkedIn</a>
      </span>
    </div>
  </div>
</footer>
