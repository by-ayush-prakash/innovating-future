---
import { SKEPTICISM, MANTIC } from "../config";

const { path = "/" } = Astro.props;

// Mirrors the footer. Contact stays a button.
const nav = [
  {
    label: "What We Do",
    items: [
      { label: SKEPTICISM.name, href: SKEPTICISM.page },
      { label: MANTIC.name, href: MANTIC.page },
    ],
  },
  {
    label: "Resources",
    items: [
      { label: "The Ayush Prakash Podcast", href: "/podcast" },
      { label: "CIF In The Press", href: "/media" },
    ],
  },
  {
    label: "About Us",
    items: [
      { label: "Leadership", href: "/leadership" },
      { label: "Careers", href: "/careers" },
      { label: "Contact", href: "/contact" },
    ],
  },
];

const active = (h) => path === h;
const groupActive = (g) => g.items?.some((i) => path === i.href);
---
<nav class="site">
  <div class="wrap navin">
    <a class="lock" href="/" aria-label="Center for Innovating the Future, home">
      <span class="lock__full">Center for<br />Innovating the Future</span>
      <span class="lock__short">CIF</span>
    </a>

    <div class="nlinks">
      {nav.map((n) =>
        n.items ? (
          <div class="ndrop">
            <span class="ntrig" aria-current={groupActive(n) ? "true" : undefined}>
              {n.label}
              <svg width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true"><path d="M1 1l3.5 3.5L8 1" stroke="currentColor" stroke-width="1.2"/></svg>
            </span>
            <div class="npanel">
              {n.items.map((i) => (
                <a href={i.href} aria-current={active(i.href) ? "page" : undefined}>
                  <span>{i.label}</span>
                  <svg width="17" height="12" viewBox="0 0 17 12" fill="none" aria-hidden="true"><path d="M10.6 1L15.6 6L10.6 11M15.2 6H1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={n.href} aria-current={active(n.href) ? "page" : undefined}>{n.label}</a>
        )
      )}
    </div>

    <a class="pill pill--ghost navcta" href="/contact">Contact</a>

    <button id="menubtn" class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobilemenu">
      <span></span><span></span>
    </button>
  </div>

  <div id="mobilemenu" class="mnav" hidden>
    <div class="wrap">
      {nav.map((n) =>
        n.items ? (
          <div class="mgroup">
            <h4>{n.label}</h4>
            {n.items.map((i) => (
              <a href={i.href} aria-current={active(i.href) ? "page" : undefined}>{i.label}</a>
            ))}
          </div>
        ) : (
          <a class="msolo" href={n.href} aria-current={active(n.href) ? "page" : undefined}>{n.label}</a>
        )
      )}
      <a href="/contact" class="mcta">Contact</a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById("menubtn");
  const menu = document.getElementById("mobilemenu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      btn.setAttribute("aria-label", open ? "Open menu" : "Close menu");
      menu.hidden = open;
      document.body.classList.toggle("menu-open", !open);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") btn.click();
    });
  }
</script>
