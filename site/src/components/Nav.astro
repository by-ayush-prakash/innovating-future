---
import { SKEPTICISM, MANTIC, ORG } from "../config";
import Mark from "./Mark.astro";

const { path = "/" } = Astro.props;

// Mirrors the footer. Contact stays a button.
const nav = [
  {
    label: "What We Do",
    items: [
      { label: SKEPTICISM.name, href: SKEPTICISM.page },
      { label: "The First AI-Native Generation", href: "/work/ai-native-generation" },
      { label: MANTIC.name, href: MANTIC.page },
    ],
  },
  {
    label: "Resources",
    items: [
      { label: "The Ayush Prakash Podcast", href: "/podcast" },
      { label: "CIF In The Press", href: "/media" },
      { label: "CIF Before the Senate", href: "/senate-2017" },
    ],
  },
  {
    label: "About Us",
    items: [
      { label: "Team", href: "/team" },
      { label: "Careers", href: "/careers" },
      { label: "Support the work", href: "/support" },
      { label: "Contact", href: "/contact" },
    ],
  },
];

const active = (h: string) => path === h;
const groupActive = (g: any) => g.items?.some((i: any) => path === i.href);
---
<nav class="site">
  <div class="wrap navin">
    <a class="lock" href="/" aria-label={`${ORG.name}, home`}>
      <Mark><span class="lock__full">Center for<br />Innovating the Future</span><span class="lock__short">CIF</span></Mark>
    </a>

    <div class="nlinks">
      {nav.map((n) => (
        <div class="ndrop">
          <span class="ntrig" aria-current={groupActive(n) ? "true" : undefined}>
            {n.label}
            <svg width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true"><path d="M1 1l3.5 3.5L8 1" stroke="currentColor" stroke-width="1.2"/></svg>
          </span>
          <div class="npanel">
            {n.items.map((i) => (
              <a href={i.href} aria-current={active(i.href) ? "page" : undefined}>
                <span>{i.label}</span>
                <svg width="15" height="12" viewBox="0 0 15 12" fill="none" aria-hidden="true"><path d="M1 6h12M9 2l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="navr">
      <a class="btn" href="/contact">Work with the Center</a>
    </div>

    <button id="menubtn" class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobilemenu">
      <span></span><span></span>
    </button>
  </div>

  <div id="mobilemenu" class="mnav">
    <div class="wrap">
      {nav.map((n) => (
        <div class="mgroup">
          <h4>{n.label}</h4>
          {n.items.map((i) => (
            <a href={i.href} aria-current={active(i.href) ? "page" : undefined}>{i.label}</a>
          ))}
        </div>
      ))}
      <a class="btn mcta" href="/contact">Work with the Center</a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById("menubtn");
  const menu = document.getElementById("mobilemenu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      btn.setAttribute("aria-label", open ? "Open menu" : "Close menu");
      if (open) menu.removeAttribute("data-open");
      else menu.setAttribute("data-open", "");
      document.body.classList.toggle("menu-open", !open);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") btn.click();
    });
  }

  // Sticky section bar: highlight the section currently in view.
  const bar = document.querySelector(".sub");
  if (bar) {
    const links = Array.from(bar.querySelectorAll("a[href^='#']")) as HTMLAnchorElement[];
    const targets = links
      .map((a) => document.getElementById(a.getAttribute("href")!.slice(1)))
      .filter(Boolean) as HTMLElement[];
    if (targets.length) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            links.forEach((a) => a.classList.toggle("now", a.getAttribute("href") === `#${e.target.id}`));
          }
        },
        { rootMargin: "-45% 0px -50% 0px" }
      );
      targets.forEach((t) => io.observe(t));
    }
  }
</script>
