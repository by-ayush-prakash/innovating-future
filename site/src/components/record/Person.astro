---
import type { recordViewModel } from "../../data/record-view-model";
interface Props {
  model: typeof recordViewModel;
}
const { model }: Props = Astro.props;
const { displayPersonName, atlasContributors } = model;
---

{atlasContributors.map((person) => (
  <article class="person-follow-view" data-person-view={person.slug} hidden>
    <header
      class={`person-profile-head person-profile-head--${person.sourceCategory}`}
    >
    <button class="person-back" type="button" data-back-to-people>
      <span aria-hidden="true">
        <svg viewBox="0 0 20 20" width="20" height="20" fill="none">
          <path
            d="M17 10H3m6-6-6 6 6 6"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>{" "}
      Back
    </button>
      <span class="person-profile-initials" aria-hidden="true">{person.initials}</span>
      <div>
        <h1>{displayPersonName(person.name)}</h1>
        <p>{person.displayRole}</p>
        <p class="person-profile-coverage">{person.contributions.length} positions · {person.questionCount} {person.questionCount === 1 ? "question" : "questions"}</p>
      </div>
    </header>
    <section class="person-contributions">
      <div>
        {person.contributions.map((item) => (
          <details class="person-position-disclosure">
          <summary
            class={`person-position person-position--${item.questionId}`}
            style={`--question-color:${item.questionColor};--question-soft:${item.questionSoftColor}`}
          >
            <span>
              <b>{item.questionNumber}</b>
              <small>{item.question}</small>
            </span>
            <span>
              <strong>{item.claim}</strong>
            </span>
            <span>
              <time>{item.timestamp}</time>
              <i aria-hidden="true">
                <svg viewBox="0 0 28 20" width="28" height="20" fill="none">
                  <path
                    d="M1 10h25M19 3l7 7-7 7"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                </svg>
              </i>
            </span>
          </summary>
          <div class="follow-position-context">
            {item.story?.paragraph && <p>{item.story.paragraph}</p>}
            <button type="button" class="follow-position-listen" data-compare-source={item.video} data-source-speaker={displayPersonName(person.name)} data-source-time={item.timestamp}>
              Open conversation at {item.timestamp} <span aria-hidden="true">→</span>
            </button>
          </div>
          </details>
        ))}
      </div>
    </section>
  </article>
))}
