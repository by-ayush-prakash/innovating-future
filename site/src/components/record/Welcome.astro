---
import { recordCardVisual } from "../../data/record-card-visuals";
import type { recordViewModel } from "../../data/record-view-model";
interface Props {
  model: typeof recordViewModel;
}
const { model }: Props = Astro.props;
const {} = model;
---

<section class="explore-welcome" aria-label="Choose a question to explore" hidden>
  <div class="welcome-layout">
    <div class="welcome-choices">
      <div class="welcome-card-grid">
        {[
          {
            id: "evidence",
            title: "When should we trust an AI answer?",
            copy: "It sounds convincing. How would you catch what’s wrong?",
            symbol: "?",
          },
          {
            id: "learning",
            title: "Is AI helping you learn?",
            copy: "Finishing the task and understanding it can be different things.",
            symbol: "↗",
          },
          {
            id: "understanding",
            title: "Does AI actually understand us?",
            copy: "What would count as evidence?",
            symbol: "◎",
          },
          {
            id: "judgment",
            title: "What should we keep doing ourselves?",
            copy: "Some work builds the judgment we need later.",
            symbol: "+",
          },
        ].map((card) => (
          <a
            class={`welcome-card welcome-card--${card.id}`}
            style={`--card-rest-color:${recordCardVisual(card.id).rest};--card-selected-color:${recordCardVisual(card.id).selected};--card-icon-color:${recordCardVisual(card.id).ink}`}
            href={`?question=${card.id}&choose=1`}
          >
            <div class="question-concept-art" aria-hidden="true" set:html={recordCardVisual(card.id).svg} />
            <div class="question-card-copy">
              <h2>{card.title}</h2>
              <p class="path-description">{card.copy}</p>
              <span class="welcome-card-action">
                <svg class="path-action-arrow" viewBox="0 0 24 16" fill="none" aria-hidden="true"><path d="M2 8h19m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
