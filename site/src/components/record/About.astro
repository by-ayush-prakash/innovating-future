---
import HowRecordWorks from "./HowRecordWorks.astro";
import ContributionForm from "./ContributionForm.astro";
import type { recordViewModel } from "../../data/record-view-model";
interface Props {
  model: typeof recordViewModel;
}
const { model }: Props = Astro.props;
---

<article class="about-view record-page" data-about-view hidden>
  <div class="about-scroll" tabindex="0" aria-label="About the Record">
  <div class="about-intro" data-about-content>
    <h1>About the Record.</h1>
    <p>The Co-Existence Record is a living, source-linked public record from Co-Existing with AI. It turns long conversations into questions people can explore without losing the original context.</p>
  </div>
  <HowRecordWorks />
  <details class="about-contribution" data-about-contribution>
    <summary class="about-contribute-link"><span>Expand the Record</span><span aria-hidden="true">＋</span></summary>
    <ContributionForm model={model} />
  </details>
  </div>
  <div class="about-art" role="img" aria-label="Illustrated futuristic city"></div>
</article>
