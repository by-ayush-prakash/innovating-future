---
/*
  A generated image field. Soft-blurred organic forms, given texture by the
  grain overlay that .rnw / .card / .im apply in CSS.

  These are placeholders with intent: they hold the composition that
  commissioned photography or 3D renders should eventually occupy, and they
  look deliberate until then. Swap any <Field /> for an <img> and the layout
  does not move.

  Usage:  <Field v="dark-red" id="hero" />
*/
const { v = "sand", id = "f", w = 1200, h = 800 } = Astro.props;

const V: Record<string, [string, [number, number, number, number, string, number][]]> = {
  "dark-red": ["#111111", [
    [.29,.46,.25,.28,"#D83A2E",.82],[.58,.33,.24,.26,"#D83A2E",.62],
    [.84,.72,.23,.24,"#2F6DB5",.70],[.44,.86,.25,.21,"#F2C230",.34],
    [.12,.20,.19,.18,"#D83A2E",.42],
  ]],
  "dark-violet": ["#111111", [
    [.36,.39,.25,.34,"#2F6DB5",.88],[.47,.55,.28,.39,"#2F6DB5",.64],
    [.63,.39,.19,.28,"#D83A2E",.55],[.73,.74,.22,.26,"#F2C230",.48],
    [.25,.82,.20,.24,"#2F6DB5",.42],
  ]],
  "dark-teal": ["#111111", [
    [.29,.47,.26,.47,"#2F6DB5",.82],[.63,.33,.23,.42,"#2F6DB5",.68],
    [.83,.78,.23,.38,"#F2C230",.44],[.46,.84,.25,.33,"#D83A2E",.28],
    [.13,.20,.18,.29,"#2F6DB5",.35],
  ]],
  "dark-amber": ["#111111", [
    [.29,.47,.26,.47,"#F2C230",.76],[.63,.33,.23,.42,"#F2C230",.55],
    [.83,.78,.23,.38,"#2F6DB5",.56],[.46,.84,.25,.33,"#D83A2E",.32],
  ]],
  "dark-slate": ["#111111", [
    [.25,.44,.23,.42,"#2F6DB5",.42],[.62,.29,.23,.34,"#111111",1],
    [.44,.72,.26,.34,"#D83A2E",.28],[.86,.66,.20,.30,"#F2C230",.38],
  ]],
  "sand": ["#F7F2E8", [
    [.32,.37,.24,.29,"#F2C230",.32],[.66,.69,.28,.32,"#D83A2E",.30],
    [.82,.29,.20,.24,"#2F6DB5",.25],[.18,.79,.20,.23,"#F2C230",.34],
  ]],
  "sand-amber": ["#F7F2E8", [
    [.34,.42,.28,.32,"#F2C230",.42],[.72,.69,.29,.32,"#D83A2E",.26],
    [.76,.29,.22,.24,"#2F6DB5",.24],
  ]],
  "stone": ["#F7F2E8", [
    [.33,.32,.30,.28,"#2F6DB5",.24],[.64,.64,.36,.30,"#D83A2E",.40],
    [.71,.28,.26,.21,"#F2C230",.46],[.27,.76,.26,.21,"#2F6DB5",.34],
    [.50,.50,.20,.18,"#F7F2E8",.50],
  ]],
  "gray-teal": ["#F7F2E8", [
    [.33,.51,.27,.35,"#2F6DB5",.28],[.72,.32,.23,.29,"#DCE7F3",1],
    [.55,.85,.20,.24,"#F2C230",.28],
  ]],
  "gray-red": ["#F7F2E8", [
    [.33,.51,.27,.35,"#D83A2E",.26],[.72,.32,.23,.29,"#F3D8D4",1],
  ]],
};

const [base, blobs] = V[v] ?? V["sand"];
const blur = Math.round(Math.max(w, h) * 0.055);
---
<svg class="rn" viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="xMidYMid slice"
     xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <filter id={`fb-${id}`} x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation={blur} />
    </filter>
  </defs>
  <rect width={w} height={h} fill={base} />
  <g filter={`url(#fb-${id})`}>
    {blobs.map(([cx, cy, rx, ry, c, o]) => (
      <ellipse cx={cx * w} cy={cy * h} rx={rx * w} ry={ry * h} fill={c} opacity={o} />
    ))}
  </g>
</svg>
