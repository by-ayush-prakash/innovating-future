---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { ORG } from "../config";

const {
  title,
  description = "The Center for Innovating the Future is a Toronto strategy innovation lab, established in 2010, working to ensure that the forces remaking human life, such as artificial intelligence and geopolitics, are built on purpose rather than inherited.",
  noindex = false,
  appShell = false,
  // Closing CTA, passed straight through to the footer.
  cta = true,
  ctaHeading,
  ctaBody,
  ctaLabel,
  ctaHref,
  ctaField,
  ctaLinks,
} = Astro.props;

const full = `${ORG.short} | ${title ?? "Home"}`;          // browser tab
const social = title ? `${title}, ${ORG.name}` : ORG.name;  // shares and search cards
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={social} />
    <meta property="og:site_name" content={ORG.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={social} />
    <meta name="twitter:description" content={description} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:image" content={new URL("/og-v2.png", Astro.site)} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="CIF. Independent research on the forces reshaping human life." />
    <meta name="twitter:image" content={new URL("/og-v2.png", Astro.site)} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.ico?v=9" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png?v=9" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=9" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {!appShell && <Nav path={path} />}
    <main id="main"><slot /></main>
    {!appShell && <Footer cta={cta} ctaHeading={ctaHeading} ctaBody={ctaBody} ctaLabel={ctaLabel} ctaHref={ctaHref} ctaField={ctaField} ctaLinks={ctaLinks} />}
    {!appShell && (
      <script is:inline>
        (() => {
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const selectors = [
            '.hero h1', '.hero .lede', '.hero .cta', '.hcards > *',
            '.ph-sec h1', '.ph-sec .lede', '.ph-sec .cta', '.ph-split > *',
            '.sec .wrap > *', '.band .wrap > *', '.ctab .wrap > *',
            '.fgrid > *'
          ];
          const items = [...new Set(selectors.flatMap((selector) => [...document.querySelectorAll(selector)]))];

          items.forEach((item) => {
            const media = item.matches('.card, .ncard, .bleed, .afig, .cov, .person, .hcards > *');
            item.setAttribute('data-motion-reveal', media ? 'media' : 'content');
            const siblings = item.parentElement ? [...item.parentElement.children] : [];
            const siblingIndex = Math.max(0, siblings.indexOf(item));
            item.style.setProperty('--motion-delay', `${Math.min(siblingIndex, 4) * 70}ms`);
          });

          document.documentElement.classList.add('motion-ready');
          if (reduced || !('IntersectionObserver' in window)) {
            items.forEach((item) => item.classList.add('is-visible'));
            return;
          }

          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          }, { threshold: .08, rootMargin: '0px 0px -8% 0px' });

          requestAnimationFrame(() => items.forEach((item) => observer.observe(item)));
        })();
      </script>
    )}
  </body>
</html>
